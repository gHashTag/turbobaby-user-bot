<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Woody Weed</title>
    <meta name="description" content="Woody Weed - Бутик премиальных сортов каннабиса">
    <!-- Telegram Mini App Script -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=rel" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { 
            scroll-behavior: smooth;
            height: 100%;
        }
        body { 
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100%;
            overflow-x: hidden;
            background: #0D1B0F;
        }
        #root { min-height: 100vh; }
        
        /* Loading screen */
        #woody-loading {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: #0D1B0F;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }
        #woody-loading .logo {
            font-size: 48px;
            margin-bottom: 20px;
            animation: pulse 1.5s ease-in-out infinite;
        }
        #woody-loading .text {
            color: #39ff14;
            font-size: 18px;
            font-weight: 500;
        }
        #woody-loading .error {
            color: #ff4757;
            font-size: 14px;
            margin-top: 20px;
            padding: 20px;
            text-align: center;
            display: none;
        }
        #woody-loading .retry {
            margin-top: 20px;
            padding: 12px 24px;
            background: #39ff14;
            color: #0D1B0F;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            display: none;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.7; transform: scale(0.95); }
        }
    </style>
    <script>
        // Early error detection
        window.onerror = function(msg, url, line, col, error) {
            var loading = document.getElementById('woody-loading');
            if (loading) {
                loading.querySelector('.logo').textContent = '🚨';
                loading.querySelector('.text').textContent = 'Ошибка загрузки';
                loading.querySelector('.error').style.display = 'block';
                loading.querySelector('.error').textContent = msg + ' (строка ' + line + ')';
                loading.querySelector('.retry').style.display = 'block';
            }
            // Report to backend
            fetch('/api/error-report', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    type: 'early_js_error',
                    message: msg,
                    url: url,
                    line: line,
                    col: col,
                    stack: error ? error.stack : null,
                    userAgent: navigator.userAgent
                })
            }).catch(function(){});
            return true;
        };
    </script>
  <script type="module" crossorigin src="/assets/index-Cu0Xco9n.js"></script>
  <link rel="stylesheet" crossorigin href="/assets/index-CzwoYZC6.css">
</head>
<body>
    <!-- Loading screen (hidden when React loads) -->
    <div id="woody-loading">
        <div class="logo">🪶</div>
        <div class="text">Загрузка...</div>
        <div class="error"></div>
        <button class="retry" onclick="location.reload()">Перезагрузить</button>
    </div>
    
    <div id="root"></div>
</body>
</html>
