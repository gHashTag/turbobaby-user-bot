# ─────────────────────────────────────────────────────────────────────────────
# Woody Weed Bot — environment template.
# Copy to `.env` (local) or set as Railway service variables (prod).
# Values shown are PLACEHOLDERS — fill in your own. Never commit a real .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────
# Telegram bot token from @BotFather.
BOT_TOKEN=123456789:AA...your-bot-token

# Postgres connection string (Railway gives one when you add a Postgres plugin).
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# ── ADMIN ───────────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs that get admin access + deploy/order notifs.
ADMIN_IDS=144022504,8420420131
# Password for the admin web panel (X-Admin-Token login). Pick a strong one.
ADMIN_PASSWORD=change-me-strong-password

# ── URLS / IDENTITY ─────────────────────────────────────────────────────────
# Public URL of the mini-app (Telegram WebApp button target).
WEB_APP_URL=https://your-app.up.railway.app
APP_URL=https://your-app.up.railway.app
# Bot @username (no @), used in referral links.
BOT_USERNAME=YourShopBot
# Optional webhook path (if using webhooks instead of polling). Default: polling.
# WEBHOOK_PATH=

# ── S3 / OBJECT STORAGE (optional — admin image/video uploads) ───────────────
# If unset, uploads fall back to local /data/uploads (EPHEMERAL on Railway —
# vanishes on redeploy). Set these for persistent product photos/videos.
S3_BUCKET=your-bucket
S3_ACCESS_KEY_ID=your-key-id
S3_SECRET_ACCESS_KEY=your-secret
S3_ENDPOINT=https://gateway.storjshare.io
# Optional internal endpoint (Railway private networking); falls back to S3_ENDPOINT.
# S3_INTERNAL_ENDPOINT=
# Public base URL files are served from (CDN/bucket public URL).
S3_PUBLIC_URL=https://your-bucket.up.railway.app
S3_REGION=us-east-1

# ── AI SOMMELIER (optional) ─────────────────────────────────────────────────
# At least one enables the AI sommelier; unset = feature disabled (logged at boot).
GROK_API_KEY=
GLM_API_KEY=

# ── TUNING / MISC (optional, sane defaults) ─────────────────────────────────
PORT=8080
DB_POOL_MAX=10
RUST_LOG=info
NODE_ENV=production
# HIDE_MARKETING_BADGES=0
# BACKUP_ASSETS=0

# ── DEPLOY NOTIFICATIONS (optional, lefthook pre-push heads-up) ──────────────
# If set, `git push` pings this chat that a deploy is starting (the backend also
# notifies admins on successful boot — see notify::notify_deploy).
# DEPLOY_NOTIFY_BOT_TOKEN=
# DEPLOY_NOTIFY_CHAT_ID=

# ── RAILWAY-INJECTED (do NOT set manually — Railway provides these) ─────────
# RAILWAY_GIT_COMMIT_SHA / RAILWAY_GIT_COMMIT_MESSAGE / RAILWAY_GIT_AUTHOR
# RAILWAY_ENVIRONMENT
