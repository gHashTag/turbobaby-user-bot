; --- The label surface: eight keys for nine names ----------------------------------------------
; An ARM is this screen family's own structure, not the server's. src/trios/i18n.rs:472-479
; declares eight status label keys; the three byte-identical copies of status_label_key collapse
; the server's nine accepted names onto seven of them and send everything else to the eighth. The
; arms below are that collapse. They are NOT a second status vocabulary: two of them are named
; for a PAIR because the shipped match arm is a pair, and the eighth exists because the shipped
; match has a fallback, not because the server has a ninth state to describe.
pub const ARM_UNRESOLVED : u8 = 0;
pub const ARM_PENDING : u8 = 1;
pub const ARM_CONFIRMED : u8 = 2;
pub const ARM_PREPARING : u8 = 3;
pub const ARM_READY : u8 = 4;
pub const ARM_OUT_FOR_DELIVERY : u8 = 5;
pub const ARM_DELIVERED_OR_COMPLETED : u8 = 6;
pub const ARM_CANCELLED_OR_REJECTED : u8 = 7;
pub const ARM_COUNT : u8 = 8;
pub const NON_FALLBACK_ARM_COUNT : u8 = 7;
pub const SHARED_ARM_COUNT : u8 = 2;
; Consumed from the order-status contract as a CARDINALITY, not as a list. The nine names
; themselves are that contract's STATUS_NAMES and are deliberately absent from this file.
pub const SERVER_NAME_COUNT_CONSUMED : u8 = 9;

; The eight keys, cited by the NAME of the Rust constant and never by the key literal or by any
; translated text (L3, D13). The order is the order of the arms: index 7 is the fallback.
pub const LABEL_KEY_COUNT : u8 = 8;
pub const LABEL_KEY_NAMES : [8]str = [
  "T_ORDERS_STATUS_PENDING",
  "T_ORDERS_STATUS_CONFIRMED",
  "T_ORDERS_STATUS_PREPARING",
  "T_ORDERS_STATUS_READY",
  "T_ORDERS_STATUS_OUT_FOR_DELIVERY",
  "T_ORDERS_STATUS_DELIVERED",
  "T_ORDERS_STATUS_CANCELLED",
  "T_ORDERS_STATUS_UNKNOWN",
];
pub const LABEL_KEY_TABLE_SITE : str = "src/trios/i18n.rs:472-479";
pub const NO_COMPLETED_LABEL_KEY_EXISTS : bool = true;
pub const NO_REJECTED_LABEL_KEY_EXISTS : bool = true;

pub fn order_presentation_arm_is_known(arm: u8) bool {
  return arm >= ARM_PENDING and arm <= ARM_CANCELLED_OR_REJECTED;
}

pub fn order_presentation_arm_is_shared(arm: u8) bool {
  return arm == ARM_DELIVERED_OR_COMPLETED or arm == ARM_CANCELLED_OR_REJECTED;
}

; Literal indices only. An arm is a position in this file's own enumeration, and computing the
; index from the arm would hide the one fact worth seeing: arm 6 and arm 7 each stand for two
; server names and still return a single key.
pub fn order_presentation_label_key(arm: u8) str {
  if (arm == ARM_PENDING) {
    return LABEL_KEY_NAMES[0];
  }
  if (arm == ARM_CONFIRMED) {
    return LABEL_KEY_NAMES[1];
  }
  if (arm == ARM_PREPARING) {
    return LABEL_KEY_NAMES[2];
  }
  if (arm == ARM_READY) {
    return LABEL_KEY_NAMES[3];
  }
  if (arm == ARM_OUT_FOR_DELIVERY) {
    return LABEL_KEY_NAMES[4];
  }
  if (arm == ARM_DELIVERED_OR_COMPLETED) {
    return LABEL_KEY_NAMES[5];
  }
  if (arm == ARM_CANCELLED_OR_REJECTED) {
    return LABEL_KEY_NAMES[6];
  }
  return LABEL_KEY_NAMES[7];
}

; --- The alias as a customer meets it ----------------------------------------------------------
; turbobaby/order-status owns the question of which of completed and delivered is the alias of
; which, and records that five declarations close one column with four vocabularies. This file
; answers only the customer-visible half, and answers it with a subtraction: nine accepted names
; reach seven non-fallback arms, so exactly two names are lost on the way to the customer. One of
; the two losses is the alias pair. There is no key that would let a customer tell the pair apart
; even if they wanted to, because no T_ORDERS_STATUS_COMPLETED constant exists to be translated.
pub const ALIAS_PAIR_SHARES_ONE_LABEL_KEY : bool = true;
pub const ALIAS_PAIR_SHARES_ONE_FILTER_CHIP : bool = true;
pub const ALIAS_PAIR_SHARES_ONE_STEP_LABEL : bool = true;
pub const ALIAS_PAIR_SHARES_ONE_PROGRESS_SHAPE : bool = true;
pub const ALIAS_PAIR_SHARES_ONE_REORDER_AFFORDANCE : bool = true;
pub const CUSTOMER_VISIBLE_DIFFERENCE_BETWEEN_THE_PAIR : u8 = 0;
; Five hand-written two-literal disjunctions carry the pair, one per surface, and a sixth surface
; carries it by accident. The five are at src/ui/screens/orders_screen.rs:134, :147, :175 and
; :182 and at src/ui/components/status_stepper.rs:65. The accident is the stepper's index lookup:
; the pipeline does not carry completed at all (the order-status contract declares that gap), so
; completed takes the SAME branch as a status nobody recognises and only reaches the right picture
; because the other five disjunctions caught it first. That is the fragile one.
pub const ALIAS_DISJUNCTION_SITE_COUNT : u8 = 5;
pub const ALIAS_DISJUNCTION_SITES : [5]str = [
  "src/ui/screens/orders_screen.rs:134",
  "src/ui/screens/orders_screen.rs:147",
  "src/ui/screens/orders_screen.rs:175",
  "src/ui/screens/orders_screen.rs:182",
  "src/ui/components/status_stepper.rs:65",
];
pub const COMPLETED_SHARES_THE_UNRESOLVED_BRANCH_IN_THE_STEPPER : bool = true;

; --- The four chips, and the mapping nobody had written down -----------------------------------
; src/ui/screens/orders_screen.rs:251 offers four chips. All shows everything. The other three
; partition the rest, but by two unrelated rules written in two places: Active is the NEGATION of
; the terminal predicate (src/ui/screens/orders_screen.rs:174), while Completed and Cancelled are
; literal disjunctions (:175, :176). The partition holds today. It holds by coincidence of two
; independent edits, not by construction, and nothing in the tree checks it -- which is why it is
; written down here.
pub const CHIP_ALL : u8 = 1;
pub const CHIP_ACTIVE : u8 = 2;
pub const CHIP_COMPLETED : u8 = 3;
pub const CHIP_CANCELLED : u8 = 4;
pub const CHIP_COUNT : u8 = 4;
pub const PARTITIONING_CHIP_COUNT : u8 = 3;
pub const CHIP_SITE : str = "src/ui/screens/orders_screen.rs:171-178";
pub const CHIP_RULES_ARE_WRITTEN_TWICE_AND_INDEPENDENTLY : bool = true;

; spelled_as_the_vocabulary is the fact the nine raw comparison sites depend on and the six
; lower-casing sites do not: it is true when the status string arriving from the server is
; character-for-character the lower-case name the raw comparisons expect. It is a separate
; argument rather than a string operation because this file holds no status strings at all.
pub fn order_presentation_chip_of(arm: u8, spelled_as_the_vocabulary: bool) u8 {
  if (!spelled_as_the_vocabulary) {
    return CHIP_ACTIVE;
  }
  if (arm == ARM_CANCELLED_OR_REJECTED) {
    return CHIP_CANCELLED;
  }
  if (arm == ARM_DELIVERED_OR_COMPLETED) {
    return CHIP_COMPLETED;
  }
  return CHIP_ACTIVE;
}

pub fn order_presentation_is_shown_under(chip: u8, arm: u8, spelled_as_the_vocabulary: bool) bool {
  if (chip == CHIP_ALL) {
    return true;
  }
  return chip == order_presentation_chip_of(arm, spelled_as_the_vocabulary);
}

; An unresolved status is not filtered out and it is not given a chip of its own: it lands in
; Active, because Active is defined as everything the terminal predicate refuses. A customer who
; taps Active is therefore shown every order this software failed to understand, alongside the
; ones genuinely in flight, with no mark distinguishing the two.
pub const UNRESOLVED_STATUS_IS_FILTERED_AS_ACTIVE : bool = true;

; --- One string, fifteen readers, two readings of case -----------------------------------------
; Six sites lower-case the status before deciding and nine compare it raw. Every site in the first
; group decides what the customer READS; every site in the second decides what the customer can
; FIND, DO, or SEE PROGRESS ON. So a status spelled in any other case keeps its correct label and
; loses its chip, its cancel button, its reorder button and its place in the pipeline at once.
; No source in this tree normalises the status before it reaches these screens: the detail screen
; assigns the polled value straight over the loaded one at
; src/ui/screens/order_detail_screen.rs:227 with no vocabulary check of any kind.
pub const STATUS_READER_COUNT : u8 = 15;
pub const CASE_NORMALIZING_READER_COUNT : u8 = 6;
pub const RAW_READER_COUNT : u8 = 9;
pub const READERS_AGREE_ON_CASE : bool = false;
pub const CASE_NORMALIZING_SITES : [6]str = [
  "src/ui/screens/orders_screen.rs:128",
  "src/ui/screens/orders_screen.rs:141",
  "src/ui/screens/order_detail_screen.rs:175",
  "src/ui/screens/order_detail_screen.rs:188",
  "src/ui/components/status_stepper.rs:33",
  "src/ui/components/status_stepper.rs:46",
];
pub const RAW_READER_SITES : [9]str = [
  "src/ui/screens/orders_screen.rs:175",
  "src/ui/screens/orders_screen.rs:176",
  "src/ui/screens/orders_screen.rs:182",
  "src/ui/screens/orders_screen.rs:306",
  "src/ui/screens/order_detail_screen.rs:171",
  "src/ui/screens/order_detail_screen.rs:241",
  "src/ui/components/status_stepper.rs:28",
  "src/ui/components/status_stepper.rs:59",
  "src/ui/components/status_stepper.rs:96",
