pub const STATUS_IS_NORMALISED_BEFORE_IT_REACHES_THE_SCREENS : bool = false;
pub const POLLED_STATUS_OVERRIDES_THE_LOADED_ONE_AT : str = "src/ui/screens/order_detail_screen.rs:227";

