// SPDX-License-Identifier: Apache-2.0
; specs/turbobaby/notification_queue.t27 -- the outbound transport, and what it forgets
; This contract owns the queue itself and nothing that travels through it: admission at the
; insert, the derived states of a row and which of them are terminal, the drain interval and its
; batch, the retry rule and the absence of a backoff, the ordering the scan does and does not
; guarantee, the claim it does not take, and the rule that is supposed to stop one customer being
; written to twice for one event. It owns no message, no recipient, no kind vocabulary that a
; producer does not already own, and no schedule this repository does not implement.
; --
; WHY (measured 2026-09-21, the asymmetry). This queue is bounded where it ought to persist and
; unbounded where it ought to stop, and both halves are the same eleven lines. A send that FAILS
; is retried on the very next tick: POLL_INTERVAL_SECS is 30 (src/notification_queue.rs:18),
; MAX_ATTEMPTS is 3 (:20), and scheduled_at is written once at insert (src/db/notifications.rs:77)
; and updated at 0 sites anywhere -- so the three sends fall at t, t+30 and t+60 and the retry
; horizon of this queue is 60 seconds. A Telegram outage longer than that burns all three, and the
; third failure does not record a loss: src/notification_queue.rs:112-114 writes processed_at, the
; same column with the same shape of value that a delivery writes at :94. A send that SUCCEEDS and
; whose mark then fails (:94-99) advances nothing at all -- the Ok arm never touches attempts -- so
; the row stays pending with attempts unchanged and is sent again in 30 seconds, and again, without
; bound, while attempts stays 0 and the giveup rule it would have to reach is never reached. The
; queue gives up on a message nobody received after 60 seconds and re-sends a message that was
; received forever.
; --
; WHY (measured 2026-09-21, the scope). The name says queue and the shape says transport, but a
; grep for .send_message( over src/ on 2026-09-21 returns 53 occurrences across 12 files, and
; exactly 1 of them is in src/notification_queue.rs. The other 52 -- order status
; (src/bot/notify.rs), cart nudges (src/cart_abandonment.rs), event reminders (src/api/events.rs),
; both broadcast paths (src/promo.rs, src/api/admin.rs) and every bot handler -- reach the customer
; with no row, no attempt count and no record that they were sent. Retry, ordering and
; at-least-once are properties of three referral kinds, not of this bot's outbound mail.
; --
; WHERE THE BRIEF IS REFUTED. The brief asks for "the queue row's states and which are terminal"
; and for "the dedupe key". Neither exists as the question presumes.
; migrations/067_notification_queue.sql:4-13 declares 8 columns and not one of them is a status or
; a state: the state of a row is derived from processed_at being null or not, and the three
; outcomes that end a row -- delivered (:94), abandoned after three attempts (:114) and skipped
; because the chat id is 0 (:62-66) -- write the same column, so the row afterwards cannot say
; which happened. And the word UNIQUE occurs 0 times in that migration; the only uniqueness on the
; table is the PRIMARY KEY, whose declared default is gen_random_uuid (:5) and whose value in
; practice is a client-side uuid v4 written at src/db/notifications.rs:73 -- the schema default is
; never exercised, and neither number is one a producer can collide with. There is no dedupe key. What stops a second message is three separate guards in three
; separate producers, and the transport contributes nothing to any of them. Two smaller
; corrections, both inside the repository: src/db/notifications.rs:30-31 tells the reader that the
; surviving friend_watered arm lives in a function called render_referral_text, and
; render_referral_text occurs 1 time in all of src/ -- that comment; the function is build_message
; at src/notification_queue.rs:125. And src/trios/deeplink.rs:651-652 says the button is built for
; friend_joined, friend_ordered and milestone; the markup at src/notification_queue.rs:83-86 is
; built outside the match and attached to all five rendering paths, the legacy arm and the
; unknown-kind fallback included.
; --
; WHAT THIS FILE NEVER DOES. It quotes no message and no fragment of one, in any language; the
; shipped copy is a set of fields at src/locales.rs:88-89 and :94-102 -- the four cart strings
; between them at :90-93 belong to another path -- and is cited by path. It names no
; customer, no chat id and no telegram identifier. It declares no locale, no fallback locale and no
; locale set -- turbobaby/locale-policy owns those, and the drain's own hard-coded fallback is
; recorded here as a second copy rather than restated as a value. It declares no message subject:
; turbobaby/promo-broadcast owns what may be said to a population and turbobaby/referral-program
; owns the milestone that becomes a row. It declares no metric name, no dashboard and no alert rule
; -- turbobaby/observability owns the naming rule, and what is recorded here is which of this
; path's events have a counter at all. It declares no delivery channel: turbobaby/bot-surface owns
; that, and turbobaby/deeplink owns the payload the one button carries. Where the repository
; publishes no bound -- a backoff, a per-recipient ceiling, a queue depth, a dead-letter store, a
; receipt -- a named refusal and a note saying what is missing stand in place of a plausible
; number.
; phi^2 + 1/phi^2 = 3 | TRINITY

module turbobaby-notification-queue;

pub const KIND : str = "transport-contract";
pub const ID : str = "turbobaby/notification-queue";
pub const NAME : str = "TurboBaby outbound notification queue";
pub const WORLD : str = "gHashTag/turbobaby-user-bot";
pub const DRAIN_IMPLEMENTATION : str = "src/notification_queue.rs";
pub const STORE_IMPLEMENTATION : str = "src/db/notifications.rs";
pub const ROW_IMPLEMENTATION : str = "src/db/entities/notification_queue.rs";
pub const SCHEMA_MIGRATION : str = "migrations/067_notification_queue.sql";
pub const WIRING_SITE : str = "src/main.rs:664-674";
pub const TICK_WITNESS : str = "tests/timed_loops_announce_ticks.rs";
pub const BUTTON_WITNESS : str = "src/trios/deeplink.rs:648-658";
pub const MEASURED_AT : str = "2026-09-21";

; --- Reuse edges ------------------------------------------------------------------------------
; Each names an owner whose decision enters here as an abstract parameter. Not one of their
; enumerations, thresholds or strings is restated below, with a single marked exception named at
; its own edge: the poll interval, which this file and turbobaby/runtime-config read from one line.
; --
; What may be SENT to a population is turbobaby/promo-broadcast's subject; this file owns only the
; carriage. The two do not overlap in code either: neither broadcast path writes a row on this
; table and neither is drained by this worker.
pub const REUSES_PROMO_BROADCAST_ID : str = "turbobaby/promo-broadcast";
; A milestone mail is a row on this table (src/db/referrals.rs:874-885). Which rung exists, when it
; is reached and whether it was already awarded is turbobaby/referral-program's; this file consumes
; only the boolean that its producer guard fired.
pub const REUSES_REFERRAL_PROGRAM_ID : str = "turbobaby/referral-program";
; The drain reads a per-recipient language (src/notification_queue.rs:69-73) before rendering. The
; published set, the primary and the fallback are turbobaby/locale-policy's. What is recorded here
; is that the drain resolves its own fallback from a literal instead of asking.
pub const REUSES_LOCALE_POLICY_ID : str = "turbobaby/locale-policy";
; The channel is the bot, and every row leaves through one send site. turbobaby/bot-surface owns
; that surface, its escaping rule and its button vocabulary.
pub const REUSES_BOT_SURFACE_ID : str = "turbobaby/bot-surface";
; A drain failure should be a metric rather than a silence. Whether a metric name may exist at all,
; and the rule binding a name to an emitting site, is turbobaby/observability's; this file records
; only which events on this path have a counter and which have none.
pub const REUSES_OBSERVABILITY_ID : str = "turbobaby/observability";
; ADDED after reading the witness: the one button every message carries is a start payload, and
; src/trios/deeplink.rs:648-658 is a live test that exists because of this queue. The payload
; vocabulary is turbobaby/deeplink's; the fact that one target serves every path is this file's.
pub const REUSES_DEEPLINK_ID : str = "turbobaby/deeplink";
; The drain's interval is one of eight loop intervals turbobaby/runtime-config inventories, and
; that contract owns whether any of them may be configured. POLL_INTERVAL_SECONDS below is
; therefore a MARKED second copy and not an independent reading: both contracts take it from the
; same source line, pinned here as INTERVAL_SOURCE_LINE, and that line is the arbiter if the two
; copies ever disagree.
pub const REUSES_RUNTIME_CONFIG_ID : str = "turbobaby/runtime-config";
; The fourth rendering arm outlives its writer because a mechanic was withdrawn and its rows were
; not. What retirement means in this repository -- hidden data against a surface still reachable --
; is turbobaby/legacy-retirement's, and so is whether that arm should go. This file takes only the
; count it can measure: one kind with a reader and no writer.
pub const REUSES_LEGACY_RETIREMENT_ID : str = "turbobaby/legacy-retirement";
pub const REUSE_EDGE_COUNT : u8 = 8;

; --- The row: 8 columns and no state -----------------------------------------------------------
; migrations/067_notification_queue.sql:4-13, mirrored at
; src/db/entities/notification_queue.rs:20-31. The state of a row is not stored, it is computed
; from one of the eight columns, and that column is doing three jobs at once.
pub const ROW_COLUMN_COUNT : u8 = 8;
pub const ROW_HAS_A_STATE_COLUMN : bool = false;
pub const STATE_IS_DERIVED : bool = true;
pub const STATE_PENDING : u8 = 1;
pub const STATE_TERMINAL : u8 = 2;
pub const STATE_COUNT : u8 = 2;

pub fn row_state(processed: bool) u8 {
  if (processed) {
    return STATE_TERMINAL;
  }
  return STATE_PENDING;
}

pub fn state_is_terminal(state: u8) bool {
  return state == STATE_TERMINAL;
}

pub fn row_may_be_drained_again(processed: bool) bool {
  return !state_is_terminal(row_state(processed));
}

; Three outcomes end a row and all three write processed_at: delivery at
; src/notification_queue.rs:94, abandonment at :114, and the chat-id-zero skip at :62-66. Only the
; first increments a counter (:101), so the three are separable in aggregate and not on the row --
; which is the only place an operator looks when the question is about one customer.
pub const OUTCOME_DELIVERED : u8 = 1;
pub const OUTCOME_ABANDONED : u8 = 2;
pub const OUTCOME_SKIPPED_NO_CHAT : u8 = 3;
pub const TERMINAL_OUTCOME_COUNT : u8 = 3;
pub const TERMINAL_OUTCOMES_SHARE_ONE_COLUMN : bool = true;
pub const THE_ROW_RECORDS_WHICH_OUTCOME : bool = false;
pub const A_GIVEUP_IS_WRITTEN_AS_A_DELIVERY : bool = true;

pub fn outcome_is_terminal(outcome: u8) bool {
  return outcome >= OUTCOME_DELIVERED and outcome <= OUTCOME_SKIPPED_NO_CHAT;
}

pub fn outcome_increments_a_counter(outcome: u8) bool {
  return outcome == OUTCOME_DELIVERED;
}

pub fn outcome_is_legible_afterwards(outcome: u8, reading_the_row: bool) bool {
  if (reading_the_row) {
    return THE_ROW_RECORDS_WHICH_OUTCOME;
  }
  return outcome_increments_a_counter(outcome);
}

; --- Admission ---------------------------------------------------------------------------------
; The insert asks nothing about the kind: VARCHAR(50) at
; migrations/067_notification_queue.sql:7 with 0 CHECK constraints, and
; src/db/notifications.rs:65-88 validates neither the string nor the payload shape. Admission to
; the QUEUE and admission to a RENDERING are different gates, and only the second has a vocabulary.
pub const KIND_COLUMN_MAX_CHARS : u16 = 50;
pub const KIND_CHECK_CONSTRAINT_COUNT : u8 = 0;
pub const PAYLOAD_SCHEMA_IS_VALIDATED : bool = false;

pub fn insert_is_admitted(kind_within_cap: bool, payload_is_json: bool) bool {
  return kind_within_cap and payload_is_json;
}

; src/notification_queue.rs:136-177. Four arms plus a catch-all; three writers, at
; src/db/referrals.rs:300, src/db/orders.rs:437 and src/db/referrals.rs:877. The fourth arm is kept
; deliberately for rows written before the mechanic behind it was withdrawn, and the reason stands
; at src/db/notifications.rs:27-35: the writer is code and the rows are data, and the two do not
; have the same lifetime. That retirement is not this file's decision to make or to reverse.
pub const RENDERABLE_KIND_COUNT : u8 = 4;
pub const RENDERABLE_KINDS : [4]str = ["friend_joined", "friend_watered", "friend_ordered", "milestone"];
pub const WRITTEN_KIND_COUNT : u8 = 3;
pub const WRITTEN_KINDS : [3]str = ["friend_joined", "friend_ordered", "milestone"];
pub const KINDS_WITH_A_READER_AND_NO_WRITER : u8 = 1;
pub const RENDERING_PATH_COUNT : u8 = 5;
pub const UNKNOWN_KIND_IS_REFUSED : bool = false;
pub const UNKNOWN_KIND_STILL_SENDS : bool = true;
pub const UNKNOWN_KIND_EMITS_THE_RAW_COLUMN : bool = true;

pub fn message_is_kind_specific(kind_has_an_arm: bool) bool {
  return kind_has_an_arm;
}

pub fn row_reaches_a_customer(kind_has_an_arm: bool, chat_id_present: bool) bool {
  return chat_id_present and (kind_has_an_arm or UNKNOWN_KIND_STILL_SENDS);
}

pub fn unwritten_readable_kinds(readable: u8, written: u8) u8 {
  return readable - written;
}

; --- The drain ---------------------------------------------------------------------------------
; src/notification_queue.rs:28-45. One interval, cold-start tick discarded at :32, then
; process_batch run synchronously inside the tick. The empty tick is silent BY DECISION and the
; decision is annotated in place at :36-39; tests/timed_loops_announce_ticks.rs:18-31 is the gate
; that forces every timed loop either to log the empty case or to say in the file why not, and this
; loop says why not -- 2880 lines a day, and Ok(0) here counts deliveries rather than work found.
pub const INTERVAL_SOURCE_LINE : str = "src/notification_queue.rs:18";
pub const POLL_INTERVAL_SECONDS : u16 = 30;
pub const FIRST_TICK_IS_DISCARDED : bool = true;
pub const BATCH_SIZE : u16 = 50;
pub const EMPTY_TICK_IS_SILENT : bool = true;
pub const EMPTY_TICK_SILENCE_IS_ANNOTATED : bool = true;
pub const DRAINER_SPAWN_SITES : u8 = 1;
pub const PACING_SLEEPS_IN_THE_DRAIN : u8 = 0;
pub const SENDS_WITHIN_A_BATCH_ARE_SEQUENTIAL : bool = true;

pub fn rows_this_tick(pending: u16) u16 {
  if (pending > BATCH_SIZE) {
    return BATCH_SIZE;
  }
  return pending;
}

pub fn tick_is_capped(pending: u16) bool {
  return pending > BATCH_SIZE;
}

pub fn backlog_after_tick(pending: u16) u16 {
  return pending - rows_this_tick(pending);
}

; The scan applies exactly two filters (src/db/notifications.rs:98-99) and one order (:100).
; scheduled_at is read as a sort key and never as a due time, so the column named like a schedule
; does not schedule: a row dated into the future is admitted by the very next scan. The one thing
; the date still does is sort it -- being the newest scheduled_at it goes to the BACK of the
; result -- so it leaves as soon as it fits inside a batch, later than the rows queued before it
; and not later than the time written on it. Nothing writes a future value today (:77 writes
; now()), which is why the gap is invisible rather than harmless -- the first caller who wants a
; delay will believe this column already gives one.
pub const DRAIN_FILTER_COUNT : u8 = 2;
pub const SCHEDULED_AT_COLUMN_EXISTS : bool = true;
pub const SCHEDULED_AT_IS_A_DUE_TIME_FILTER : bool = false;
pub const SCHEDULED_AT_UPDATE_SITES : u8 = 0;
pub const FUTURE_SCHEDULED_AT_WRITE_SITES : u8 = 0;
pub const A_FUTURE_ROW_IS_SENT_ON_THE_NEXT_TICK : bool = true;

pub fn drain_waits_for_the_scheduled_time(due_filter_exists: bool, scheduled_in_the_future: bool) bool {
  return due_filter_exists and scheduled_in_the_future;
}

pub fn drain_admits_row(processed: bool, attempts: u8, ceiling: u8, scheduled_in_the_future: bool) bool {
  if (drain_waits_for_the_scheduled_time(SCHEDULED_AT_IS_A_DUE_TIME_FILTER, scheduled_in_the_future)) {
    return false;
  }
  return !processed and attempts < ceiling;
}

; --- Retry, and the backoff that does not exist -------------------------------------------------
; src/notification_queue.rs:112-117. The giveup fires at attempts + 1 >= MAX_ATTEMPTS, so the
; increment at src/db/notifications.rs:138 runs only from 0 and from 1. The highest value the column
; can ever hold is 2, and the scan's own ceiling of 3 (src/db/notifications.rs:99) therefore
; excludes nothing this code can write. The partial index carries attempts as a key column at
; migrations/067_notification_queue.sql:16 to serve that same filter.
pub const MAX_ATTEMPTS : u8 = 3;
pub const ATTEMPTS_AT_INSERT : u8 = 0;
pub const HIGHEST_ATTEMPTS_VALUE_THE_CODE_CAN_WRITE : u8 = 2;
pub const ATTEMPTS_FILTER_CEILING : u8 = 3;
pub const SEND_ATTEMPTS_PER_ROW : u8 = 3;
pub const THE_ATTEMPTS_FILTER_CAN_EXCLUDE_A_ROW : bool = false;
; That unreachability is a statement about ONE drainer and not about the arithmetic. The increment
; is a read-modify-write with no claim on the row (see the ordering section), so two drainers that
; both read attempts = 1 would both run src/db/notifications.rs:138 and leave 3 in the column --
; exactly the value the filter was written for. Exactly one drainer is spawned (src/main.rs:669),
; and that spawn count, not the branch at src/notification_queue.rs:112, is what keeps 3 out.
pub const ATTEMPTS_CEILING_IS_UNREACHABLE_ONLY_WITH_ONE_DRAINER : bool = true;

pub fn attempts_after_failure(attempts: u8) u8 {
  if (attempts + 1 >= MAX_ATTEMPTS) {
    return attempts;
  }
  return attempts + 1;
}

pub fn failure_abandons_the_row(attempts: u8) bool {
  return attempts + 1 >= MAX_ATTEMPTS;
}

pub fn failure_is_retried(attempts: u8) bool {
  return !failure_abandons_the_row(attempts);
}

pub fn attempts_filter_excludes(attempts: u8) bool {
  return attempts >= ATTEMPTS_FILTER_CEILING;
}

pub fn attempts_value_is_writable(attempts: u8) bool {
  return attempts <= HIGHEST_ATTEMPTS_VALUE_THE_CODE_CAN_WRITE;
}

pub fn the_attempts_filter_is_reachable(attempts: u8) bool {
  return attempts_filter_excludes(attempts) and attempts_value_is_writable(attempts);
}

pub fn attempts_ceiling_is_unreachable(single_drainer: bool) bool {
  return single_drainer;
}

; No delay grows between attempts and no attempt is rescheduled, so the gap between two attempts on
; one row is the poll interval itself and the whole budget is spent in (attempts - 1) intervals.
; The boundary case -- an outage ending exactly as the last tick fires -- is counted as lost here,
; because the first attempt is not aligned to the start of the outage and this contract will not
; claim an alignment the code does not have.
pub const BACKOFF_EXISTS : bool = false;
pub const JITTER_EXISTS : bool = false;
pub const RETRY_INTERVAL_SECONDS : u16 = 30;
pub const RETRY_HORIZON_SECONDS : u16 = 60;

pub fn retry_horizon_seconds(poll_seconds: u16, send_attempts: u16) u16 {
  return poll_seconds * (send_attempts - 1);
}

pub fn message_survives_outage(outage_seconds: u16) bool {
  return outage_seconds < RETRY_HORIZON_SECONDS;
}

; A refusal by Telegram and a broken socket are one event to this loop
; (src/notification_queue.rs:105-118): one Err arm, one counter of attempts, one giveup. A customer
; who has blocked the bot is retried twice like a timeout, and a timeout is discarded after 60
; seconds like a block.
pub const SEND_FAILURE_CLASS_COUNT : u8 = 1;
pub const PERMANENT_AND_TRANSIENT_ARE_TOLD_APART : bool = false;

pub fn failure_handling_depends_on_the_cause(cause_is_permanent: bool, classes: u8) bool {
  return classes >= 2 and cause_is_permanent;
}

; --- Being messaged twice ------------------------------------------------------------------------
; The transport has no dedupe key and cannot acquire one by reading the table: the only unique
; constraint on it is the PRIMARY KEY, declared with a gen_random_uuid default at
; migrations/067_notification_queue.sql:5 and filled in practice by a client-side uuid v4 at
; src/db/notifications.rs:73, and UNIQUE occurs 0 times in that migration. Each of the
; three producers carries its own guard instead -- a fresh-invite test at src/db/referrals.rs:295,
; a first-order test at src/db/orders.rs:397, and an ON CONFLICT (referrer_id, milestone) DO NOTHING
; whose rows_affected decides the send at src/db/referrals.rs:805-817. Three guards, three shapes,
; nothing shared. A fourth producer inherits none of them.
pub const QUEUE_UNIQUE_CONSTRAINT_COUNT : u8 = 1;
pub const THE_UNIQUE_CONSTRAINT_IS_A_RANDOM_UUID : bool = true;
pub const QUEUE_HAS_A_DEDUPE_KEY : bool = false;
pub const TRANSPORT_GUARD_PRESENT : bool = false;
pub const PRODUCER_COUNT : u8 = 3;
pub const PRODUCERS_WITH_THEIR_OWN_GUARD : u8 = 3;
pub const GUARD_SHAPE_COUNT : u8 = 3;
pub const GUARD_FRIEND_JOINED : str = "src/db/referrals.rs:295";
pub const GUARD_FRIEND_ORDERED : str = "src/db/orders.rs:397";
pub const GUARD_MILESTONE : str = "src/db/referrals.rs:805-817";

pub fn duplicate_enqueue_is_stopped(producer_guard_present: bool) bool {
  return producer_guard_present or TRANSPORT_GUARD_PRESENT;
}

pub fn a_new_producer_inherits_a_guard(producer_guard_present: bool) bool {
  return duplicate_enqueue_is_stopped(producer_guard_present);
}

; The second way one customer is written to twice needs no duplicate row at all. On the success
; path (src/notification_queue.rs:93-104) the mark is a second database write, and when it fails the
; row is left pending with attempts untouched -- the Ok arm contains no call to the increment. The
; next tick re-reads it, re-sends it and tries the same failing write again. The only barrier
; against a repeat send is the write that just failed, and nothing counts the repeats: the delivery
; counter at :101 sits inside the else branch that did not run. The warn at :95 names the failed
; MARK and not the send before it, so the log holds one line per repeat and not one line saying a
; customer was written to twice.
pub const THE_SEND_IS_IDEMPOTENT : bool = false;
pub const THE_ONLY_BARRIER_IS_THE_WRITE_THAT_FAILED : bool = true;
pub const A_FAILED_MARK_ADVANCES_ATTEMPTS : bool = false;
pub const A_RESEND_AFTER_A_FAILED_MARK_IS_LOGGED : bool = true;
pub const A_RESEND_AFTER_A_FAILED_MARK_IS_COUNTED : bool = false;
pub const RESENDS_AFTER_A_FAILED_MARK_ARE_BOUNDED : bool = false;

pub fn attempts_after_successful_send(attempts: u8) u8 {
  return attempts;
}

pub fn row_stays_pending_after_send(send_ok: bool, mark_ok: bool) bool {
  return send_ok and !mark_ok;
}

pub fn customer_is_messaged_twice(send_ok: bool, mark_ok: bool, another_tick_runs: bool) bool {
  return row_stays_pending_after_send(send_ok, mark_ok) and another_tick_runs;
}

pub fn resend_count_is_bounded(mark_ever_succeeds: bool) bool {
  return mark_ever_succeeds;
}

; --- Ordering -------------------------------------------------------------------------------------
; One sort key, no tiebreaker (src/db/notifications.rs:100), and the loop at
; src/notification_queue.rs:57 walks the result in order with nothing between sends. A failed row
; keeps its scheduled_at, so it keeps the head of the queue for its remaining attempts rather than
; falling behind. None of that is a global guarantee: there is no claim on a row -- 0 occurrences of
; FOR UPDATE or SKIP LOCKED in src/db/notifications.rs -- so the ordering holds only while exactly
; one drainer exists, and exactly one is spawned (src/main.rs:669). Per-recipient order is a
; shadow of the global one rather than a rule of its own: two rows for one customer go out in
; scheduled_at order only while no send fails -- a failed first row waits a tick while the second
; is already gone -- and only while their two timestamps differ, since there is no tiebreaker.
pub const ORDER_KEY : str = "scheduled_at";
pub const ORDER_KEY_COUNT : u8 = 1;
pub const TIEBREAKER_COUNT : u8 = 0;
pub const ORDER_IS_OLDEST_FIRST : bool = true;
pub const A_FAILED_ROW_KEEPS_ITS_PLACE : bool = true;
pub const ROW_CLAIM_EXISTS : bool = false;
pub const SKIP_LOCKED_SITES_IN_THE_STORE : u8 = 0;
pub const PER_RECIPIENT_ORDERING_EXISTS : bool = false;

pub fn order_is_total(tiebreakers: u8) bool {
  return tiebreakers >= 1;
}

pub fn fifo_holds(single_drainer: bool, order_key_present: bool) bool {
  return single_drainer and order_key_present;
}

pub fn two_drainers_see_the_same_rows(claim_exists: bool, drainer_count: u8) bool {
  return !claim_exists and drainer_count >= 2;
}

pub fn ordering_survives_a_second_process(claim_exists: bool, drainer_count: u8) bool {
  return !two_drainers_see_the_same_rows(claim_exists, drainer_count);
}

; --- The recipient the drain declines to send to ----------------------------------------------------
; src/notification_queue.rs:62-67. A row whose chat id is 0 is marked processed and skipped, with no
; log line and no counter, so it leaves the queue looking exactly like a delivery.
pub const ZERO_CHAT_ID_IS_SKIPPED : bool = true;
pub const ZERO_CHAT_ID_SKIP_IS_LOGGED : bool = false;
pub const ZERO_CHAT_ID_SKIP_INCREMENTS_A_COUNTER : bool = false;

pub fn send_is_attempted(chat_id_present: bool, admitted: bool) bool {
  return chat_id_present and admitted;
}

; --- Localization boundary --------------------------------------------------------------------------
; src/notification_queue.rs:69-73 reads the language per row and falls back to a literal written in
; the drain. The read cannot distinguish a missing user from a failed query --
; src/db/mod.rs:868-885 returns the same None for both and says so at :866-867 -- so a database
; hiccup degrades to the fallback rather than deferring the row. The failure is not unobserved,
; since the query error reaches a warn at src/db/mod.rs:877; it is unreadable HERE, because the
; None handed to the drain carries no reason and no branch on this path can act on the difference. Whether that literal
; agrees with the published fallback is turbobaby/locale-policy's to state; what is recorded here is
; that the transport keeps its own copy instead of asking.
pub const LOCALE_IS_READ_PER_ROW : bool = true;
pub const LOCALE_SOURCE_COLUMN : str = "users.language";
pub const LOCALE_READ_FAILURE_IS_DISTINGUISHABLE : bool = false;
pub const DRAIN_HOLDS_ITS_OWN_FALLBACK_LITERAL : bool = true;
pub const A_LOCALE_READ_FAILURE_DEFERS_THE_ROW : bool = false;

pub fn locale_is_resolved(user_row_found: bool) bool {
  return user_row_found;
}

pub fn drain_sends_in_the_fallback(user_row_found: bool, read_failed: bool) bool {
  return !user_row_found or read_failed;
}

; --- The one button ----------------------------------------------------------------------------------
; src/notification_queue.rs:83-86 builds the markup outside the match on kind, so every rendering
; path carries the same single button at the same single target. That is not an accident and the
; reasoning stands at :76-82; it is also why the live test at src/trios/deeplink.rs:648-658 exists.
pub const BUTTON_COUNT_PER_MESSAGE : u8 = 1;
pub const BUTTON_TARGET_COUNT : u8 = 1;
pub const BUTTON_IS_BUILT_OUTSIDE_THE_KIND_MATCH : bool = true;
pub const BUTTON_TARGET_HAS_A_LIVE_TEST : bool = true;

pub fn button_can_differ_by_path(rendering_paths: u8, button_targets: u8) bool {
  return button_targets >= rendering_paths;
}

; --- Observability ------------------------------------------------------------------------------------
; Two counters exist on this path: one at the insert (src/db/notifications.rs:86, defined at
; src/metrics.rs:149-155) and one after a confirmed delivery (src/notification_queue.rs:101, defined
; at src/metrics.rs:158-164). A send failure, an abandonment, a zero-chat skip, a failed batch and
; the depth of the queue have none. The batch failure is a warn at src/notification_queue.rs:41 and
; nothing else. Both counter names were searched for in all four monitoring artifacts this
; repository ships -- docs/grafana-dashboard.json, docs/prometheus-alerts.yaml,
; docs/prometheus-recording-rules.yaml and monitoring/grafana-dashboard.json -- and each returns 0.
pub const COUNTERS_ON_THIS_PATH : u8 = 2;
pub const COUNTER_ON_ENQUEUE : bool = true;
pub const COUNTER_ON_DELIVERY : bool = true;
pub const COUNTER_ON_SEND_FAILURE : bool = false;
pub const COUNTER_ON_ABANDON : bool = false;
pub const COUNTER_ON_BATCH_FAILURE : bool = false;
pub const COUNTER_ON_QUEUE_DEPTH : bool = false;
pub const MONITORING_ARTIFACTS_SEARCHED : u8 = 4;
pub const MONITORING_ARTIFACTS_NAMING_EITHER_COUNTER : u8 = 0;
pub const A_DRAIN_FAILURE_IS_A_LOG_LINE : bool = true;
pub const A_DRAIN_FAILURE_IS_A_METRIC : bool = false;

pub fn drain_failure_is_observable(counter_exists: bool, an_artifact_reads_it: bool) bool {
  return counter_exists and an_artifact_reads_it;
}

pub fn outage_is_distinguishable_from_quiet(delivered_this_tick: u16, failure_counter_exists: bool) bool {
  return failure_counter_exists or delivered_this_tick >= 1;
}

pub fn loss_is_measured(abandon_counter_exists: bool) bool {
  return abandon_counter_exists;
}

pub fn queued_minus_delivered(queued: u16, delivered: u16) u16 {
  return queued - delivered;
}

; That difference is an upper bound and not a loss: it also absorbs the zero-chat skip and every row
; still in flight, and neither of those has a counter either.
pub fn that_difference_is_a_loss(abandon_counted: bool, skip_counted: bool, inflight_is_known: bool) bool {
  return abandon_counted and skip_counted and inflight_is_known;
}

; --- Scope: what this transport actually carries ---------------------------------------------------------
pub const OUTBOUND_SEND_SITES_IN_SRC : u8 = 53;
pub const FILES_WITH_AN_OUTBOUND_SEND : u8 = 12;
pub const SEND_SITES_BEHIND_THIS_QUEUE : u8 = 1;
pub const QUEUED_KINDS_ARE_ALL_REFERRAL_LIFECYCLE : bool = true;

pub fn send_is_persisted(goes_through_the_queue: bool) bool {
  return goes_through_the_queue;
}

pub fn unqueued_send_sites(total: u8, queued: u8) u8 {
  return total - queued;
}

pub fn a_failed_send_can_be_retried(goes_through_the_queue: bool) bool {
  return send_is_persisted(goes_through_the_queue);
}

; --- Refusals ----------------------------------------------------------------------------------------------
pub const BACKOFF_IS_NOT_SHIPPED : bool = true;
pub const BACKOFF_NOTE : str = "No delay grows between attempts and none is configurable. scheduled_at is written once (src/db/notifications.rs:77) and updated at 0 sites, the failure branch calls only the counter increment (src/notification_queue.rs:116, SQL at src/db/notifications.rs:138), and the drain declares three constants and not one of them is a retry delay (:18-20). Closing this needs a write of scheduled_at on failure and a due-time predicate in the scan, which the column already supports and the query does not use. No interval is invented here in its place, and the 30 seconds pinned above is the poll interval rather than a chosen retry delay -- the retry inherits it by having no opinion of its own.";

pub const PER_RECIPIENT_RATE_LIMIT_IS_NOT_SHIPPED : bool = true;
pub const PER_RECIPIENT_RATE_NOTE : str = "Nothing bounds how many rows for one person may be drained in one tick. The scan (src/db/notifications.rs:97-104) groups by nothing, the loop (src/notification_queue.rs:57-120) sends each row as it comes, and the file contains 0 sleeps. Fifty rows for one customer would be fifty messages as fast as the socket allows. Closing this needs a per-recipient bound at the scan or a pause in the loop; how often one customer may be written to is the owner's decision and not the transport's, and no figure is coined here to stand in for it.";

pub const QUEUE_DEPTH_IS_NOT_PUBLISHED : bool = true;
pub const QUEUE_DEPTH_NOTE : str = "The two counters on this path are events and not levels: one fires at the insert and one after a confirmed delivery, and neither reports how many rows are pending now. Their difference is not the backlog either, because an abandonment (src/notification_queue.rs:114) and a zero-chat skip (:63) both leave the queue without touching the delivery counter. A gauge over processed_at IS NULL is the missing input, and the partial index at migrations/067_notification_queue.sql:15-17 would already serve it. Metric naming is turbobaby/observability's rule and no name is coined here.";

pub const DEAD_LETTER_STORE_IS_NOT_SHIPPED : bool = true;
pub const DEAD_LETTER_NOTE : str = "An abandoned row is not moved, not flagged and not copied anywhere. src/notification_queue.rs:112-114 writes the same processed_at a delivery writes, the comment beside it says the purpose is to stop retrying, and the error text reaches the warn at :106-111 and no column -- it is logged once per failure and never persisted. After the third failure the repository holds no record that the message was never received, only a row that reads as delivered. Closing this needs either a column recording which outcome ended the row or a separate table for abandonment, plus the last error. Neither is invented here, and the abandonment is not renamed a delivery in this contract merely because the two share a column.";

pub const DELIVERY_RECEIPT_IS_NOT_SHIPPED : bool = true;
pub const DELIVERY_RECEIPT_NOTE : str = "processed_at records that a send returned Ok to this process, which is the transport's acknowledgement and not the customer's. Nothing reads a message id and nothing records one -- the Ok binding at src/notification_queue.rs:93 is discarded -- and no later pass reconciles anything against this table. This contract therefore never says a customer was reached; it says a send was acknowledged and a row was marked, and the gap between those two statements is exactly what a receipt would close.";

; --- Tests ------------------------------------------------------------------------------------------------

test a_row_has_two_derived_states_and_no_state_column {
  assert ROW_HAS_A_STATE_COLUMN == false;
  assert ROW_COLUMN_COUNT == 8;
  assert STATE_COUNT == 2;
  assert row_state(false) == STATE_PENDING;
  assert row_state(true) == STATE_TERMINAL;
  assert state_is_terminal(STATE_TERMINAL) == true;
  assert state_is_terminal(STATE_PENDING) == false;
  assert row_may_be_drained_again(false) == true;
  assert row_may_be_drained_again(true) == false;
}

test three_outcomes_end_a_row_and_the_row_forgets_which {
  assert TERMINAL_OUTCOME_COUNT == 3;
  assert outcome_is_terminal(OUTCOME_DELIVERED) == true;
  assert outcome_is_terminal(OUTCOME_ABANDONED) == true;
  assert outcome_is_terminal(OUTCOME_SKIPPED_NO_CHAT) == true;
  assert outcome_is_terminal(0) == false;
  assert outcome_is_terminal(4) == false;
  assert outcome_is_legible_afterwards(OUTCOME_DELIVERED, true) == false;
  assert outcome_is_legible_afterwards(OUTCOME_ABANDONED, true) == false;
  assert outcome_is_legible_afterwards(OUTCOME_DELIVERED, false) == true;
  assert outcome_is_legible_afterwards(OUTCOME_ABANDONED, false) == false;
}

test the_insert_asks_nothing_about_the_kind {
  assert KIND_CHECK_CONSTRAINT_COUNT == 0;
  assert PAYLOAD_SCHEMA_IS_VALIDATED == false;
  assert KIND_COLUMN_MAX_CHARS == 50;
  assert insert_is_admitted(true, true) == true;
  assert insert_is_admitted(false, true) == false;
  assert insert_is_admitted(true, false) == false;
}

test one_readable_kind_has_no_writer_and_that_is_deliberate {
  assert RENDERABLE_KIND_COUNT == 4;
  assert WRITTEN_KIND_COUNT == 3;
  assert unwritten_readable_kinds(RENDERABLE_KIND_COUNT, WRITTEN_KIND_COUNT) == KINDS_WITH_A_READER_AND_NO_WRITER;
  assert KINDS_WITH_A_READER_AND_NO_WRITER == 1;
}

test an_unknown_kind_is_sent_rather_than_refused {
  assert UNKNOWN_KIND_IS_REFUSED == false;
  assert UNKNOWN_KIND_STILL_SENDS == true;
  assert UNKNOWN_KIND_EMITS_THE_RAW_COLUMN == true;
  assert message_is_kind_specific(false) == false;
  assert message_is_kind_specific(true) == true;
  assert row_reaches_a_customer(false, true) == true;
  assert row_reaches_a_customer(true, true) == true;
  assert row_reaches_a_customer(true, false) == false;
}

test the_batch_caps_the_tick_and_leaves_the_rest {
  assert rows_this_tick(0) == 0;
  assert rows_this_tick(50) == 50;
  assert rows_this_tick(51) == 50;
  assert tick_is_capped(50) == false;
  assert tick_is_capped(51) == true;
  assert backlog_after_tick(51) == 1;
  assert backlog_after_tick(50) == 0;
  assert FIRST_TICK_IS_DISCARDED == true;
}

test the_scheduled_at_column_does_not_schedule {
  assert SCHEDULED_AT_COLUMN_EXISTS == true;
  assert SCHEDULED_AT_IS_A_DUE_TIME_FILTER == false;
  assert DRAIN_FILTER_COUNT == 2;
  assert drain_waits_for_the_scheduled_time(false, true) == false;
  assert drain_waits_for_the_scheduled_time(true, true) == true;
  assert drain_waits_for_the_scheduled_time(true, false) == false;
  assert drain_admits_row(false, 0, ATTEMPTS_FILTER_CEILING, true) == true;
  assert drain_admits_row(false, 0, ATTEMPTS_FILTER_CEILING, false) == true;
  assert drain_admits_row(true, 0, ATTEMPTS_FILTER_CEILING, false) == false;
  assert drain_admits_row(false, 3, ATTEMPTS_FILTER_CEILING, false) == false;
}

test three_sends_are_allowed_and_the_third_failure_ends_the_row {
  assert attempts_after_failure(0) == 1;
  assert attempts_after_failure(1) == 2;
  assert attempts_after_failure(2) == 2;
  assert failure_abandons_the_row(0) == false;
  assert failure_abandons_the_row(1) == false;
  assert failure_abandons_the_row(2) == true;
  assert failure_is_retried(0) == true;
  assert failure_is_retried(2) == false;
  assert SEND_ATTEMPTS_PER_ROW == MAX_ATTEMPTS;
}

test the_attempts_filter_guards_a_value_the_code_cannot_write {
  assert ATTEMPTS_AT_INSERT == 0;
  assert HIGHEST_ATTEMPTS_VALUE_THE_CODE_CAN_WRITE == 2;
  assert ATTEMPTS_FILTER_CEILING == 3;
  assert attempts_filter_excludes(3) == true;
  assert attempts_value_is_writable(3) == false;
  assert the_attempts_filter_is_reachable(0) == false;
  assert the_attempts_filter_is_reachable(1) == false;
  assert the_attempts_filter_is_reachable(2) == false;
  assert the_attempts_filter_is_reachable(3) == false;
  assert THE_ATTEMPTS_FILTER_CAN_EXCLUDE_A_ROW == false;
  assert attempts_ceiling_is_unreachable(true) == true;
  assert attempts_ceiling_is_unreachable(false) == false;
  assert ATTEMPTS_CEILING_IS_UNREACHABLE_ONLY_WITH_ONE_DRAINER == true;
}

test the_retry_horizon_is_sixty_seconds_because_nothing_backs_off {
  assert BACKOFF_EXISTS == false;
  assert JITTER_EXISTS == false;
  assert SCHEDULED_AT_UPDATE_SITES == 0;
  assert RETRY_INTERVAL_SECONDS == POLL_INTERVAL_SECONDS;
  assert retry_horizon_seconds(POLL_INTERVAL_SECONDS, 3) == RETRY_HORIZON_SECONDS;
  assert retry_horizon_seconds(30, 3) == 60;
  assert message_survives_outage(59) == true;
  assert message_survives_outage(60) == false;
  assert message_survives_outage(600) == false;
}

test a_block_and_a_timeout_are_the_same_event_here {
  assert SEND_FAILURE_CLASS_COUNT == 1;
  assert PERMANENT_AND_TRANSIENT_ARE_TOLD_APART == false;
  assert failure_handling_depends_on_the_cause(true, SEND_FAILURE_CLASS_COUNT) == false;
  assert failure_handling_depends_on_the_cause(false, SEND_FAILURE_CLASS_COUNT) == false;
  assert failure_handling_depends_on_the_cause(true, 2) == true;
  assert failure_handling_depends_on_the_cause(false, 2) == false;
}

test the_transport_contributes_nothing_to_dedupe {
  assert QUEUE_HAS_A_DEDUPE_KEY == false;
  assert TRANSPORT_GUARD_PRESENT == false;
  assert QUEUE_UNIQUE_CONSTRAINT_COUNT == 1;
  assert THE_UNIQUE_CONSTRAINT_IS_A_RANDOM_UUID == true;
  assert duplicate_enqueue_is_stopped(true) == true;
  assert duplicate_enqueue_is_stopped(false) == false;
  assert a_new_producer_inherits_a_guard(false) == false;
  assert PRODUCERS_WITH_THEIR_OWN_GUARD == PRODUCER_COUNT;
  assert GUARD_SHAPE_COUNT == PRODUCER_COUNT;
}

test a_delivered_message_can_be_delivered_again_without_a_duplicate_row {
  assert THE_SEND_IS_IDEMPOTENT == false;
  assert A_FAILED_MARK_ADVANCES_ATTEMPTS == false;
  assert attempts_after_successful_send(0) == 0;
  assert attempts_after_successful_send(2) == 2;
  assert row_stays_pending_after_send(true, false) == true;
  assert row_stays_pending_after_send(true, true) == false;
  assert row_stays_pending_after_send(false, false) == false;
  assert customer_is_messaged_twice(true, false, true) == true;
  assert customer_is_messaged_twice(true, true, true) == false;
  assert customer_is_messaged_twice(true, false, false) == false;
}

test the_resend_loop_is_bounded_only_by_the_write_that_keeps_failing {
  assert RESENDS_AFTER_A_FAILED_MARK_ARE_BOUNDED == false;
  assert THE_ONLY_BARRIER_IS_THE_WRITE_THAT_FAILED == true;
  assert resend_count_is_bounded(true) == true;
  assert resend_count_is_bounded(false) == false;
  assert A_RESEND_AFTER_A_FAILED_MARK_IS_COUNTED == false;
  assert A_RESEND_AFTER_A_FAILED_MARK_IS_LOGGED == true;
}

test the_scan_orders_but_does_not_totally_order {
  assert ORDER_KEY == "scheduled_at";
  assert ORDER_KEY_COUNT == 1;
  assert TIEBREAKER_COUNT == 0;
  assert order_is_total(TIEBREAKER_COUNT) == false;
  assert order_is_total(1) == true;
  assert ORDER_IS_OLDEST_FIRST == true;
  assert A_FAILED_ROW_KEEPS_ITS_PLACE == true;
  assert PER_RECIPIENT_ORDERING_EXISTS == false;
}

test ordering_holds_only_while_one_drainer_exists {
  assert ROW_CLAIM_EXISTS == false;
  assert SKIP_LOCKED_SITES_IN_THE_STORE == 0;
  assert DRAINER_SPAWN_SITES == 1;
  assert SENDS_WITHIN_A_BATCH_ARE_SEQUENTIAL == true;
  assert fifo_holds(true, true) == true;
  assert fifo_holds(false, true) == false;
  assert fifo_holds(true, false) == false;
  assert two_drainers_see_the_same_rows(false, 2) == true;
  assert two_drainers_see_the_same_rows(true, 2) == false;
  assert two_drainers_see_the_same_rows(false, 1) == false;
  assert ordering_survives_a_second_process(false, 2) == false;
  assert ordering_survives_a_second_process(false, 1) == true;
}

test a_zero_chat_id_leaves_the_queue_looking_delivered {
  assert ZERO_CHAT_ID_IS_SKIPPED == true;
  assert ZERO_CHAT_ID_SKIP_IS_LOGGED == false;
  assert ZERO_CHAT_ID_SKIP_INCREMENTS_A_COUNTER == false;
  assert send_is_attempted(false, true) == false;
  assert send_is_attempted(true, true) == true;
  assert send_is_attempted(true, false) == false;
  assert outcome_increments_a_counter(OUTCOME_SKIPPED_NO_CHAT) == false;
}

test a_failed_language_read_degrades_instead_of_deferring {
  assert LOCALE_IS_READ_PER_ROW == true;
  assert LOCALE_READ_FAILURE_IS_DISTINGUISHABLE == false;
  assert A_LOCALE_READ_FAILURE_DEFERS_THE_ROW == false;
  assert DRAIN_HOLDS_ITS_OWN_FALLBACK_LITERAL == true;
  assert locale_is_resolved(true) == true;
  assert locale_is_resolved(false) == false;
  assert drain_sends_in_the_fallback(false, false) == true;
  assert drain_sends_in_the_fallback(true, true) == true;
  assert drain_sends_in_the_fallback(true, false) == false;
}

test one_button_serves_every_rendering_path {
  assert BUTTON_COUNT_PER_MESSAGE == 1;
  assert BUTTON_TARGET_COUNT == 1;
  assert BUTTON_IS_BUILT_OUTSIDE_THE_KIND_MATCH == true;
  assert RENDERING_PATH_COUNT == 5;
  assert button_can_differ_by_path(RENDERING_PATH_COUNT, BUTTON_TARGET_COUNT) == false;
  assert button_can_differ_by_path(1, 1) == true;
  assert BUTTON_TARGET_HAS_A_LIVE_TEST == true;
}

test a_drain_failure_is_a_log_line_and_nothing_reads_it {
  assert COUNTERS_ON_THIS_PATH == 2;
  assert COUNTER_ON_ENQUEUE == true;
  assert COUNTER_ON_DELIVERY == true;
  assert COUNTER_ON_SEND_FAILURE == false;
  assert COUNTER_ON_ABANDON == false;
  assert COUNTER_ON_BATCH_FAILURE == false;
  assert COUNTER_ON_QUEUE_DEPTH == false;
  assert MONITORING_ARTIFACTS_SEARCHED == 4;
  assert MONITORING_ARTIFACTS_NAMING_EITHER_COUNTER == 0;
  assert A_DRAIN_FAILURE_IS_A_LOG_LINE == true;
  assert drain_failure_is_observable(COUNTER_ON_BATCH_FAILURE, false) == false;
  assert drain_failure_is_observable(true, false) == false;
  assert drain_failure_is_observable(true, true) == true;
}

test a_silent_tick_and_a_total_outage_look_alike {
  assert EMPTY_TICK_IS_SILENT == true;
  assert EMPTY_TICK_SILENCE_IS_ANNOTATED == true;
  assert outage_is_distinguishable_from_quiet(0, false) == false;
  assert outage_is_distinguishable_from_quiet(0, true) == true;
  assert outage_is_distinguishable_from_quiet(1, false) == true;
}

test the_loss_figure_is_an_upper_bound_and_not_a_loss {
  assert loss_is_measured(COUNTER_ON_ABANDON) == false;
  assert loss_is_measured(true) == true;
  assert queued_minus_delivered(10, 4) == 6;
  assert queued_minus_delivered(4, 4) == 0;
  assert that_difference_is_a_loss(false, false, false) == false;
  assert that_difference_is_a_loss(true, false, true) == false;
  assert that_difference_is_a_loss(true, true, true) == true;
}

test the_queue_carries_one_outbound_send_site_of_fifty_three {
  assert OUTBOUND_SEND_SITES_IN_SRC == 53;
  assert FILES_WITH_AN_OUTBOUND_SEND == 12;
  assert SEND_SITES_BEHIND_THIS_QUEUE == 1;
  assert unqueued_send_sites(OUTBOUND_SEND_SITES_IN_SRC, SEND_SITES_BEHIND_THIS_QUEUE) == 52;
  assert send_is_persisted(true) == true;
  assert send_is_persisted(false) == false;
  assert a_failed_send_can_be_retried(false) == false;
  assert a_failed_send_can_be_retried(true) == true;
  assert QUEUED_KINDS_ARE_ALL_REFERRAL_LIFECYCLE == true;
}

test every_reuse_edge_names_an_owner_and_restates_nothing {
  assert REUSES_PROMO_BROADCAST_ID == "turbobaby/promo-broadcast";
  assert REUSES_REFERRAL_PROGRAM_ID == "turbobaby/referral-program";
  assert REUSES_LOCALE_POLICY_ID == "turbobaby/locale-policy";
  assert REUSES_BOT_SURFACE_ID == "turbobaby/bot-surface";
  assert REUSES_OBSERVABILITY_ID == "turbobaby/observability";
  assert REUSES_DEEPLINK_ID == "turbobaby/deeplink";
  assert REUSES_RUNTIME_CONFIG_ID == "turbobaby/runtime-config";
  assert REUSES_LEGACY_RETIREMENT_ID == "turbobaby/legacy-retirement";
  assert REUSE_EDGE_COUNT == 8;
  assert ID == "turbobaby/notification-queue";
  assert KIND == "transport-contract";
}

test what_is_missing_is_named_rather_than_guessed {
  assert BACKOFF_IS_NOT_SHIPPED == true;
  assert PER_RECIPIENT_RATE_LIMIT_IS_NOT_SHIPPED == true;
  assert QUEUE_DEPTH_IS_NOT_PUBLISHED == true;
  assert DEAD_LETTER_STORE_IS_NOT_SHIPPED == true;
  assert DELIVERY_RECEIPT_IS_NOT_SHIPPED == true;
  assert PACING_SLEEPS_IN_THE_DRAIN == 0;
  assert FUTURE_SCHEDULED_AT_WRITE_SITES == 0;
  assert A_FUTURE_ROW_IS_SENT_ON_THE_NEXT_TICK == true;
}

; --- Invariants ---------------------------------------------------------------------------------------------

invariant the_row_never_says_which_of_the_three_outcomes_ended_it
  assert THE_ROW_RECORDS_WHICH_OUTCOME == false and outcome_is_legible_afterwards(OUTCOME_ABANDONED, true) == false

invariant an_abandonment_is_written_with_a_deliverys_column
  assert A_GIVEUP_IS_WRITTEN_AS_A_DELIVERY == true and TERMINAL_OUTCOMES_SHARE_ONE_COLUMN == true and outcome_increments_a_counter(OUTCOME_ABANDONED) == false

invariant the_third_failure_ends_the_row_and_the_second_does_not
  assert failure_abandons_the_row(2) == true and failure_abandons_the_row(1) == false and attempts_after_failure(2) == 2

invariant no_writable_value_reaches_the_attempts_filter
  assert the_attempts_filter_is_reachable(2) == false and the_attempts_filter_is_reachable(3) == false and THE_ATTEMPTS_FILTER_CAN_EXCLUDE_A_ROW == false

invariant the_attempts_ceiling_is_unreachable_because_one_drainer_exists
  assert attempts_ceiling_is_unreachable(false) == false and DRAINER_SPAWN_SITES == 1 and ROW_CLAIM_EXISTS == false

invariant the_poll_interval_is_a_marked_copy_with_one_arbiter
  assert INTERVAL_SOURCE_LINE == "src/notification_queue.rs:18" and RETRY_INTERVAL_SECONDS == POLL_INTERVAL_SECONDS

invariant the_retry_budget_is_spent_in_two_poll_intervals
  assert retry_horizon_seconds(POLL_INTERVAL_SECONDS, 3) == 60 and BACKOFF_EXISTS == false and SCHEDULED_AT_UPDATE_SITES == 0

invariant an_outage_of_one_minute_loses_the_message
  assert message_survives_outage(60) == false and message_survives_outage(59) == true

invariant the_queue_stops_no_duplicate_by_itself
  assert duplicate_enqueue_is_stopped(false) == false and QUEUE_HAS_A_DEDUPE_KEY == false and TRANSPORT_GUARD_PRESENT == false

invariant a_send_that_succeeds_and_a_mark_that_fails_sends_again
  assert customer_is_messaged_twice(true, false, true) == true and attempts_after_successful_send(1) == 1

invariant that_resend_is_bounded_by_nothing_in_the_code
  assert resend_count_is_bounded(false) == false and RESENDS_AFTER_A_FAILED_MARK_ARE_BOUNDED == false

invariant a_single_sort_key_is_not_a_total_order
  assert order_is_total(TIEBREAKER_COUNT) == false and ORDER_KEY_COUNT == 1

invariant fifo_is_a_property_of_having_one_drainer_not_of_the_table
  assert fifo_holds(false, true) == false and two_drainers_see_the_same_rows(ROW_CLAIM_EXISTS, 2) == true

invariant the_column_named_scheduled_at_never_delays_a_row
  assert drain_waits_for_the_scheduled_time(SCHEDULED_AT_IS_A_DUE_TIME_FILTER, true) == false and drain_admits_row(false, 0, ATTEMPTS_FILTER_CEILING, true) == true

invariant a_row_with_no_chat_leaves_without_a_trace
  assert send_is_attempted(false, true) == false and ZERO_CHAT_ID_SKIP_INCREMENTS_A_COUNTER == false and ZERO_CHAT_ID_SKIP_IS_LOGGED == false

invariant a_language_read_that_fails_still_sends
  assert drain_sends_in_the_fallback(true, true) == true and A_LOCALE_READ_FAILURE_DEFERS_THE_ROW == false

invariant one_target_cannot_differ_across_five_rendering_paths
  assert button_can_differ_by_path(RENDERING_PATH_COUNT, BUTTON_TARGET_COUNT) == false

invariant a_batch_failure_reaches_no_counter_and_no_artifact
  assert drain_failure_is_observable(COUNTER_ON_BATCH_FAILURE, false) == false and A_DRAIN_FAILURE_IS_A_METRIC == false and MONITORING_ARTIFACTS_NAMING_EITHER_COUNTER == 0

invariant a_quiet_tick_is_indistinguishable_from_a_total_outage
  assert outage_is_distinguishable_from_quiet(0, COUNTER_ON_SEND_FAILURE) == false

invariant the_difference_of_two_counters_is_not_a_loss_figure
  assert that_difference_is_a_loss(COUNTER_ON_ABANDON, false, false) == false and loss_is_measured(COUNTER_ON_ABANDON) == false

invariant fifty_two_outbound_sends_are_not_persisted_at_all
  assert unqueued_send_sites(OUTBOUND_SEND_SITES_IN_SRC, SEND_SITES_BEHIND_THIS_QUEUE) == 52 and a_failed_send_can_be_retried(false) == false

invariant a_tick_never_exceeds_the_batch
  assert rows_this_tick(51) == BATCH_SIZE and rows_this_tick(50) == BATCH_SIZE and tick_is_capped(50) == false

invariant this_file_owns_no_kind_its_producers_do_not
  assert unwritten_readable_kinds(RENDERABLE_KIND_COUNT, WRITTEN_KIND_COUNT) == 1 and UNKNOWN_KIND_IS_REFUSED == false
