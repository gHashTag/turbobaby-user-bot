// SPDX-License-Identifier: Apache-2.0
; specs/turbobaby/schema_provenance.t27 -- how this database gets its shape, and which way it
; leans when it cannot tell
; This contract owns four things and nothing else: the migration sequence law (D1, D2), the
; established-versus-fresh decision the runner makes once per boot (D3), the columns whose
; absence is supposed to be noticed at boot (D10), and the fail-open read macro D9 calls the
; single most dangerous construct in the tree. It owns no table, no column type and no DDL.
; --
; WHY (measured 2026-09-21). 86 migration files, 4271 lines, applied by a runner whose every
; read of its own bookkeeping ends in a default. Three of them, all inside run_migrations:
; src/db/mod.rs:653 defaults an unreadable tracker count to 0, :664 defaults an unreadable
; established probe to false, :709 defaults an unreadable applied flag to false. Each default
; picks the branch that does MORE work against the database -- tracker empty, database fresh,
; migration not yet applied -- so the direction of the residual error is toward re-applying
; 86 migrations, including seeds, over live rows. That is not a bug this file reports; it is
; the shape the file exists to make visible, because none of the three reads is wrong often
; enough to be noticed and all three are wrong the same way.
; --
; WHY THE PROBE IS ONE LINE AND NOT A PARAGRAPH. D3 calls its subject the highest-consequence
; single line in the change, and the arithmetic behind that is checkable: the probe asks whether
; one table exists, and the answer routes the boot between marking 76 migrations applied without
; running them and running all 86. Wrong in one direction it applies 001-076 over a populated
; production database; wrong in the other it marks a base schema applied that was never created
; and the very next migration fails the boot. Those two directions are NOT symmetric -- one is
; silent and destroys data, the other is loud and destroys nothing -- and the runner's default
; on an unreadable probe is the silent one.
; --
; WHERE THE BRIEF IS REFUTED. The brief asked for "the columns whose absence must stop a boot".
; No such column exists. src/db/mod.rs:738 states that the check never blocks startup,
; src/main.rs:454 calls it non-fatal, and src/main.rs:455-471 logs a tracing::error!, sets a
; Prometheus gauge and prints "Database connected (with schema warnings above)". A missing
; critical column stops nothing. What it does is raise a number an alert can fire on, which is
; a different and weaker claim, and this file states the weaker one.
; --
; WHERE DECISIONS.md IS OUT OF DATE (measured 2026-09-21, every citation opened). Four of its
; line numbers have rotted and two of its present-tense sentences describe a state that has
; since been fixed. D1 cites src/db/mod.rs:1021-1047 for the sequence test; it is at :1384.
; D2 cites :488-520 for the backfill; run_migrations begins at :600 and the backfill branch is
; :654-695. D3 cites :495 and quotes the probe as reading public.strains; the live line is :659
; and it reads public.orders, so D3 has been APPLIED and its text is a record of the defect, not
; of the code. D10 cites :340-353 and says CRITICAL_COLUMNS "currently guards only"
; accessory_sets, tea_sets and sets; the live list is at :402-434 and carries bikes and
; bike_units, so D10 has been applied too. Only D9's citation survives unchanged: try_get_warn!
; is exactly src/db/macros.rs:28-44. The numbers below are the measured ones; the decisions are
; cited by identifier, which does not rot.
; --
; WHERE A SIBLING SPEC IS REFUTED. availability.t27:103-104 and deposit_tiers.t27:16-17 both say
; scripts/verify_fleet_seed.py "knows nothing about .t27" (the phrase itself lands on :104 and
; :17, the sentence opens on :103 and :16). As written that is false: the gate
; reads exactly one .t27 file (scripts/verify_fleet_seed.py:34, market_profile.t27) and pins the
; seed's 13-field market block to its constants. The verdict those two files draw from the claim
; still stands -- the gate does not compare any .t27 fleet table to the seed -- so what is wrong
; is the reason, not the conclusion. Stated here because this file owns what that gate covers.
; --
; WHAT THIS FILE NEVER DOES. It transcribes no schema: no CREATE TABLE, no column type, no
; constraint text, no table list kept for its own sake. It claims no migration number for work
; that has not been done -- migrations/wip/077_quest_progress.sql is pinned as a tripwire and
; given no slot, because a number reserved in a spec is a number the gap-free rule cannot see.
; It restates no fleet figure, no price, no deposit and no unit count: those belong to
; availability.t27, bike-catalog.t27 and the money specs, and this file names their IDs and
; carries none of their numbers. It holds no renter name, handle, phone, key code, plate, debt,
; purchase price or note (D14), and it could not: its whole subject is file names and booleans.
; phi^2 + 1/phi^2 = 3 | TRINITY

module turbobaby-schema-provenance;

pub const KIND : str = "schema-provenance-contract";
pub const ID : str = "turbobaby/schema-provenance";
pub const NAME : str = "TurboBaby schema provenance";
pub const WORLD : str = "gHashTag/turbobaby-user-bot";
pub const MEASURED_AT : str = "2026-09-21";
pub const DECISION_RECORD : str = "DECISIONS.md";
pub const RUNNER_IMPLEMENTATION : str = "src/db/mod.rs";
pub const FAIL_OPEN_MACRO_IMPLEMENTATION : str = "src/db/macros.rs";
pub const SEED_GATE : str = "scripts/verify_fleet_seed.py";
pub const SPEC_GATE : str = "scripts/verify_t27_specs.py";

; --- Reuse edges ---------------------------------------------------------------------------
; Each of these owns a table of numbers this file deliberately does not carry. The seed gate
; compares the market block to market_profile.t27's constants and the seeded rows to the JSON;
; what those rows SAY about the fleet is availability.t27's and bike_catalog.t27's decision, and
; how an absent price renders is pricing_honesty.t27's. publication.t27 owns the compiler and
; scanner evidence rules, including the probe floor whose shape D16 names.
pub const REUSES_MARKET_ID : str = "turbobaby/market";
pub const REUSES_AVAILABILITY_ID : str = "turbobaby/availability";
pub const REUSES_CATALOG_ID : str = "turbobaby/bike-catalog";
pub const REUSES_PRICING_HONESTY_ID : str = "turbobaby/pricing-honesty";
pub const REUSES_PUBLICATION_ID : str = "turbobaby/publication";

; --- The sequence law (D1, D2) ---------------------------------------------------------------
; ls migrations/*.sql | wc -l -> 86, and the numeric prefixes run 001..086 with no gap and no
; duplicate (verified by sorting the prefixes: first 001, last 086, count 86, no index mismatch).
; wc -l migrations/*.sql -> 4271 total. src/db/mod.rs:29 holds the same 86 as include_str!
; entries, so disk and code agree by count as well as by name.
pub const MIGRATION_FILES : u8 = 86;
pub const MIGRATION_LINES : u16 = 4271;
pub const MIGRATION_ENTRIES_IN_CODE : u8 = 86;
pub const SEQUENCE_FIRST : u8 = 1;
pub const SEQUENCE_LAST : u8 = 86;
; D1: the sequence test asserts a gap-free run from 001, so a reserved gap is not an option and
; the bike domain starts at the first free slot above the last pre-bike migration.
pub const BIKE_DOMAIN_FIRST : u8 = 77;
pub const SEQUENCE_GUARD : str = "src/db/mod.rs:1384 migration_numbers_are_sequential_and_unique";

pub fn sequence_is_gap_free(first: u8, last: u8, file_count: u8) bool {
  if (last < first) {
    return false;
  }
  return first == SEQUENCE_FIRST and (last - first) + 1 == file_count;
}

pub fn number_is_taken(number: u8) bool {
  return number >= SEQUENCE_FIRST and number <= SEQUENCE_LAST;
}

pub fn number_is_bike_domain(number: u8) bool {
  return number >= BIKE_DOMAIN_FIRST and number <= SEQUENCE_LAST;
}

pub fn next_free_number(highest_on_disk: u8) u8 {
  return highest_on_disk + 1;
}

pub fn disk_and_code_agree(files_on_disk: u8, entries_in_code: u8) bool {
  return files_on_disk == entries_in_code;
}

; D2: a migration that exists has run somewhere, and the runner records it by NAME and never
; re-applies it. Editing it therefore changes fresh installs only and leaves every established
; database on the old shape for ever. The only expressible change is a new forward file.
pub const EDIT_IN_PLACE_IS_FORBIDDEN : bool = true;

pub fn migration_is_frozen(number: u8) bool {
  return number_is_taken(number);
}

pub fn change_is_expressible(number: u8, is_a_new_file: bool) bool {
  if (is_a_new_file) {
    return true;
  }
  return !migration_is_frozen(number);
}

; --- The wip tripwire ------------------------------------------------------------------------
; migrations/wip/077_quest_progress.sql claims 077, and migrations/077_bikes.sql already owns it.
; Both halves verified here rather than taken from D1. The walks that DECIDE the numbering are
; std::fs::read_dir with no recursion and a .sql filter, and there are FOUR of them in
; src/db/mod.rs, not one: :1133 (every_migration_file_is_included), :1333 (migration_files, shared
; by the numbering and wiring tests), :1483 (read_migrations_corpus) and :1644 (migration_tables).
; A directory entry survives none of the four, so the duplicate prefix never reaches the guard at
; :1384 and the collision is latent, not live. tests/retired_table_wiring.rs:97 is a fifth shallow
; walk, outside the runner module and named separately below.
; It does NOT follow that nothing reads the subdirectory, and that correction is the point of the
; two constants after the walk list: src/main.rs:2679 collect_files_with_ext recurses at :2687, so
; src/main.rs:2720 parse_migration_schema reads the wip file, and four shipped tests -- :3288,
; :3329, :3370 and :3568 -- build the schema they check against from a corpus that contains it.
; That reader takes CREATE TABLE and ALTER TABLE text and never looks at a filename prefix, so it
; cannot see the collision; what it refutes is the weaker sentence "nothing reads migrations/wip",
; which is false, and with it the idea that promotion is the first moment the file's contents
; matter.
; The arithmetic that proves the file is there: find migrations -name '*.sql' -> 87,
; ls migrations/*.sql -> 86, and the difference is exactly the one wip file. ls migrations/ also
; prints 87, counting the wip DIRECTORY rather than the wip file -- the right number by the wrong
; arithmetic, which pricing_honesty.t27 already records for its own recursive grep. That file's 87
; is the recursive count and belongs to it; the 86 here is the shallow walks' input and is a
; different measurement of a different set.
pub const WIP_DIRECTORY : str = "migrations/wip";
pub const WIP_FILE : str = "migrations/wip/077_quest_progress.sql";
pub const WIP_CLAIMED_NUMBER : u8 = 77;
pub const NUMBERING_WALK_IS_RECURSIVE : bool = false;
pub const MIGRATION_DIRECTORY_READERS : u8 = 4;
pub const MIGRATION_DIRECTORY_READER_SITES : [4]str = [
  "src/db/mod.rs:1133",
  "src/db/mod.rs:1333",
  "src/db/mod.rs:1483",
  "src/db/mod.rs:1644",
];
pub const SHALLOW_WALK_OUTSIDE_THE_RUNNER_MODULE : str = "tests/retired_table_wiring.rs:97";
pub const RECURSIVE_READER_SITE : str = "src/main.rs:2679 collect_files_with_ext, recursing at :2687";
pub const RECURSIVE_READER_ENTRY : str = "src/main.rs:2720 parse_migration_schema";
pub const RECURSIVE_READER_TESTS : u8 = 4;
pub const RECURSIVE_READER_TEST_SITES : [4]str = [
  "src/main.rs:3288",
  "src/main.rs:3329",
  "src/main.rs:3370",
  "src/main.rs:3568",
];
pub const WIP_FILE_IS_READ_BY_SOMETHING : bool = true;
pub const WIP_PREFIX_IS_READ_BY_SOMETHING : bool = false;
pub const SQL_FILES_TOP_LEVEL : u8 = 86;
pub const SQL_FILES_RECURSIVE : u8 = 87;
pub const WIP_COLLISION_TRIPWIRE : str = "migrations/wip/077_quest_progress.sql claims a number migrations/077_bikes.sql owns. Three non-recursive read_dir walks of migrations/ keep the subdirectory invisible, so nothing collides today and nothing reports it either. The moment the file is moved up it becomes a duplicate prefix and src/db/mod.rs:1384 fails. Renumber the promoted file to the next free slot above the highest migrations/*.sql on disk at that time; never renumber the bike migrations (D1).";

pub fn collision_is_live(candidate: u8, in_wip_subdirectory: bool) bool {
  if (in_wip_subdirectory and !NUMBERING_WALK_IS_RECURSIVE) {
    return false;
  }
  return number_is_taken(candidate);
}

; A walk that recurses READS the wip file; only a walk that also reads the filename prefix can
; see the collision. Separating the two is what keeps "latent" from hardening into "unread".
pub fn walk_sees_the_wip_file(walk_is_recursive: bool) bool {
  return walk_is_recursive;
}

pub fn walk_sees_the_collision(walk_is_recursive: bool, reads_the_prefix: bool) bool {
  return walk_is_recursive and reads_the_prefix;
}

pub fn promotion_number_is_safe(candidate: u8, highest_on_disk: u8) bool {
  return candidate == next_free_number(highest_on_disk);
}

pub fn recursive_excess(recursive: u8, top_level: u8) u8 {
  return recursive - top_level;
}

; --- The established-versus-fresh decision (D3) ----------------------------------------------
; src/db/mod.rs:659 asks SELECT to_regclass('public.orders') IS NOT NULL. The rejected form asked
; for public.strains, which 083_drop_cannabis_catalog.sql drops: keyed on a table the rebrand
; deletes, the probe would answer "fresh" for a populated production database the moment 083 had
; run. orders is created by 001_initial.sql:57 and survives, because a rental is still an order.
pub const ESTABLISHED_PROBE_TABLE : str = "public.orders";
pub const ESTABLISHED_PROBE_REJECTED_TABLE : str = "public.strains";
pub const ESTABLISHED_PROBE_SITE : str = "src/db/mod.rs:659";
pub const PROBE_TABLE_SURVIVES_THE_REBRAND : bool = true;

; The backfill stops at the last pre-bike migration instead of walking the whole list, because
; the claim it encodes -- these have demonstrably run before -- is only true of migrations that
; existed before this deploy. 76 marked, 10 left to run, and 76 < 86 is the property the shipped
; guard at src/db/mod.rs:1437 asserts.
pub const BACKFILL_BOUNDARY : str = "076_promo_broadcast.sql";
pub const BACKFILL_THROUGH : u8 = 76;
pub const MIGRATIONS_AFTER_BOUNDARY : u8 = 10;

pub const RUN_APPLY_ALL : u8 = 1;
pub const RUN_BACKFILL_THEN_APPLY : u8 = 2;
pub const RUN_APPLY_UNRECORDED : u8 = 3;

pub fn run_plan(tracker_rows: u16, probe_says_established: bool) u8 {
  if (tracker_rows > 0) {
    return RUN_APPLY_UNRECORDED;
  }
  if (probe_says_established) {
    return RUN_BACKFILL_THEN_APPLY;
  }
  return RUN_APPLY_ALL;
}

pub fn backfilled_count(plan: u8) u8 {
  if (plan == RUN_BACKFILL_THEN_APPLY) {
    return BACKFILL_THROUGH;
  }
  return 0;
}

pub fn applied_after_backfill(plan: u8) u8 {
  if (plan == RUN_BACKFILL_THEN_APPLY) {
    return MIGRATIONS_AFTER_BOUNDARY;
  }
  return 0;
}

pub fn boundary_leaves_work(file_count: u8, through: u8) bool {
  return through < file_count;
}

; The two directions, and why naming them separately is the point. A probe that says FRESH about
; an established database skips the backfill and applies 001-086 over live rows: silent, and the
; damage is the data. A probe that says ESTABLISHED about a fresh database marks a base schema
; applied that was never created, and the first migration that needs it fails the boot: loud, and
; the damage is a failed deploy. Only one of these is recoverable by reading a log.
pub fn probe_is_correct(probe_says_established: bool, database_is_established: bool) bool {
  return probe_says_established == database_is_established;
}

pub fn probe_error_destroys_data(probe_says_established: bool, database_is_established: bool) bool {
  return database_is_established and !probe_says_established;
}

pub fn probe_error_fails_the_boot(probe_says_established: bool, database_is_established: bool) bool {
  return probe_says_established and !database_is_established;
}

; The three defaults, as values rather than as a warning. Each is the literal the runner falls
; back to when the value it just queried cannot be read out of the row.
pub const RUNNER_DEFAULT_COUNT : u8 = 3;
pub const RUNNER_DEFAULT_SITES : [3]str = [
  "src/db/mod.rs:653",
  "src/db/mod.rs:664",
  "src/db/mod.rs:709",
];
pub const DEFAULT_TRACKER_ROWS : u16 = 0;
pub const DEFAULT_PROBE_ESTABLISHED : bool = false;
pub const DEFAULT_MIGRATION_APPLIED : bool = false;

pub fn runner_applies(applied_flag: bool) bool {
  return !applied_flag;
}

; --- The boot-time column check (D10) ---------------------------------------------------------
; CRITICAL_COLUMNS at src/db/mod.rs:402-434: five tables, nineteen columns, of which the bike
; catalog contributes two tables and seven columns. Seven is also the number of columns the
; 22e26660 false alarm named on 2026-09-13, every one of which was present minutes later, which
; is why the check now reads twice with 500 ms between them -- src/db/mod.rs:460, against the
; 11 ms that separated the false alarm from the last migration of a first-boot burst.
pub const CRITICAL_TABLES : u8 = 5;
pub const CRITICAL_COLUMNS_TOTAL : u8 = 19;
pub const CRITICAL_TABLE_NAMES : [5]str = [
  "accessory_sets", "tea_sets", "sets", "bikes", "bike_units",
];
pub const CRITICAL_COLUMNS_PER_TABLE : [5]u8 = [4, 4, 4, 5, 2];
pub const BIKE_CRITICAL_TABLES : u8 = 2;
pub const BIKE_CRITICAL_COLUMNS : u8 = 7;
pub const FALSE_ALARM_COLUMNS_NAMED : u8 = 7;
pub const RECHECK_DELAY_MS : u16 = 500;
pub const FALSE_ALARM_GAP_MS : u16 = 11;

pub fn critical_column_budget(a: u8, b: u8, c: u8, d: u8, e: u8) u8 {
  return a + b + c + d + e;
}

; THE REFUSAL THE BRIEF ASKED ABOUT. Nothing here stops a boot. The value of naming that is that
; the alternative reading -- absence is fatal, therefore a running process has its columns -- is
; exactly backwards: a running process proves only that the check ran, and it always continues.
pub const MISSING_COLUMN_STOPS_BOOT : bool = false;
pub const MISSING_COLUMN_RAISES_GAUGE : bool = true;
pub const BOOT_HALT_NOTE : str = "No column absence halts startup. src/db/mod.rs:738 says the self-check never blocks startup, src/main.rs:454 calls it non-fatal, and src/main.rs:455-471 logs tracing::error! with the column names, sets the schema_missing_columns gauge and then prints Database connected with schema warnings. The gauge is set even at zero so the series exists and a recovery is observable. Making an absence fatal would be a change to src/main.rs, not to this contract.";
pub const BOOT_OK : u8 = 1;
pub const BOOT_OK_WITH_WARNINGS : u8 = 2;

pub fn boot_outcome(missing_count: u8) u8 {
  if (missing_count == 0) {
    return BOOT_OK;
  }
  return BOOT_OK_WITH_WARNINGS;
}

pub fn boot_continues(missing_count: u8) bool {
  return boot_outcome(missing_count) == BOOT_OK or boot_outcome(missing_count) == BOOT_OK_WITH_WARNINGS;
}

pub fn gauge_value(missing_count: u8) u8 {
  return missing_count;
}

; The two reads, and the asymmetry between their failures. A FIRST read that errors returns an
; empty list: the check learned nothing and acquits everything. A SECOND read that errors clears
; nothing: the first read is reported verbatim and flagged unconfirmed. The rule when both
; succeed is THE LATER READ WINS, which is not the smaller read and not the intersection -- a
; column absent from the first read and present in the second has been DROPPED against a live
; database, and an intersection would swallow exactly that case.
pub const SETTLE_REPORT_EMPTY : u8 = 0;
pub const SETTLE_REPORT_FIRST_UNCONFIRMED : u8 = 1;
pub const SETTLE_REPORT_SECOND : u8 = 2;
pub const FIRST_READ_FAILURE_ACQUITS : bool = true;
pub const SECOND_READ_FAILURE_ACQUITS : bool = false;

pub fn settle_source(first_read_ok: bool, second_read_ok: bool) u8 {
  if (!first_read_ok) {
    return SETTLE_REPORT_EMPTY;
  }
  if (!second_read_ok) {
    return SETTLE_REPORT_FIRST_UNCONFIRMED;
  }
  return SETTLE_REPORT_SECOND;
}

pub fn settle_is_unconfirmed(first_read_ok: bool, second_read_ok: bool) bool {
  return settle_source(first_read_ok, second_read_ok) == SETTLE_REPORT_FIRST_UNCONFIRMED;
}

pub fn column_is_reported(in_first: bool, in_second: bool, second_read_ok: bool) bool {
  if (!second_read_ok) {
    return in_first;
  }
  return in_second;
}

pub fn column_appeared_between_reads(in_first: bool, in_second: bool, second_read_ok: bool) bool {
  return second_read_ok and in_first and !in_second;
}

pub fn intersection_would_hide_a_drop(in_first: bool, in_second: bool) bool {
  return !in_first and in_second;
}

; --- The fail-open read (D9) -------------------------------------------------------------------
; try_get_warn! is src/db/macros.rs:28-44 -- the one DECISIONS.md citation that did not rot. It
; wraps QueryResult::try_get, returns the typed default on Err, and emits a tracing::warn! under
; target db.schema_drift. Census measured 2026-09-21: grep -rn 'try_get_warn!(' src/ returns 24
; lines in four files, and three of them are the defining module talking about itself -- one doc
; example at src/db/macros.rs:16 and two self-tests at :68 and :75. Subtract those and 21 call
; sites remain in three files: 16 in src/api/catalog.rs, 3 in src/db/orders.rs, 2 in
; src/db/referrals.rs.
; ZERO on the bike path, and that zero is a decision rather than an accident: src/api/bikes.rs:43
; and src/db/bikes.rs:19 both state that the module keeps the macro off the path, and the typed
; SeaORM entity reads there turn a renamed column into a query error instead of a default.
pub const FAIL_OPEN_MACRO : str = "try_get_warn";
pub const FAIL_OPEN_MACRO_SITE : str = "src/db/macros.rs:28-44";
pub const FAIL_OPEN_EVIDENCE : str = "tracing::warn! target db.schema_drift";
pub const FAIL_OPEN_CALL_SITES : u8 = 21;
pub const FAIL_OPEN_CALL_SITE_FILES : u8 = 3;
pub const FAIL_OPEN_FILES : [3]str = [
  "src/api/catalog.rs", "src/db/orders.rs", "src/db/referrals.rs",
];
pub const FAIL_OPEN_SITES_PER_FILE : [3]u8 = [16, 3, 2];
pub const FAIL_OPEN_SITES_ON_BIKE_PATH : u8 = 0;

pub const READ_ERROR : u8 = 0;
pub const READ_VALUE : u8 = 1;
pub const READ_DEFAULT : u8 = 2;

pub fn call_site_census(a: u8, b: u8, c: u8) u8 {
  return a + b + c;
}

pub fn read_outcome(read_succeeded: bool) u8 {
  if (read_succeeded) {
    return READ_VALUE;
  }
  return READ_DEFAULT;
}

; Neither branch of the macro produces an error. That is the whole property: a caller cannot
; distinguish a read that worked from a read that did not, because both hand back a value of the
; right type, and the difference exists only in a log line nobody is required to read.
pub fn read_can_error(read_succeeded: bool) bool {
  return read_outcome(read_succeeded) == READ_ERROR;
}

pub fn drift_evidence_is_only_a_log_line(read_succeeded: bool) bool {
  return read_outcome(read_succeeded) == READ_DEFAULT;
}

; THE REFUSAL. D9's instruction is "grep every call site before renaming any column it reads",
; and nothing enforces it. grep -rn try_get_warn tests/ returns 0 on 2026-09-21, and the only two
; references to the log target db.schema_drift anywhere in src/, tests/ and scripts/ are the
; macro's own doc comment and the warn! inside it. The discipline is a human one, the census
; above is its only artefact, and a number in a spec is not a gate.
pub const FAIL_OPEN_GATES : u8 = 0;
pub const FAIL_OPEN_GATE_NOTE : str = "No automated check reads the try_get_warn call sites. grep -rn try_get_warn tests/ returns 0, and db.schema_drift appears twice in the tree, both inside src/db/macros.rs. Closing this needs a source-walking test that pins the call-site count and fails when a new one is added on a money or gating path, with the floor discipline D16 requires so an empty match cannot pass as a clean result.";

; --- The direction of the residual error --------------------------------------------------------
; availability.t27's header states the shape this borrows: the direction of a residual error is
; something a contract CHOOSES, and its choice is that an unrecognised code counts as not
; available, which costs a booking rather than double-books a bike. The three mechanisms this
; file owns were not chosen that way. The runner's defaults resolve toward writing to a live
; database; the column check never blocks, so a gap reaches whoever asks next; the fail-open read
; hands back a typed default, and what that default looks like to a customer is
; pricing_honesty.t27's decision, not a number restated here. Zero of the three lean the
; conservative way, and that count is the summary this section exists to make assertable.
pub const DIRECTION_REFUSE : u8 = 1;
pub const DIRECTION_SERVE : u8 = 2;
pub const DIRECTION_REAPPLY : u8 = 3;
pub const MECHANISM_COUNT : u8 = 3;
; runner defaults, boot-time column check, fail-open read -- in that order.
pub const MECHANISM_DIRECTIONS : [3]u8 = [3, 2, 2];
pub const CONSERVATIVE_MECHANISMS : u8 = 0;

pub fn direction_is_conservative(direction: u8) bool {
  return direction == DIRECTION_REFUSE;
}

pub fn direction_reaches_the_asker(direction: u8) bool {
  return direction == DIRECTION_SERVE;
}

pub fn direction_writes_to_a_live_database(direction: u8) bool {
  return direction == DIRECTION_REAPPLY;
}

; --- What the seed gate covers -------------------------------------------------------------------
; scripts/verify_fleet_seed.py pins migrations/082_bikes_seed.sql to data/fleet_seed.json field by
; field, and it is the only gate in this repository that opens a .t27 file: MARKET_SPEC at
; scripts/verify_fleet_seed.py:34, read at :112 and parsed one constant at a time by spec_const at
; :90-95, comparing the seed's market block to the 13 contract fields listed at :72-86. Three
; exits, deliberately distinct: files agree, files disagree, a file is missing or unparseable.
pub const SEED_GATE_SQL : str = "migrations/082_bikes_seed.sql";
pub const SEED_GATE_JSON : str = "data/fleet_seed.json";
pub const SEED_GATE_SPEC_READ : str = "specs/turbobaby/market_profile.t27";
pub const SEED_GATE_SPEC_FILES_READ : u8 = 1;
pub const SEED_GATE_MARKET_FIELDS : u8 = 13;
pub const SEED_GATE_EXIT_AGREE : u8 = 0;
pub const SEED_GATE_EXIT_DISAGREE : u8 = 1;
pub const SEED_GATE_EXIT_UNREADABLE : u8 = 2;

pub fn seed_gate_exit(files_readable: bool, mismatch_count: u16) u8 {
  if (!files_readable) {
    return SEED_GATE_EXIT_UNREADABLE;
  }
  if (mismatch_count > 0) {
    return SEED_GATE_EXIT_DISAGREE;
  }
  return SEED_GATE_EXIT_AGREE;
}

; What it does NOT cover, measured rather than assumed: two contracts declare that their own copy
; of a fleet table is checked by nothing -- availability.t27:103-105 and deposit_tiers.t27:16-18.
; The word is not the count, and saying so is the correction: grep -rn ungated specs/ returns 5 on
; 2026-09-21 -- those two, two invariant NAMES in bot_surface.t27 (:703, :709) about an unrelated
; subject, and this line itself. The 2 below is the number of fleet-table copy declarations read
; one by one; it is not what that grep prints and must not be re-derived from it. Those copies
; belong to their owners; the fact that the gate does not reach them belongs here, because this
; file owns the gate's scope.
pub const SEED_GATE_COVERS_T27_FLEET_TABLES : bool = false;
pub const UNGATED_T27_COPY_DECLARATIONS : u8 = 2;

pub fn seed_gate_covers(is_the_market_block: bool, is_a_t27_fleet_table: bool) bool {
  if (is_a_t27_fleet_table) {
    return false;
  }
  return is_the_market_block;
}

; --- The floor every gate here owes (D16) ---------------------------------------------------------
; D16's rule: a gate whose input can reach zero must assert it found something, because a passing
; test and a vacuous test look identical from the outside. Two gates in this file's scope, and
; they satisfy it differently. The seed gate's floor is implicit but real: the row counts it
; derives from the SQL are compared against totals DECLARED in fleet_seed.json, so a regex that
; matches nothing reports a mismatch instead of passing -- and that holds exactly while the
; declared total is positive, which is the condition D16 is about. The spec gate's floor is
; explicit: scripts/verify_t27_specs.py:175-176 fails on an empty manifest, and :177-184 fails on
; any set difference between the manifest and what rglob discovers, so an unmanifested .t27 file
; cannot ride along unchecked. publication.t27 owns the scanner-side floor of the same shape and
; the compiler-evidence rules; neither is restated here.
pub const SPEC_GATE_MANIFEST_ENTRIES_AT_MEASUREMENT : u8 = 20;
pub const SPEC_GATE_EMPTY_MANIFEST_FAILS : bool = true;
pub const SPEC_GATE_UNMANIFESTED_FILE_FAILS : bool = true;
pub const SEED_GATE_HAS_A_FLOOR : bool = true;
; The manifest named twenty entries when this file was measured and does not name this path, so
; discover_specs reports it as unmanifested and the gate refuses the WHOLE corpus until an entry
; for it is added with its measured declaration and check floors. Contracts landing in the same
; iteration widen that difference, which is why the constant below is dated and the assertions
; pin the refusal rather than a count. Recorded as a false rather than left to be discovered,
; because a contract that claims to be gated while the gate rejects it is the vacuity D16 names.
pub const THIS_FILE_IS_MANIFESTED : bool = false;

pub fn spec_gate_manifest_agrees(manifest_entries: u8, discovered_files: u8) bool {
  if (manifest_entries == 0) {
    return false;
  }
  return manifest_entries == discovered_files;
}

pub fn seed_gate_floor_holds(declared_total: u16) bool {
  return declared_total > 0;
}

pub fn blind_regex_is_detected(rows_matched: u16, declared_total: u16) bool {
  return seed_gate_floor_holds(declared_total) and rows_matched != declared_total;
}

; --- Refusals ---------------------------------------------------------------------------------
pub const SCHEMA_DDL_TRANSCRIBED : bool = false;
pub const MIGRATION_NUMBER_CLAIMED_FOR_UNDONE_WORK : u8 = 0;
pub const CUSTOMER_DATA_FIELDS : u8 = 0;

; --- Tests --------------------------------------------------------------------------------------

test the_sequence_is_gap_free_and_code_agrees_with_disk {
  assert MIGRATION_FILES == 86;
  assert MIGRATION_LINES == 4271;
  assert sequence_is_gap_free(SEQUENCE_FIRST, SEQUENCE_LAST, MIGRATION_FILES) == true;
  assert sequence_is_gap_free(SEQUENCE_FIRST, SEQUENCE_LAST, 85) == false;
  assert sequence_is_gap_free(2, SEQUENCE_LAST, 85) == false;
  assert disk_and_code_agree(MIGRATION_FILES, MIGRATION_ENTRIES_IN_CODE) == true;
}

test the_bike_domain_owns_seventy_seven_onward {
  assert BIKE_DOMAIN_FIRST == 77;
  assert number_is_bike_domain(76) == false;
  assert number_is_bike_domain(77) == true;
  assert number_is_bike_domain(86) == true;
  assert number_is_bike_domain(87) == false;
  assert number_is_taken(86) == true;
  assert number_is_taken(87) == false;
  assert next_free_number(SEQUENCE_LAST) == 87;
}

test an_existing_migration_cannot_be_edited_in_place {
  assert EDIT_IN_PLACE_IS_FORBIDDEN == true;
  assert migration_is_frozen(1) == true;
  assert migration_is_frozen(76) == true;
  assert migration_is_frozen(86) == true;
  assert migration_is_frozen(87) == false;
  assert change_is_expressible(8, false) == false;
  assert change_is_expressible(87, true) == true;
}

test the_wip_collision_is_latent_and_becomes_live_on_promotion {
  assert WIP_CLAIMED_NUMBER == 77;
  assert NUMBERING_WALK_IS_RECURSIVE == false;
  assert MIGRATION_DIRECTORY_READERS == 4;
  assert MIGRATION_DIRECTORY_READER_SITES.len == 4;
  assert MIGRATION_DIRECTORY_READER_SITES[0] == "src/db/mod.rs:1133";
  assert collision_is_live(WIP_CLAIMED_NUMBER, true) == false;
  assert collision_is_live(WIP_CLAIMED_NUMBER, false) == true;
  assert collision_is_live(87, false) == false;
  assert promotion_number_is_safe(87, SEQUENCE_LAST) == true;
  assert promotion_number_is_safe(WIP_CLAIMED_NUMBER, SEQUENCE_LAST) == false;
}

test the_recursive_and_top_level_counts_differ_by_exactly_the_wip_file {
  assert SQL_FILES_TOP_LEVEL == MIGRATION_FILES;
  assert SQL_FILES_RECURSIVE == 87;
  assert recursive_excess(SQL_FILES_RECURSIVE, SQL_FILES_TOP_LEVEL) == 1;
}

test the_wip_file_is_read_by_a_recursive_walk_and_its_number_is_not {
  assert WIP_FILE_IS_READ_BY_SOMETHING == true;
  assert WIP_PREFIX_IS_READ_BY_SOMETHING == false;
  assert RECURSIVE_READER_TESTS == 4;
  assert RECURSIVE_READER_TEST_SITES.len == 4;
  assert walk_sees_the_wip_file(true) == true;
  assert walk_sees_the_wip_file(NUMBERING_WALK_IS_RECURSIVE) == false;
  assert walk_sees_the_collision(true, false) == false;
  assert walk_sees_the_collision(true, true) == true;
  assert walk_sees_the_collision(NUMBERING_WALK_IS_RECURSIVE, true) == false;
}

test the_boot_takes_one_of_three_plans {
  assert run_plan(0, false) == RUN_APPLY_ALL;
  assert run_plan(0, true) == RUN_BACKFILL_THEN_APPLY;
  assert run_plan(76, true) == RUN_APPLY_UNRECORDED;
  assert run_plan(1, false) == RUN_APPLY_UNRECORDED;
}

test the_backfill_stops_short_of_the_list_and_leaves_ten_to_run {
  assert BACKFILL_THROUGH == 76;
  assert MIGRATIONS_AFTER_BOUNDARY == 10;
  assert BACKFILL_THROUGH + MIGRATIONS_AFTER_BOUNDARY == MIGRATION_FILES;
  assert boundary_leaves_work(MIGRATION_FILES, BACKFILL_THROUGH) == true;
  assert boundary_leaves_work(MIGRATION_FILES, MIGRATION_FILES) == false;
  assert backfilled_count(RUN_BACKFILL_THEN_APPLY) == 76;
  assert backfilled_count(RUN_APPLY_ALL) == 0;
  assert applied_after_backfill(RUN_BACKFILL_THEN_APPLY) == 10;
  assert applied_after_backfill(RUN_APPLY_UNRECORDED) == 0;
}

test the_probe_is_wrong_in_two_directions_and_they_are_not_symmetric {
  assert probe_is_correct(true, true) == true;
  assert probe_is_correct(false, false) == true;
  assert probe_error_destroys_data(false, true) == true;
  assert probe_error_destroys_data(true, true) == false;
  assert probe_error_fails_the_boot(true, false) == true;
  assert probe_error_fails_the_boot(false, false) == false;
  assert probe_error_destroys_data(false, true) != probe_error_fails_the_boot(false, true);
}

test every_unreadable_runner_value_resolves_toward_more_work {
  assert RUNNER_DEFAULT_COUNT == 3;
  assert RUNNER_DEFAULT_SITES.len == 3;
  assert run_plan(DEFAULT_TRACKER_ROWS, DEFAULT_PROBE_ESTABLISHED) == RUN_APPLY_ALL;
  assert runner_applies(DEFAULT_MIGRATION_APPLIED) == true;
  assert runner_applies(true) == false;
}

test the_critical_column_list_is_five_tables_and_nineteen_columns {
  assert CRITICAL_TABLES == 5;
  assert CRITICAL_TABLE_NAMES.len == 5;
  assert CRITICAL_COLUMNS_PER_TABLE.len == 5;
  assert critical_column_budget(4, 4, 4, 5, 2) == CRITICAL_COLUMNS_TOTAL;
  assert CRITICAL_COLUMNS_TOTAL == 19;
  assert BIKE_CRITICAL_TABLES == 2;
  assert BIKE_CRITICAL_COLUMNS == 7;
  assert FALSE_ALARM_COLUMNS_NAMED == BIKE_CRITICAL_COLUMNS;
  assert CRITICAL_TABLE_NAMES[3] == "bikes";
  assert CRITICAL_TABLE_NAMES[4] == "bike_units";
}

test a_missing_critical_column_never_stops_the_boot {
  assert MISSING_COLUMN_STOPS_BOOT == false;
  assert MISSING_COLUMN_RAISES_GAUGE == true;
  assert boot_outcome(0) == BOOT_OK;
  assert boot_outcome(7) == BOOT_OK_WITH_WARNINGS;
  assert boot_continues(0) == true;
  assert boot_continues(CRITICAL_COLUMNS_TOTAL) == true;
  assert gauge_value(0) == 0;
  assert gauge_value(7) == 7;
}

test the_two_reads_fail_in_opposite_directions {
  assert RECHECK_DELAY_MS == 500;
  assert FALSE_ALARM_GAP_MS == 11;
  assert settle_source(false, true) == SETTLE_REPORT_EMPTY;
  assert settle_source(false, false) == SETTLE_REPORT_EMPTY;
  assert settle_source(true, false) == SETTLE_REPORT_FIRST_UNCONFIRMED;
  assert settle_source(true, true) == SETTLE_REPORT_SECOND;
  assert settle_is_unconfirmed(true, false) == true;
  assert settle_is_unconfirmed(true, true) == false;
  assert FIRST_READ_FAILURE_ACQUITS == true;
  assert SECOND_READ_FAILURE_ACQUITS == false;
}

test the_later_read_wins_and_that_is_not_an_intersection {
  assert column_is_reported(true, false, true) == false;
  assert column_is_reported(false, true, true) == true;
  assert column_is_reported(true, true, true) == true;
  assert column_is_reported(true, false, false) == true;
  assert column_appeared_between_reads(true, false, true) == true;
  assert column_appeared_between_reads(true, false, false) == false;
  assert intersection_would_hide_a_drop(false, true) == true;
  assert intersection_would_hide_a_drop(true, true) == false;
}

test the_fail_open_census_adds_up_and_spares_the_bike_path {
  assert FAIL_OPEN_MACRO_SITE == "src/db/macros.rs:28-44";
  assert FAIL_OPEN_CALL_SITE_FILES == 3;
  assert FAIL_OPEN_FILES.len == 3;
  assert FAIL_OPEN_SITES_PER_FILE.len == 3;
  assert call_site_census(16, 3, 2) == FAIL_OPEN_CALL_SITES;
  assert FAIL_OPEN_CALL_SITES == 21;
  assert FAIL_OPEN_SITES_ON_BIKE_PATH == 0;
}

test neither_branch_of_the_fail_open_read_is_an_error {
  assert read_outcome(true) == READ_VALUE;
  assert read_outcome(false) == READ_DEFAULT;
  assert read_can_error(true) == false;
  assert read_can_error(false) == false;
  assert drift_evidence_is_only_a_log_line(false) == true;
  assert drift_evidence_is_only_a_log_line(true) == false;
  assert FAIL_OPEN_GATES == 0;
}

test none_of_the_three_mechanisms_leans_the_conservative_way {
  assert MECHANISM_COUNT == 3;
  assert MECHANISM_DIRECTIONS.len == 3;
  assert MECHANISM_DIRECTIONS[0] == DIRECTION_REAPPLY;
  assert MECHANISM_DIRECTIONS[1] == DIRECTION_SERVE;
  assert MECHANISM_DIRECTIONS[2] == DIRECTION_SERVE;
  assert direction_is_conservative(DIRECTION_REFUSE) == true;
  assert direction_is_conservative(DIRECTION_SERVE) == false;
  assert direction_is_conservative(DIRECTION_REAPPLY) == false;
  assert direction_writes_to_a_live_database(DIRECTION_REAPPLY) == true;
  assert direction_reaches_the_asker(DIRECTION_SERVE) == true;
  assert CONSERVATIVE_MECHANISMS == 0;
}

test the_seed_gate_has_three_distinct_exits {
  assert seed_gate_exit(true, 0) == SEED_GATE_EXIT_AGREE;
  assert seed_gate_exit(true, 1) == SEED_GATE_EXIT_DISAGREE;
  assert seed_gate_exit(false, 0) == SEED_GATE_EXIT_UNREADABLE;
  assert SEED_GATE_EXIT_AGREE != SEED_GATE_EXIT_DISAGREE;
  assert SEED_GATE_EXIT_DISAGREE != SEED_GATE_EXIT_UNREADABLE;
}

test the_seed_gate_reads_exactly_one_spec_and_gates_only_the_market_block {
  assert SEED_GATE_SPEC_FILES_READ == 1;
  assert SEED_GATE_SPEC_READ == "specs/turbobaby/market_profile.t27";
  assert SEED_GATE_MARKET_FIELDS == 13;
  assert seed_gate_covers(true, false) == true;
  assert seed_gate_covers(false, true) == false;
  assert seed_gate_covers(true, true) == false;
  assert SEED_GATE_COVERS_T27_FLEET_TABLES == false;
  assert UNGATED_T27_COPY_DECLARATIONS == 2;
}

test a_gate_whose_input_reaches_zero_is_refused {
  assert spec_gate_manifest_agrees(0, 0) == false;
  assert spec_gate_manifest_agrees(20, 21) == false;
  assert spec_gate_manifest_agrees(21, 21) == true;
  assert SPEC_GATE_EMPTY_MANIFEST_FAILS == true;
  assert SPEC_GATE_UNMANIFESTED_FILE_FAILS == true;
  assert THIS_FILE_IS_MANIFESTED == false;
  assert seed_gate_floor_holds(0) == false;
  assert blind_regex_is_detected(0, 14) == true;
  assert blind_regex_is_detected(14, 14) == false;
  assert blind_regex_is_detected(0, 0) == false;
  assert SEED_GATE_HAS_A_FLOOR == true;
}

test the_reuse_edges_point_outward_and_nowhere_twice {
  assert REUSES_MARKET_ID == "turbobaby/market";
  assert REUSES_AVAILABILITY_ID == "turbobaby/availability";
  assert REUSES_CATALOG_ID == "turbobaby/bike-catalog";
  assert REUSES_PRICING_HONESTY_ID == "turbobaby/pricing-honesty";
  assert REUSES_PUBLICATION_ID == "turbobaby/publication";
  assert REUSES_MARKET_ID != ID;
  assert REUSES_AVAILABILITY_ID != ID;
  assert REUSES_CATALOG_ID != ID;
  assert REUSES_PRICING_HONESTY_ID != ID;
  assert REUSES_PUBLICATION_ID != ID;
  assert REUSES_MARKET_ID != REUSES_AVAILABILITY_ID;
  assert REUSES_AVAILABILITY_ID != REUSES_CATALOG_ID;
  assert REUSES_CATALOG_ID != REUSES_PRICING_HONESTY_ID;
  assert REUSES_PRICING_HONESTY_ID != REUSES_PUBLICATION_ID;
}

test this_file_transcribes_no_schema_and_reserves_no_number {
  assert SCHEMA_DDL_TRANSCRIBED == false;
  assert MIGRATION_NUMBER_CLAIMED_FOR_UNDONE_WORK == 0;
  assert CUSTOMER_DATA_FIELDS == 0;
  assert ID == "turbobaby/schema-provenance";
  assert KIND == "schema-provenance-contract";
  assert MEASURED_AT == "2026-09-21";
}

; --- Invariants ----------------------------------------------------------------------------------

invariant the_numbering_admits_no_gap_and_no_reservation
  assert sequence_is_gap_free(SEQUENCE_FIRST, SEQUENCE_LAST, MIGRATION_FILES) == true and next_free_number(SEQUENCE_LAST) == 87

invariant code_and_disk_carry_the_same_migration_count
  assert disk_and_code_agree(MIGRATION_FILES, MIGRATION_ENTRIES_IN_CODE) == true

invariant an_applied_migration_is_frozen_and_only_a_new_file_expresses_a_change
  assert change_is_expressible(SEQUENCE_LAST, false) == false and change_is_expressible(next_free_number(SEQUENCE_LAST), true) == true

invariant the_wip_number_is_taken_and_a_promotion_must_renumber
  assert number_is_taken(WIP_CLAIMED_NUMBER) == true and collision_is_live(WIP_CLAIMED_NUMBER, false) == true and promotion_number_is_safe(WIP_CLAIMED_NUMBER, SEQUENCE_LAST) == false

invariant the_subdirectory_hides_the_collision_only_while_the_walk_is_shallow
  assert NUMBERING_WALK_IS_RECURSIVE == false and collision_is_live(WIP_CLAIMED_NUMBER, true) == false

invariant the_wip_file_is_hidden_from_the_prefix_and_not_from_every_reader
  assert walk_sees_the_wip_file(true) == true and walk_sees_the_collision(true, WIP_PREFIX_IS_READ_BY_SOMETHING) == false and WIP_FILE_IS_READ_BY_SOMETHING == true

invariant a_probe_that_says_fresh_about_an_established_database_is_the_destructive_direction
  assert probe_error_destroys_data(false, true) == true and probe_error_fails_the_boot(false, true) == false

invariant the_default_on_an_unreadable_probe_is_the_destructive_direction
  assert run_plan(DEFAULT_TRACKER_ROWS, DEFAULT_PROBE_ESTABLISHED) == RUN_APPLY_ALL and probe_error_destroys_data(DEFAULT_PROBE_ESTABLISHED, true) == true

invariant an_unreadable_applied_flag_re_applies_the_migration
  assert runner_applies(DEFAULT_MIGRATION_APPLIED) == true

invariant the_backfill_never_swallows_the_whole_list
  assert boundary_leaves_work(MIGRATION_FILES, BACKFILL_THROUGH) == true and BACKFILL_THROUGH + MIGRATIONS_AFTER_BOUNDARY == MIGRATION_FILES

invariant the_critical_column_count_is_the_sum_of_its_tables
  assert critical_column_budget(4, 4, 4, 5, 2) == CRITICAL_COLUMNS_TOTAL and CRITICAL_TABLE_NAMES.len == CRITICAL_TABLES

invariant no_column_absence_is_fatal_and_this_file_never_says_otherwise
  assert MISSING_COLUMN_STOPS_BOOT == false and boot_continues(CRITICAL_COLUMNS_TOTAL) == true

invariant a_failed_confirming_read_clears_nothing
  assert column_is_reported(true, false, false) == true and settle_is_unconfirmed(true, false) == true

invariant a_column_that_vanished_between_two_reads_is_reported
  assert column_is_reported(false, true, true) == true and intersection_would_hide_a_drop(false, true) == true

invariant a_column_that_appeared_between_two_reads_is_not_reported
  assert column_is_reported(true, false, true) == false and column_appeared_between_reads(true, false, true) == true

invariant the_fail_open_read_has_no_error_branch
  assert read_can_error(true) == false and read_can_error(false) == false

invariant the_fail_open_census_is_a_sum_and_not_an_estimate
  assert call_site_census(16, 3, 2) == FAIL_OPEN_CALL_SITES and FAIL_OPEN_SITES_ON_BIKE_PATH == 0

invariant the_fail_open_construct_is_guarded_by_nothing
  assert FAIL_OPEN_GATES == 0

invariant not_one_of_the_three_mechanisms_defaults_conservatively
  assert direction_is_conservative(MECHANISM_DIRECTIONS[0]) == false and direction_is_conservative(MECHANISM_DIRECTIONS[1]) == false and direction_is_conservative(MECHANISM_DIRECTIONS[2]) == false and CONSERVATIVE_MECHANISMS == 0

invariant the_seed_gate_separates_disagreement_from_unreadability
  assert seed_gate_exit(false, 0) != seed_gate_exit(true, 0) and seed_gate_exit(true, 1) != seed_gate_exit(true, 0)

invariant the_seed_gate_reaches_the_market_block_and_no_t27_fleet_table
  assert seed_gate_covers(true, false) == true and seed_gate_covers(false, true) == false and SEED_GATE_COVERS_T27_FLEET_TABLES == false

invariant an_empty_corpus_cannot_pass_the_spec_gate
  assert spec_gate_manifest_agrees(0, 0) == false

invariant an_unmanifested_spec_cannot_ride_along
  assert spec_gate_manifest_agrees(SPEC_GATE_MANIFEST_ENTRIES_AT_MEASUREMENT, SPEC_GATE_MANIFEST_ENTRIES_AT_MEASUREMENT + 1) == false and THIS_FILE_IS_MANIFESTED == false

invariant a_blind_regex_is_caught_only_while_the_declared_total_is_positive
  assert blind_regex_is_detected(0, 14) == true and blind_regex_is_detected(0, 0) == false

invariant this_file_restates_no_siblings_decision
  assert REUSES_MARKET_ID != ID and REUSES_AVAILABILITY_ID != ID and REUSES_CATALOG_ID != ID and REUSES_PRICING_HONESTY_ID != ID and REUSES_PUBLICATION_ID != ID

invariant no_schema_and_no_customer_data_enters_this_contract
  assert SCHEMA_DDL_TRANSCRIBED == false and CUSTOMER_DATA_FIELDS == 0 and MIGRATION_NUMBER_CLAIMED_FOR_UNDONE_WORK == 0
