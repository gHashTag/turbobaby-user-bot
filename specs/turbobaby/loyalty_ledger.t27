// SPDX-License-Identifier: Apache-2.0
; specs/turbobaby/loyalty_ledger.t27 -- the STRUCTURE of the bonus ledger, and what it cannot prove
; This contract owns the shape of the two routes that move bonus money against an account, the
; thing that makes two of their requests one request, the arithmetic that bounds a debit, and the
; append-only ledger those writes are supposed to reconstruct. It owns no rate: no tier, no
; cashback percent, no usage ceiling and no expiry period appears below, and the two reasons for
; that are different and are both recorded. It owns no customer. Every number traces to a line in
; this repository and carries it.
; --
; WHY (measured 2026-09-21). Two separate structures are load-bearing and neither holds.
; 1. THE LEDGER DOES NOT SUM TO THE BALANCE. src/db/entities/bonus_transaction.rs:1-2 calls
;    bonus_transactions the "append-only ledger of every bonus credit / debit", and
;    src/api/loyalty.rs:530-531 writes the equation out: the sum of one account's amounts equals
;    its stored balance. Cycle #161 added the missing debit row to make it true again. It is not
;    true. Ten statements in src/ perform arithmetic on loyalty_profiles.bonus_balance; SIX pair
;    with a ledger insert (src/api/loyalty.rs:353 behind :342, src/api/loyalty.rs:508 behind :554,
;    src/db/orders.rs:356 behind :351, src/db/referrals.rs:429 behind :419, :489 behind :481, and
;    :855 behind :847) and FOUR do not (src/api/orders.rs:1292 debits at checkout,
;    src/api/orders.rs:2013 refunds on reject, src/api/orders.rs:2247 refunds on cancel, and
;    src/bot/callbacks.rs:760 refunds on reject from the bot, all four with zero occurrences of
;    BonusTx or bonus_transaction as a WRITE in their modules -- src/api/orders.rs holds exactly
;    one mention, the read-only import at :16 used at :1836-1838, and src/bot/callbacks.rs holds
;    none). The audit trail is therefore missing the single largest category of movement, the
;    spend, and every refund of it.
; 2. A KEY STRING IS THE WHOLE IDENTITY OF A REQUEST. Replay protection is opt-in: the header is
;    read at src/api/loyalty.rs:238-242 and :430-434 and a missing one is simply absent, which
;    tests/integration_idempotency_negative.rs:161-176 pins as intended. When present, the lookup
;    is find_by_id(key) at :290 and :484 and nothing else is compared -- not the account, though
;    the row carries it (migrations/033_loyalty_idempotency_keys.sql:21), not the amount, not the
;    direction, not the route. The table has four columns and none of them is a payload digest
;    (a grep of that migration for payload, digest or hash returns 0, and for route, direction,
;    kind or op returns 0). So one namespace serves a credit route and a debit route and every
;    account at once: present a key the table has seen and the answer is the first request's
;    receipt with success true, whatever the body asked for and whoever it asked it about.
;    The namespace is also permanent. src/main.rs:580, :589 and :598 are the three TTL sweeps this
;    process runs, over order_idempotency_keys (24 h, src/main.rs:581), order_fraud_events and
;    block_history; DELETE FROM loyalty_idempotency_keys returns 0 occurrences across .rs and
;    .sql. The created_at index at migrations/033_loyalty_idempotency_keys.sql:25-26 was built for
;    a sweep that does not exist, exactly as its template said at
;    migrations/029_order_idempotency_keys.sql:19-20 -- with the difference that the order table's
;    sweep was later written and this one was not.
; --
; WHERE THE BRIEF IS REFUTED. Three readings, each checked against the line it cites.
; 1. "No tier, no cashback percentage and no usage cap may be declared here: they have no
;    published source." The measurement behind that is real and I re-ran it: data/fleet_seed.json
;    (19434 bytes) holds 0 occurrences of loyalty, 0 of bonus and 0 of cashback, case-insensitive.
;    The inference does not follow, and the corpus had already refuted it -- order_money.t27:33-38
;    and its BONUS_POLICY_NOTE at :272 name src/trios/loyalty.rs:34-46 as the standing default
;    block and src/trios/loyalty.rs:86-92 as the clamp over it. So that zero, and what it does and
;    does not prove, has an owner (SEED_MEASUREMENT_OWNER_ID) and is not re-measured into a
;    constant here. This file refuses the rates for a different and narrower reason: it owns
;    structure, the rates have a source, and copying them would be the second table the corpus
;    exists to prevent. The expiry period is the one that really is missing, and it gets the
;    named refusal below.
; 2. "src/db/entities/loyalty_idempotency_key.rs ... the replay-protection shape", cited as if the
;    entity described its own wiring. Its doc comment at :10-13 says "Phase 2 (next cycle) wires
;    this into add_bonus / use_bonus" and "this entity is intentionally unreferenced -- see the
;    loyalty_idempotency_key entry in ALLOWED_UNWIRED_ENTITIES". Both halves are stale. The entity
;    is imported and used at src/api/loyalty.rs:262 and :458, and ALLOWED_UNWIRED_ENTITIES at
;    src/db/mod.rs:1929-1951 lists exactly two names, quest_place and event_photo. A reader who
;    trusted that comment would contract for protection that is wired, or skip the file believing
;    nothing runs. migrations/033_loyalty_idempotency_keys.sql:1 is stale in the same way: it names
;    the route add-bonus, and the registration at src/api/loyalty.rs:25 is /bonus.
; 3. "the routes (survey: :23-33, seven of them)". The span is right and the count is two counts
;    collapsed. src/api/loyalty.rs:21-34 registers EIGHT routes over SEVEN distinct paths --
;    /loyalty/config appears twice, GET at :32 and POST at :33. Both numbers are declared, because
;    a contract that carries one of them cannot check the gate distribution against either.
; --
; WHAT THIS FILE NEVER DOES. It declares no tier threshold, no cashback percent, no bonus usage
; ceiling and no expiry period. It states no term of the order total: the identity
; total == subtotal - bonus - stars, its floor and its one-minor-unit tolerance are
; order_money.t27's, and the bonus reaches that identity from here as an already-decided amount.
; It publishes no exchange rate and converts nothing -- that prohibition is market_profile.t27's.
; It does not restate commerce.t27's five-way idempotency vocabulary; it consumes the verdict as
; booleans and owns only which of those verdicts this table can physically produce. It does not
; restate request_identity.t27's proof of who is asking; it records only which gate stands on the
; two money routes, which that owner explicitly does not carry
; (request_identity.t27:239, ENDPOINT_TO_GATE_MAP_IS_NOT_OWNED_HERE). It declares no per-window
; ceiling of its own -- star_award.t27 owns the one capped non-purchase credit in this system and
; is named as the precedent, not copied. It carries no leaderboard content, no rank and no row: the
; board at src/api/loyalty.rs:31 is named as a route and nothing of it is reproduced. It names no
; renter, handle, phone, key code, plate, debt, purchase price or personal note in any constant,
; fixture or comment, and no account id is written down anywhere below -- only compared. Shipped
; Cyrillic strings in the cited sources are referred to by path and never quoted.
; phi^2 + 1/phi^2 = 3 | TRINITY

module turbobaby-loyalty-ledger;

pub const KIND : str = "contract";
pub const ID : str = "turbobaby/loyalty-ledger";
pub const NAME : str = "TurboBaby bonus ledger structure";
pub const WORLD : str = "gHashTag/turbobaby-user-bot";
pub const MEASURED_AT : str = "2026-09-21";

; Where each rule below is implemented.
pub const ROUTE_IMPLEMENTATION : str = "src/api/loyalty.rs";
pub const LEDGER_ENTITY : str = "src/db/entities/bonus_transaction.rs";
pub const KEY_ENTITY : str = "src/db/entities/loyalty_idempotency_key.rs";
pub const KEY_MIGRATION : str = "migrations/033_loyalty_idempotency_keys.sql";
pub const BALANCE_MIGRATION : str = "migrations/001_initial.sql";
pub const POLICY_IMPLEMENTATION : str = "src/trios/loyalty.rs";
pub const REGRESSION_WITNESS : str = "tests/integration_idempotency_negative.rs";

; --- Reuse edges, named because there are no imports ---------------------------------------------
; A brace import lowers to an empty UseDecl under the pinned compiler and is rejected, so a
; cross-contract dependency is a string that a test pins to its literal. Each line is a decision
; this file consumes whole and deliberately does not restate.
;
;   order-money      owns the identity the bonus is a TERM of, and what a star is worth when spent.
;                    This file owns where the bonus comes from and what bounds it; it writes no
;                    total and takes no subtotal. That owner also owns the fleet-seed measurement
;                    and the finding that a seed zero does not make the rates unowned.
;   star-award       owns the other non-purchase credit and is the corpus precedent for a capped
;                    source: a per-source, per-window ceiling that TRIMS rather than refuses. This
;                    ledger has no equivalent, which is a fact about this file, not about that one.
;                    No number of that ceiling appears here.
;   commerce         owns the idempotency decision vocabulary and the rule that the record becomes
;                    durable in the same successful transaction. Consumed as booleans.
;   request-identity owns the gate names and what a failed proof means. Consumed as a gate id.
;   market           owns the minor-digit count. Every amount below is an integer in minor units
;                    and the scale arrives as an argument, never as a constant here.
pub const REUSES_ORDER_MONEY_ID : str = "turbobaby/order-money";
pub const REUSES_STAR_AWARD_ID : str = "turbobaby/star-award";
pub const REUSES_COMMERCE_ID : str = "turbobaby/commerce";
pub const REUSES_REQUEST_IDENTITY_ID : str = "turbobaby/request-identity";
pub const REUSES_MARKET_PROFILE_ID : str = "turbobaby/market";
pub const REUSE_EDGE_COUNT : u8 = 5;
pub const REUSE_EDGES : [5]str = [
  "turbobaby/order-money",
  "turbobaby/star-award",
  "turbobaby/commerce",
  "turbobaby/request-identity",
  "turbobaby/market",
];
pub const RESTATES_THE_COMMERCE_DECISION_SET : bool = false;
pub const DECLARES_AN_EXCHANGE_RATE : bool = false;
; request_identity.t27:92 declares CONSUMER_COUNT 8 and :94-103 the closed CONSUMERS array, measured on
; 2026-09-20. This file is a ninth consumer and is not in that snapshot; the edge is declared here,
; from this side, which is the half of the pattern a new file can honestly supply.
pub const NAMED_IN_THE_IDENTITY_CONSUMER_SNAPSHOT : bool = false;

; --- Who may move the money ----------------------------------------------------------------------
; src/api/loyalty.rs:21-34. Eight registrations over seven paths, and the gate is not uniform:
; three carry none (:23 tiers, :31 leaderboard, :32 config read), two carry the owner gate
; (:24 profile via src/api/loyalty.rs:87, :27-30 bonus history via :605), and three carry the admin
; gate (:25 via :230, :26 via :418, :33 via :742).
pub const ROUTE_REGISTRATION_COUNT : u8 = 8;
pub const DISTINCT_PATH_COUNT : u8 = 7;
pub const UNGATED_ROUTE_COUNT : u8 = 3;
pub const OWNER_GATED_ROUTE_COUNT : u8 = 2;
pub const ADMIN_GATED_ROUTE_COUNT : u8 = 3;

pub const GATE_NONE : u8 = 0;
pub const GATE_OWNER : u8 = 1;
pub const GATE_ADMIN : u8 = 2;

; The two routes that move money against an account, and the one gate both of them stand behind.
pub const MONEY_ROUTE_COUNT : u8 = 2;
pub const MONEY_ROUTES : [2]str = [
  "POST /loyalty/:telegram_id/bonus",
  "POST /loyalty/:telegram_id/use-bonus",
];
pub const MONEY_ROUTE_GATE : u8 = GATE_ADMIN;
; This is the sentence the path spelling hides. On the two money routes the id in the path is the
; SUBJECT whose balance moves; the caller is whoever passed check_admin, and the two are never
; compared. src/api/loyalty.rs:229-230 and :417-418 run validate_telegram_id_param on the path id
; and then check_admin on the headers -- there is no check_owner anywhere on either route, while
; the two READ routes over the same account (:87, :605) do carry it.
pub const PATH_SUBJECT_IS_THE_CALLER : bool = false;

pub fn subject_is_proven_to_be_the_caller(gate: u8) bool {
  return gate == GATE_OWNER;
}

pub fn a_third_party_may_move_this_balance(gate: u8) bool {
  return gate == GATE_ADMIN;
}

; --- What makes two credits the same credit --------------------------------------------------------
; src/api/loyalty.rs:238-247 and :430-439. The header is optional and its syntax is borrowed whole
; from the order module: crate::api::orders::is_valid_idempotency_key at src/api/orders.rs:413-418
; admits a non-empty string of at most 100 ASCII alphanumerics, hyphen and underscore.
pub const IDEMPOTENCY_HEADER : str = "x-idempotency-key";
pub const IDEMPOTENCY_HEADER_IS_REQUIRED : bool = false;
pub const KEY_SYNTAX_VALIDATOR : str = "src/api/orders.rs:413";
pub const KEY_MAX_LEN : u16 = 100;

pub fn key_syntax_is_legal(length: u16, chars_are_key_safe: bool) bool {
  return length >= 1 and length <= KEY_MAX_LEN and chars_are_key_safe;
}

pub fn write_is_replay_protected(key_present: bool) bool {
  return key_present;
}

; migrations/033_loyalty_idempotency_keys.sql:18-23. Four columns, key alone is the primary key.
pub const KEY_TABLE : str = "loyalty_idempotency_keys";
pub const KEY_COLUMN_COUNT : u8 = 4;
pub const KEY_COLUMNS : [4]str = ["key", "tx_id", "telegram_id", "created_at"];
pub const KEY_IS_THE_WHOLE_PRIMARY_KEY : bool = true;
; Measured over that migration: 0 for payload, digest or hash; 0 for route, direction, kind or op.
pub const KEY_TABLE_STORES_A_PAYLOAD_DIGEST : bool = false;
pub const KEY_TABLE_STORES_A_ROUTE_DISCRIMINATOR : bool = false;
; src/api/loyalty.rs:290 and :484 are find_by_id(key) with no second filter, and :297-308 / :491-502
; return row.tx_id without reading row.telegram_id at all.
pub const REPLAY_COMPARES_THE_SUBJECT : bool = false;
pub const REPLAY_COMPARES_THE_AMOUNT : bool = false;
pub const REPLAY_COMPARES_THE_DIRECTION : bool = false;

pub fn replay_is_answered_from_the_key_alone(key_seen: bool) bool {
  return key_seen;
}

pub fn a_differing_payload_is_detected(key_seen: bool, stores_payload_digest: bool) bool {
  return key_seen and stores_payload_digest;
}

; commerce.t27 owns the five-way verdict set. What this file owns is which of those verdicts this
; table can physically reach. CONFLICT needs a payload to disagree with and there is none stored.
; IN_PROGRESS needs a key row whose prior did not commit, and the key row is inserted inside the
; money transaction on the happy path only (src/api/loyalty.rs:375-394, :561-580); the refused
; debit at :518-524 rolls the whole transaction back, which
; tests/integration_idempotency_negative.rs:122-156 pins by asserting the table stays empty.
pub const KEY_ROW_IS_WRITTEN_INSIDE_THE_MONEY_TRANSACTION : bool = true;
pub const COMMERCE_CONFLICT_VERDICT_IS_REACHABLE_HERE : bool = false;
pub const COMMERCE_IN_PROGRESS_VERDICT_IS_REACHABLE_HERE : bool = false;

pub fn key_row_implies_a_committed_prior(written_inside_the_money_tx: bool) bool {
  return written_inside_the_money_tx;
}

pub fn key_row_is_written(key_present: bool, transaction_committed: bool) bool {
  return key_present and transaction_committed;
}

; One namespace, two directions, every account. Mutual exclusion between concurrent holders of the
; same key is the advisory lock at src/api/loyalty.rs:280-284 and :474-478, which serialises them
; but does not distinguish them.
pub const DIRECTION_NONE : u8 = 0;
pub const DIRECTION_CREDIT : u8 = 1;
pub const DIRECTION_DEBIT : u8 = 2;
pub const KEY_NAMESPACE_IS_SHARED_ACROSS_DIRECTIONS : bool = true;
pub const KEY_NAMESPACE_IS_SHARED_ACROSS_ACCOUNTS : bool = true;

pub fn a_key_minted_for_one_direction_replays_on_the_other(first_direction: u8, second_direction: u8, key_seen: bool) bool {
  if (!key_seen) {
    return false;
  }
  if (!KEY_NAMESPACE_IS_SHARED_ACROSS_DIRECTIONS) {
    return false;
  }
  return first_direction != second_direction;
}

; --- The arithmetic ---------------------------------------------------------------------------------
; Amounts are integers in minor units. The shipped columns are not: migrations/001_initial.sql:14
; declares bonus_balance DOUBLE PRECISION NOT NULL DEFAULT 0 and
; src/db/entities/bonus_transaction.rs:8 declares amount DOUBLE PRECISION and :24 carries it as an
; f64, so the live pair is two binary floats. A contract that re-enacted the float would inherit
; its undecidable boundary, so the model here is exact and the float is recorded as a property of
; the storage instead.
pub const LEDGER_AMOUNT_COLUMN_TYPE : str = "DOUBLE PRECISION";
pub const LEDGER_AMOUNT_COLUMN_IS_A_BINARY_FLOAT : bool = true;
pub const BALANCE_COLUMN_IS_A_BINARY_FLOAT : bool = true;
; migrations/001_initial.sql:14 carries no CHECK constraint, so a non-negative balance is an
; application promise kept by the two guards below and by nothing in the schema.
pub const SCHEMA_ENFORCES_NO_BALANCE_FLOOR : bool = true;
pub const BALANCE_FLOOR_MINOR : i64 = 0;

; src/api/loyalty.rs:201 -- one ceiling in MAJOR units, shared by both routes: the credit gate at
; :217 and the debit gate at :405 name the same constant. The reason recorded at :193-200 is the
; extra-zeros typo, not a policy about what a customer may hold.
pub const GRANT_CEILING_MAJOR_UNITS : i64 = 1000000;

pub fn grant_ceiling_minor(minor_unit_scale: i64) i64 {
  return GRANT_CEILING_MAJOR_UNITS * minor_unit_scale;
}

; src/api/loyalty.rs:217: not finite, or below zero, or above the ceiling -> 400. Zero passes.
pub fn credit_is_admitted(amount_minor: i64, amount_is_finite: bool, ceiling_minor: i64) bool {
  if (!amount_is_finite) {
    return false;
  }
  if (amount_minor < 0) {
    return false;
  }
  return amount_minor <= ceiling_minor;
}

; src/api/loyalty.rs:405 refuses at or below zero, and src/api/loyalty.rs:511 adds the balance
; guard to the same UPDATE. The check against the balance is therefore atomic with the deduction:
; one statement filters bonus_balance >= amount and writes the difference, and a concurrent caller
; that drained the row leaves rows_affected 0 and the 400 at :518-523.
pub fn debit_is_admitted(amount_minor: i64, amount_is_finite: bool, ceiling_minor: i64, balance_minor: i64) bool {
  if (!amount_is_finite) {
    return false;
  }
  if (amount_minor <= 0) {
    return false;
  }
  if (amount_minor > ceiling_minor) {
    return false;
  }
  return balance_minor >= amount_minor;
}

; The asymmetry is real and is in two adjacent lines: :217 rejects amount < 0.0 and :405 rejects
; amount <= 0.0. A zero-amount credit is admitted, writes a ledger row and moves nothing; a
; zero-amount debit is a 400.
pub const ZERO_IS_ADMITTED_AS_A_CREDIT : bool = true;
pub const ZERO_IS_ADMITTED_AS_A_DEBIT : bool = false;

pub fn zero_amount_is_admitted(direction: u8, ceiling_minor: i64) bool {
  if (direction == DIRECTION_CREDIT) {
    return credit_is_admitted(0, true, ceiling_minor);
  }
  return debit_is_admitted(0, true, ceiling_minor, 0);
}

pub fn balance_after_credit(balance_minor: i64, amount_minor: i64, amount_is_finite: bool, ceiling_minor: i64) i64 {
  if (!credit_is_admitted(amount_minor, amount_is_finite, ceiling_minor)) {
    return balance_minor;
  }
  return balance_minor + amount_minor;
}

pub fn balance_after_debit(balance_minor: i64, amount_minor: i64, amount_is_finite: bool, ceiling_minor: i64) i64 {
  if (!debit_is_admitted(amount_minor, amount_is_finite, ceiling_minor, balance_minor)) {
    return balance_minor;
  }
  return balance_minor - amount_minor;
}

; src/api/loyalty.rs:508 wraps the subtraction in GREATEST(0, ...) and :511 filters on the balance.
; Both survive in the shipped statement and only one of them is load-bearing: a row the filter
; admits cannot produce a negative difference, so the clamp is unreachable while the guard stands.
; Naming which is which matters because deleting the guard as redundant would leave a clamp that
; silently turns an overdraft into a zero balance instead of a refusal.
pub const GUARD_IS_PRESENT : bool = true;

pub fn clamp_would_fire(balance_minor: i64, amount_minor: i64) bool {
  return balance_minor < amount_minor;
}

pub fn clamp_fires_under_the_guard(balance_minor: i64, amount_minor: i64, guard_present: bool) bool {
  if (guard_present) {
    return false;
  }
  return clamp_would_fire(balance_minor, amount_minor);
}

; The ceiling bounds ONE grant, not the balance. src/api/loyalty.rs:353 is an unbounded
; bonus_balance + $1 with no upper test anywhere in the handler, and no rate limit stands on the
; route -- src/api/orders.rs:1270-1285 shows what one looks like on the checkout path and
; src/api/loyalty.rs:223-231 has no equivalent. star_award.t27 owns the only capped non-purchase
; credit in this system; this ledger has no per-window ceiling of any size.
pub const BALANCE_HAS_NO_CEILING : bool = true;
pub const THIS_LEDGER_HAS_A_PER_WINDOW_CEILING : bool = false;
pub const THE_OTHER_NON_PURCHASE_CREDIT_HAS_ONE : bool = true;

; --- The ledger row and the equation it is supposed to satisfy -------------------------------------
pub const LEDGER_TABLE : str = "bonus_transactions";
pub const LEDGER_ROW_COLUMN_COUNT : u8 = 7;
pub const LEDGER_ROW_COLUMNS : [7]str = [
  "id",
  "telegram_id",
  "amount",
  "tx_type",
  "description",
  "related_order_id",
  "created_at",
];
; src/db/entities/bonus_transaction.rs:8. Sign is the direction; there is no direction column.
pub const LEDGER_SIGN_CONVENTION : str = "positive is a credit, negative is a debit";

pub fn direction_of(ledger_amount_minor: i64) u8 {
  if (ledger_amount_minor > 0) {
    return DIRECTION_CREDIT;
  }
  if (ledger_amount_minor < 0) {
    return DIRECTION_DEBIT;
  }
  return DIRECTION_NONE;
}

; The category column has no closed vocabulary on the credit route: src/api/loyalty.rs:16 takes
; tx_type from the request body and :204-206 checks only that it is at most 50 characters, so an
; empty string and any novel spelling both pass. The debit route hardcodes one value at :549.
pub const TX_TYPE_MAX_LEN : u16 = 50;
pub const TX_TYPE_IS_CALLER_SUPPLIED_ON_A_CREDIT : bool = true;
pub const TX_TYPE_VOCABULARY_IS_CLOSED : bool = false;
pub const DEBIT_TX_TYPE : str = "admin_deduction";

pub fn tx_type_is_legal(length: u16) bool {
  return length <= TX_TYPE_MAX_LEN;
}

; The equation and the four statements that break it. The count is of arithmetic writes to
; loyalty_profiles.bonus_balance in src/, excluding the seeding writes that set a fresh row to zero.
pub const BOOKKEEPING_EQUATION : str = "the sum of one account's bonus_transactions.amount equals its loyalty_profiles.bonus_balance";
pub const BALANCE_WRITE_SITE_COUNT : u8 = 10;
pub const BALANCE_WRITES_WITH_A_LEDGER_ROW : u8 = 6;
pub const BALANCE_WRITES_WITHOUT_A_LEDGER_ROW : u8 = 4;
pub const LEDGER_BYPASS_SITES : [4]str = [
  "src/api/orders.rs:1292",
  "src/api/orders.rs:2013",
  "src/api/orders.rs:2247",
  "src/bot/callbacks.rs:760",
];
pub const THE_LEDGER_SUMS_TO_THE_BALANCE_TODAY : bool = false;

pub fn ledger_sums_to_the_balance(bypass_site_count: u8) bool {
  return bypass_site_count == 0;
}

; --- The key namespace is never pruned ---------------------------------------------------------------
pub const KEY_TABLE_CREATED_AT_IS_INDEXED : bool = true;
pub const TTL_SWEEP_COUNT : u8 = 3;
pub const SWEPT_TABLES : [3]str = [
  "order_idempotency_keys",
  "order_fraud_events",
  "block_history",
];
pub const ORDER_KEY_RETENTION_HOURS : u16 = 24;
pub const LOYALTY_KEY_TABLE_IS_SWEPT : bool = false;
pub const LOYALTY_KEY_DELETE_STATEMENT_COUNT : u8 = 0;

pub fn key_namespace_is_bounded(table_is_swept: bool) bool {
  return table_is_swept;
}

pub fn key_is_permanent(table_is_swept: bool) bool {
  return !table_is_swept;
}

; --- The refusals ---------------------------------------------------------------------------------
; Two refusals with two different reasons, kept apart because collapsing them would state a
; falsehood in one direction or the other.
pub const DECLARES_A_TIER_TABLE : bool = false;
pub const DECLARES_A_CASHBACK_PERCENT : bool = false;
pub const DECLARES_A_USAGE_CEILING : bool = false;
pub const RATE_SOURCE : str = "src/trios/loyalty.rs";
pub const SEED_MEASUREMENT_OWNER_ID : str = "turbobaby/order-money";
pub const RATE_REFUSAL_NOTE : str = "Refused for want of ownership, not for want of a source. The rates exist and are published in code: src/trios/loyalty.rs:34-46 is the standing default block for the loyalty_config JSONB row, src/trios/loyalty.rs:57-60 reads one key through it and treats a non-finite stored value as absent, src/trios/loyalty.rs:63-65 answers with no stored config in play, src/trios/loyalty.rs:71-78 maps a tier name to its key and falls unrecognised names to the progressive schedule, and src/trios/loyalty.rs:86-92 clamps a stored ceiling into the legal percentage range or returns the default. src/trios/loyalty.rs:1-24 records why they are there at all: four hand-written copies that could not see each other, one of which shipped a screen promising one figure against a configured other. The seed measurement often quoted as proof that these are unowned is real and re-run on 2026-09-21 -- data/fleet_seed.json, 19434 bytes, holds 0 occurrences of loyalty, 0 of bonus and 0 of cashback -- but it proves only that the seed does not carry them, and that finding already has an owner in this corpus: turbobaby/order-money. This file therefore names the source and declares no number, because a rate restated beside a structure is the second table the corpus exists to prevent.";
; The one that really is absent.
pub const DECLARES_AN_EXPIRY_PERIOD : bool = false;
pub const BONUS_EXPIRY_NAME_OCCURRENCES : u8 = 0;
pub const BONUS_EXPIRY_IS_PUBLISHED_ANYWHERE : bool = false;
pub const EXPIRY_REFUSAL_NOTE : str = "Measured 2026-09-21 and absent: bonus_expir, bonus_ttl, bonus_valid_until and bonus_expires return 0 occurrences across src/ and migrations/, and no expires_at column stands on bonus_transactions or loyalty_profiles -- the only expires_at columns in migrations/ belong to garden_rewards (004_garden.sql:36, indexed again at 065_garden_streaks.sql:19) and to carts (059_cart_tables.sql:10), neither of which is this ledger. So a credited bonus is held forever, and the repository publishes no period, no sweep and no policy this contract could pin. What is missing before a number may be declared here: a column or a config key naming the period, and a decision on whether an expiry writes a compensating ledger row -- without that row an expiry would become a fifth bypass of the equation above.";

pub fn a_bonus_expires(expiry_is_published: bool) bool {
  return expiry_is_published;
}

; --- Tests -------------------------------------------------------------------------------------------

test the_route_table_is_eight_registrations_over_seven_paths {
  assert ROUTE_REGISTRATION_COUNT == 8;
  assert DISTINCT_PATH_COUNT == 7;
  assert UNGATED_ROUTE_COUNT + OWNER_GATED_ROUTE_COUNT + ADMIN_GATED_ROUTE_COUNT == ROUTE_REGISTRATION_COUNT;
  assert MONEY_ROUTE_COUNT == 2;
  assert MONEY_ROUTES.len == MONEY_ROUTE_COUNT;
}

test the_two_money_routes_stand_behind_the_admin_gate {
  assert MONEY_ROUTE_GATE == GATE_ADMIN;
  assert PATH_SUBJECT_IS_THE_CALLER == false;
  assert subject_is_proven_to_be_the_caller(MONEY_ROUTE_GATE) == false;
  assert a_third_party_may_move_this_balance(MONEY_ROUTE_GATE) == true;
}

test the_three_gate_values_are_distinguished {
  assert subject_is_proven_to_be_the_caller(GATE_OWNER) == true;
  assert subject_is_proven_to_be_the_caller(GATE_NONE) == false;
  assert subject_is_proven_to_be_the_caller(GATE_ADMIN) == false;
  assert a_third_party_may_move_this_balance(GATE_OWNER) == false;
  assert a_third_party_may_move_this_balance(GATE_NONE) == false;
}

test a_key_string_is_the_whole_identity_of_a_request {
  assert replay_is_answered_from_the_key_alone(true) == true;
  assert replay_is_answered_from_the_key_alone(false) == false;
  assert REPLAY_COMPARES_THE_SUBJECT == false;
  assert REPLAY_COMPARES_THE_AMOUNT == false;
  assert REPLAY_COMPARES_THE_DIRECTION == false;
  assert KEY_IS_THE_WHOLE_PRIMARY_KEY == true;
  assert KEY_COLUMNS.len == KEY_COLUMN_COUNT;
}

test a_differing_payload_cannot_be_detected {
  assert KEY_TABLE_STORES_A_PAYLOAD_DIGEST == false;
  assert KEY_TABLE_STORES_A_ROUTE_DISCRIMINATOR == false;
  assert a_differing_payload_is_detected(true, false) == false;
  assert a_differing_payload_is_detected(true, true) == true;
  assert a_differing_payload_is_detected(false, true) == false;
  assert COMMERCE_CONFLICT_VERDICT_IS_REACHABLE_HERE == false;
}

test key_syntax_is_bounded_at_both_ends {
  assert key_syntax_is_legal(1, true) == true;
  assert key_syntax_is_legal(100, true) == true;
  assert key_syntax_is_legal(101, true) == false;
  assert key_syntax_is_legal(0, true) == false;
  assert key_syntax_is_legal(50, false) == false;
  assert KEY_MAX_LEN == 100;
}

test replay_protection_is_opt_in_and_absent_by_default {
  assert IDEMPOTENCY_HEADER_IS_REQUIRED == false;
  assert write_is_replay_protected(true) == true;
  assert write_is_replay_protected(false) == false;
}

test one_namespace_serves_both_directions_and_every_account {
  assert KEY_NAMESPACE_IS_SHARED_ACROSS_DIRECTIONS == true;
  assert KEY_NAMESPACE_IS_SHARED_ACROSS_ACCOUNTS == true;
  assert a_key_minted_for_one_direction_replays_on_the_other(DIRECTION_CREDIT, DIRECTION_DEBIT, true) == true;
  assert a_key_minted_for_one_direction_replays_on_the_other(DIRECTION_DEBIT, DIRECTION_CREDIT, true) == true;
  assert a_key_minted_for_one_direction_replays_on_the_other(DIRECTION_CREDIT, DIRECTION_CREDIT, true) == false;
  assert a_key_minted_for_one_direction_replays_on_the_other(DIRECTION_CREDIT, DIRECTION_DEBIT, false) == false;
}

test a_stored_key_proves_a_committed_prior {
  assert KEY_ROW_IS_WRITTEN_INSIDE_THE_MONEY_TRANSACTION == true;
  assert key_row_implies_a_committed_prior(true) == true;
  assert key_row_implies_a_committed_prior(false) == false;
  assert COMMERCE_IN_PROGRESS_VERDICT_IS_REACHABLE_HERE == false;
  assert key_row_is_written(true, true) == true;
  assert key_row_is_written(true, false) == false;
  assert key_row_is_written(false, true) == false;
}

test a_refused_debit_leaves_no_key_behind {
  assert debit_is_admitted(50, true, 100000000, 0) == false;
  assert key_row_is_written(true, false) == false;
  assert balance_after_debit(0, 50, true, 100000000) == 0;
}

test the_credit_route_admits_zero_and_the_debit_route_does_not {
  assert ZERO_IS_ADMITTED_AS_A_CREDIT == true;
  assert ZERO_IS_ADMITTED_AS_A_DEBIT == false;
  assert zero_amount_is_admitted(DIRECTION_CREDIT, 100000000) == true;
  assert zero_amount_is_admitted(DIRECTION_DEBIT, 100000000) == false;
}

test both_routes_share_one_per_call_ceiling {
  assert GRANT_CEILING_MAJOR_UNITS == 1000000;
  assert grant_ceiling_minor(100) == 100000000;
  assert grant_ceiling_minor(1) == 1000000;
  assert credit_is_admitted(100000000, true, 100000000) == true;
  assert credit_is_admitted(100000001, true, 100000000) == false;
  assert debit_is_admitted(100000000, true, 100000000, 100000000) == true;
  assert debit_is_admitted(100000001, true, 100000000, 100000001) == false;
}

test a_non_finite_or_negative_amount_is_refused_on_both_routes {
  assert credit_is_admitted(100, false, 100000000) == false;
  assert debit_is_admitted(100, false, 100000000, 100000) == false;
  assert credit_is_admitted(-1, true, 100000000) == false;
  assert debit_is_admitted(-1, true, 100000000, 100000) == false;
}

test a_debit_is_checked_against_the_balance_in_the_same_statement {
  assert debit_is_admitted(200, true, 100000000, 500) == true;
  assert debit_is_admitted(200, true, 100000000, 200) == true;
  assert debit_is_admitted(200, true, 100000000, 199) == false;
  assert balance_after_debit(500, 200, true, 100000000) == 300;
  assert balance_after_debit(199, 200, true, 100000000) == 199;
}

test no_admitted_movement_drives_the_balance_below_zero {
  assert balance_after_debit(200, 200, true, 100000000) == 0;
  assert balance_after_debit(0, 1, true, 100000000) == 0;
  assert balance_after_credit(0, 0, true, 100000000) == 0;
  assert balance_after_credit(0, 250, true, 100000000) == 250;
  assert BALANCE_FLOOR_MINOR == 0;
  assert SCHEMA_ENFORCES_NO_BALANCE_FLOOR == true;
}

test the_clamp_is_unreachable_while_the_guard_stands {
  assert GUARD_IS_PRESENT == true;
  assert clamp_would_fire(100, 200) == true;
  assert clamp_would_fire(200, 100) == false;
  assert clamp_would_fire(200, 200) == false;
  assert clamp_fires_under_the_guard(100, 200, true) == false;
  assert clamp_fires_under_the_guard(100, 200, false) == true;
}

test one_grant_is_capped_and_the_balance_is_not {
  assert BALANCE_HAS_NO_CEILING == true;
  assert balance_after_credit(100000000000, 100000000, true, 100000000) == 100100000000;
  assert THIS_LEDGER_HAS_A_PER_WINDOW_CEILING == false;
  assert THE_OTHER_NON_PURCHASE_CREDIT_HAS_ONE == true;
  assert REUSES_STAR_AWARD_ID == "turbobaby/star-award";
}

test the_ledger_row_records_direction_by_sign_alone {
  assert LEDGER_ROW_COLUMNS.len == LEDGER_ROW_COLUMN_COUNT;
  assert direction_of(1) == DIRECTION_CREDIT;
  assert direction_of(-1) == DIRECTION_DEBIT;
  assert direction_of(0) == DIRECTION_NONE;
  assert LEDGER_AMOUNT_COLUMN_IS_A_BINARY_FLOAT == true;
  assert BALANCE_COLUMN_IS_A_BINARY_FLOAT == true;
}

test the_category_column_has_no_closed_vocabulary {
  assert TX_TYPE_IS_CALLER_SUPPLIED_ON_A_CREDIT == true;
  assert TX_TYPE_VOCABULARY_IS_CLOSED == false;
  assert TX_TYPE_MAX_LEN == 50;
  assert tx_type_is_legal(50) == true;
  assert tx_type_is_legal(51) == false;
  assert tx_type_is_legal(0) == true;
  assert DEBIT_TX_TYPE == "admin_deduction";
}

test the_ledger_does_not_sum_to_the_balance {
  assert BALANCE_WRITE_SITE_COUNT == 10;
  assert BALANCE_WRITES_WITH_A_LEDGER_ROW == 6;
  assert BALANCE_WRITES_WITHOUT_A_LEDGER_ROW == 4;
  assert BALANCE_WRITES_WITH_A_LEDGER_ROW + BALANCE_WRITES_WITHOUT_A_LEDGER_ROW == BALANCE_WRITE_SITE_COUNT;
  assert LEDGER_BYPASS_SITES.len == BALANCE_WRITES_WITHOUT_A_LEDGER_ROW;
  assert ledger_sums_to_the_balance(BALANCE_WRITES_WITHOUT_A_LEDGER_ROW) == false;
  assert ledger_sums_to_the_balance(0) == true;
  assert THE_LEDGER_SUMS_TO_THE_BALANCE_TODAY == false;
}

test the_key_namespace_is_never_pruned {
  assert TTL_SWEEP_COUNT == 3;
  assert SWEPT_TABLES.len == TTL_SWEEP_COUNT;
  assert ORDER_KEY_RETENTION_HOURS == 24;
  assert LOYALTY_KEY_TABLE_IS_SWEPT == false;
  assert LOYALTY_KEY_DELETE_STATEMENT_COUNT == 0;
  assert KEY_TABLE_CREATED_AT_IS_INDEXED == true;
  assert key_namespace_is_bounded(LOYALTY_KEY_TABLE_IS_SWEPT) == false;
  assert key_is_permanent(LOYALTY_KEY_TABLE_IS_SWEPT) == true;
  assert key_is_permanent(true) == false;
}

test this_file_declares_no_rate_and_names_the_source {
  assert DECLARES_A_TIER_TABLE == false;
  assert DECLARES_A_CASHBACK_PERCENT == false;
  assert DECLARES_A_USAGE_CEILING == false;
  assert RATE_SOURCE == "src/trios/loyalty.rs";
  assert SEED_MEASUREMENT_OWNER_ID == "turbobaby/order-money";
}

test no_expiry_period_is_published_anywhere {
  assert DECLARES_AN_EXPIRY_PERIOD == false;
  assert BONUS_EXPIRY_NAME_OCCURRENCES == 0;
  assert BONUS_EXPIRY_IS_PUBLISHED_ANYWHERE == false;
  assert a_bonus_expires(BONUS_EXPIRY_IS_PUBLISHED_ANYWHERE) == false;
  assert a_bonus_expires(true) == true;
}

test reuse_edges_are_declared_and_nothing_is_restated {
  assert REUSE_EDGES.len == REUSE_EDGE_COUNT;
  assert REUSES_ORDER_MONEY_ID == "turbobaby/order-money";
  assert REUSES_STAR_AWARD_ID == "turbobaby/star-award";
  assert REUSES_COMMERCE_ID == "turbobaby/commerce";
  assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
  assert REUSES_MARKET_PROFILE_ID == "turbobaby/market";
  assert RESTATES_THE_COMMERCE_DECISION_SET == false;
  assert DECLARES_AN_EXCHANGE_RATE == false;
  assert NAMED_IN_THE_IDENTITY_CONSUMER_SNAPSHOT == false;
}

; --- Invariants --------------------------------------------------------------------------------------

invariant a_key_alone_decides_whether_two_requests_are_one
  assert replay_is_answered_from_the_key_alone(true) == true and a_differing_payload_is_detected(true, KEY_TABLE_STORES_A_PAYLOAD_DIGEST) == false

invariant an_absent_header_leaves_the_write_unprotected
  assert IDEMPOTENCY_HEADER_IS_REQUIRED == false and write_is_replay_protected(false) == false

invariant one_namespace_lets_a_credit_key_answer_on_the_debit_route
  assert a_key_minted_for_one_direction_replays_on_the_other(DIRECTION_CREDIT, DIRECTION_DEBIT, true) == true

invariant the_commerce_conflict_verdict_cannot_be_produced_here
  assert COMMERCE_CONFLICT_VERDICT_IS_REACHABLE_HERE == false and a_differing_payload_is_detected(true, false) == false

invariant a_money_route_never_proves_the_caller_is_the_subject
  assert subject_is_proven_to_be_the_caller(MONEY_ROUTE_GATE) == false and a_third_party_may_move_this_balance(MONEY_ROUTE_GATE) == true

invariant no_admitted_debit_can_drive_the_balance_below_zero
  assert balance_after_debit(200, 200, true, 100000000) == 0 and balance_after_debit(0, 1, true, 100000000) == 0 and balance_after_debit(199, 200, true, 100000000) == 199

invariant the_guard_and_not_the_clamp_is_load_bearing
  assert clamp_fires_under_the_guard(0, 1, true) == false and clamp_would_fire(0, 1) == true

invariant a_zero_amount_parts_the_two_routes
  assert zero_amount_is_admitted(DIRECTION_CREDIT, 100000000) == true and zero_amount_is_admitted(DIRECTION_DEBIT, 100000000) == false

invariant the_ledger_cannot_reconstruct_the_balance_while_a_bypass_survives
  assert ledger_sums_to_the_balance(BALANCE_WRITES_WITHOUT_A_LEDGER_ROW) == false and ledger_sums_to_the_balance(0) == true

invariant every_bypass_site_is_named_and_counted
  assert LEDGER_BYPASS_SITES.len == BALANCE_WRITES_WITHOUT_A_LEDGER_ROW and BALANCE_WRITES_WITH_A_LEDGER_ROW + BALANCE_WRITES_WITHOUT_A_LEDGER_ROW == BALANCE_WRITE_SITE_COUNT

invariant an_unswept_key_table_makes_every_key_permanent
  assert key_is_permanent(LOYALTY_KEY_TABLE_IS_SWEPT) == true and key_namespace_is_bounded(LOYALTY_KEY_TABLE_IS_SWEPT) == false

invariant no_rate_tier_ceiling_or_expiry_is_declared_in_this_file
  assert DECLARES_A_TIER_TABLE == false and DECLARES_A_CASHBACK_PERCENT == false and DECLARES_A_USAGE_CEILING == false and DECLARES_AN_EXPIRY_PERIOD == false

invariant the_grant_ceiling_bounds_one_call_and_not_the_balance
  assert BALANCE_HAS_NO_CEILING == true and credit_is_admitted(100000001, true, 100000000) == false and balance_after_credit(100000000000, 100000000, true, 100000000) == 100100000000
