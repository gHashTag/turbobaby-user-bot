// SPDX-License-Identifier: Apache-2.0
; specs/turbobaby/api_surface.t27 -- the relation between the routes the binary serves and the
; routes the published document claims.
; One boundary with two sides and nothing joining them. On one side src/api/mod.rs merges a set
; of module routers under a single nest and decides what a request that matches none of them
; hears back. On the other side src/api/openapi.rs builds a document that a client reads as a
; promise about that same surface. This file owns the RELATION: a documented path must be
; routed, a routed path must be documented or exempt, and an unmatched path under the nest must
; not answer as a success. It owns neither side's contents. What a read request answers when it
; DOES match belongs to turbobaby/catalog-api; what a failed call is allowed to tell a customer
; belongs to turbobaby/client-errors; whether a request proved who it is belongs to
; turbobaby/request-identity; what a request may be correlated by belongs to
; turbobaby/observability. Four edges, named below by ID, none of them restated.
; --
; WHY (measured 2026-09-21). The binary serves 103 distinct paths under /api and the document
; names 9 of them. The other 94 are routed and published nowhere. The reverse direction is
; clean today -- all 9 documented paths resolve to a live registration with the documented verb
; -- but nothing holds it that way: no test in tests/ mentions the document at all (a grep of
; tests/ for openapi or ApiDoc on 2026-09-21 returns zero files), and the one gate that does
; read the router, the route-wiring test at src/api/mod.rs:304-494, takes the MODULE as its
; subject and never a path. A module can be merged, pass that gate, and carry a path the
; document invented or forgot; both readings stay green. So the gap is not a backlog, it is
; unmonitored: the number above was true on 2026-09-21 and the next route changes it in silence.
; --
; The second half of this file is one structural law rather than a count, because the repository
; paid for it once already. Issue #48: an unmatched /api path inherited the outer SPA fallback
; and answered 200 with index.html. src/api/mod.rs:107-120 and tests/api_miss_is_not_html.rs:1-25
; both record what that cost -- nine calls in the fleet admin screen (src/api/mod.rs:116) went to
; endpoints nobody had written, the client parsed HTML as JSON, and because the writes are
; optimistic-first a success toast painted over a row that had never been saved. THE FIX IS IN
; THE TREE: src/api/mod.rs:120 sets the API router's own fallback, last, after every merge, and
; src/api/mod.rs:128-136 answers it as JSON that names the path it could not find.
; --
; WHERE THE BRIEF IS REFUTED. Five corrections, each measured on 2026-09-21, each with its line.
;   1. The obvious merge count is wrong by six. grep for .merge( over src/api/mod.rs returns 24
;      lines; eighteen are calls in api_routes (seventeen at :84-100, plus upload at :105) and
;      six are the route-wiring test module's own needles and prose (:301, :323, :445, :463,
;      :464, :482). A count taken from the grep total overstates the router by a third.
;   2. The obvious path count is wrong by twenty-four, in the other direction. A single-line
;      grep for .route(" over src/api/*.rs finds 101 production registrations and 80 distinct
;      paths; the same pass tolerant of a line break between .route( and its literal finds 125
;      and 104. rustfmt wraps any .route call whose arguments are long, so the paths that go
;      missing are systematically the longest ones -- including /loyalty/:telegram_id/bonus-history
;      (src/api/loyalty.rs:27-30), which the document DOES name and a single-line grep would have
;      reported as a phantom. The wrong measurement produces the wrong finding, not a smaller one.
;   3. "utoipa stubs behind allow(dead_code)" names the lint and not the gate. src/api/openapi.rs:1
;      silences the stubs; what decides whether they exist is src/api/mod.rs:21, and that feature
;      is absent from the default build -- Cargo.toml:174 reads default = [], utoipa is optional
;      at Cargo.toml:111 and is pulled in only by backend at Cargo.toml:183, which the server
;      binary requires at Cargo.toml:65 and which src/lib.rs:101-102 makes the condition for the
;      whole api module. On a default build neither the document nor any route exists -- and
;      that is what closes the case rather than opening it, because a build with no api module
;      has no server binary either (Cargo.toml:65) and therefore no SPA fallback to mistake for
;      the document. Read one step further and default = [] stops deciding anything: backend
;      lists utoipa at Cargo.toml:183 and Cargo features are additive, so backend cannot be
;      selected without it. Every build in which src/main.rs compiles has the document endpoint
;      registered at src/main.rs:1141, and the not(feature) stand-in at :1153-1154 is
;      unreachable in that binary.
;   4. The regression witness does not test the shipped router. tests/api_miss_is_not_html.rs
;      builds stand-ins for both halves (:36-55) and assembles its own sandwich at :59-72; the
;      real api::router appears in that file only inside the prose at :4 and :14. What it pins is
;      the axum nesting semantics the fix depends on, which is worth pinning and is what its own
;      header argues for. What it does not pin is this repository's use of them: delete
;      src/api/mod.rs:120 and the witness stays green.
;   5. One registered path is not served at the path it reads as. src/api/quest.rs:16 registers
;      /api/test inside a router that src/api/mod.rs:77 nests under /api, so the served path is
;      /api/api/test and a request to /api/test reaches the miss handler. It is counted among the
;      103 because it is a real registration; it is named here because the doubling is invisible
;      at the call site, which is the same reason #48 was invisible.
; --
; WHAT THIS FILE NEVER DOES. It does not enumerate the paths. A list of 103 path strings would be
; the restated-list defect in its purest form: it would be stale on the next route, it would
; invite a reader to treat this file rather than the router as the surface, and its staleness
; would be silent in exactly the way the drift it describes is silent. The counts below are dated
; and the command that produced each one is recorded, so a reader can re-measure instead of
; trusting. It carries no OpenAPI schema fragment, no request or response body shape, no
; parameter list and no tag. It declares no HTTP numeral: the success and miss numerals this
; subject turns on are already declared by turbobaby/catalog-api and are named by their owner
; instead of copied. It names no gate for any endpoint -- turbobaby/request-identity records that
; the endpoint-to-gate map is not owned there either, and it cannot be owned here, because that
; map IS a route table. Nothing from D14 -- no renter, handle, phone, key code, plate, debt,
; purchase price or personal note -- in a constant, a comment or a test.
; phi^2 + 1/phi^2 = 3 | TRINITY

module turbobaby-api-surface;

pub const KIND : str = "surface-contract";
pub const ID : str = "turbobaby/api-surface";
pub const NAME : str = "TurboBaby served routes versus published documentation";
pub const WORLD : str = "gHashTag/turbobaby-user-bot";
pub const MEASURED_AT : str = "2026-09-21";

; --- Sources --------------------------------------------------------------------------------
pub const ROUTER_SOURCE : str = "src/api/mod.rs";
pub const DOCUMENT_SOURCE : str = "src/api/openapi.rs";
pub const DOCUMENT_ENDPOINT_SOURCE : str = "src/main.rs";
pub const MISS_WITNESS : str = "tests/api_miss_is_not_html.rs";
pub const WIRING_GATE_SITE : str = "src/api/mod.rs:304-494";
; wc -l over the tracked sources, 2026-09-21.
pub const ROUTER_SOURCE_LINES : u16 = 494;
pub const DOCUMENT_SOURCE_LINES : u16 = 239;

; --- Ownership edges ------------------------------------------------------------------------
; The pinned compiler lowers an import to nothing the gate will accept, so a cross-contract edge
; is a string naming the owner's ID plus a test asserting the literal.
; catalog-api owns what a matched read request answers, including every wire numeral this
; subject would otherwise want to re-declare; the law below is written over named answer kinds
; instead of statuses for that reason. client-errors owns what a failed call is allowed to tell
; a customer, so this file says that a miss must be legible and not what sentence it carries.
; request-identity owns who a request is; a gate is not documentation and documentation is not a
; gate, so an undocumented path is not thereby a private one and a documented path is not thereby
; an open one. observability owns correlation, which is what makes a miss findable after the
; fact; this file states that the answer must be honest, not what it must be logged as.
pub const REUSES_CATALOG_API_ID : str = "turbobaby/catalog-api";
pub const REUSES_CLIENT_ERRORS_ID : str = "turbobaby/client-errors";
pub const REUSES_REQUEST_IDENTITY_ID : str = "turbobaby/request-identity";
pub const REUSES_OBSERVABILITY_ID : str = "turbobaby/observability";
pub const REUSE_EDGE_COUNT : u8 = 4;
pub const SUCCESS_NUMERAL_ALREADY_DECLARED_AT : str = "turbobaby/catalog-api";
pub const MISS_NUMERAL_ALREADY_DECLARED_AT : str = "turbobaby/catalog-api";
pub const THIS_FILE_DECLARES_NO_HTTP_NUMERAL : bool = true;
pub const A_GATE_IS_NOT_DOCUMENTATION : bool = true;
pub const ENDPOINT_TO_GATE_MAP_IS_OWNED_HERE : bool = false;

; --- The router, measured ---------------------------------------------------------------------
; api_routes (src/api/mod.rs:81-121) builds one Router, merges eighteen module routers into it,
; and src/api/mod.rs:77 nests the result under a single prefix. Seventeen merges are chained at
; :84-100; upload is merged separately at :105 so it lands AFTER the general body limit set at
; :104 and keeps its own larger one. That is a body-limit decision and not a routing one, and the
; limit itself is turbobaby/client-errors' number: it is named here and not restated.
pub const NEST_PREFIX : str = "/api";
pub const MERGED_MODULE_COUNT : u8 = 18;
pub const MODULES_DECLARING_A_ROUTES_FN : u8 = 18;
pub const ROUTE_MODULES_NOT_MERGED : u8 = 0;
pub const GENERAL_BODY_LIMIT_IS_RESTATED_HERE : bool = false;
pub const MERGE_COMMAND : str = "grep -n for .merge( over src/api/mod.rs on 2026-09-21 returns 24 lines: eighteen calls in api_routes at :84-100 and :105, and six inside the route-wiring test module at :301, :323, :445, :463, :464 and :482.";

; Every .route call whose byte offset precedes its file's first cfg(test), with the first string
; literal taken as the path and a line break between .route( and that literal tolerated. One
; registration may carry several verbs, which is why the pair count exceeds the call count.
pub const PATH_COMMAND : str = "A python pass over src/api/*.rs on 2026-09-21 collecting the first string literal of every .route call before the first cfg(test) marker: 125 registrations, 104 distinct paths, 141 distinct verb-and-path pairs. The one route in src/api/observability.rs is inside that file's test module and is excluded.";
pub const ROUTE_REGISTRATION_COUNT : u16 = 125;
pub const DISTINCT_PATH_COUNT : u16 = 104;
pub const VERB_PATH_PAIR_COUNT : u16 = 141;
; /health is registered on the outer router at src/api/mod.rs:76 and is the only path of the 104
; that does not sit under the nest. /ping at :83 does sit under it.
pub const PATHS_OUTSIDE_THE_NEST : u16 = 1;
pub const API_PATH_COUNT : u16 = 103;
pub const API_VERB_PATH_PAIR_COUNT : u16 = 140;
; A single-line grep is the wrong instrument here and the difference is not noise.
pub const SINGLE_LINE_GREP_REGISTRATIONS : u16 = 101;
pub const SINGLE_LINE_GREP_DISTINCT_PATHS : u16 = 80;
pub const REGISTRATIONS_A_SINGLE_LINE_GREP_MISSES : u16 = 24;

; --- The document, measured -------------------------------------------------------------------
; src/api/openapi.rs:135-179 derives the served document; its paths list at :153-163 has nine
; entries and nine stub functions exist to be listed. Each documents exactly one verb.
pub const DOCUMENTED_PATH_COUNT : u16 = 9;
pub const DOCUMENTED_VERB_PATH_PAIR_COUNT : u16 = 9;
pub const DOCUMENT_STUB_COUNT : u16 = 9;
pub const DOCUMENT_STUBS_NOT_LISTED : u16 = 0;
; Cross-check of the nine against the registrations, by path shape with the parameter name
; normalized away, on 2026-09-21.
pub const DOCUMENTED_PATHS_NOT_ROUTED : u16 = 0;
pub const DOCUMENTED_PAIRS_NOT_ROUTED : u16 = 0;
pub const ROUTED_API_PATHS_NOT_DOCUMENTED : u16 = 94;
pub const ROUTED_API_PAIRS_NOT_DOCUMENTED : u16 = 131;
; The nine documented paths carry fourteen shipped verb-and-path pairs between them, so five
; shipped verbs sit on a path the document names while going unmentioned themselves. A
; path-level reading calls those five documented; they are not.
pub const PAIRS_ON_DOCUMENTED_PATHS : u16 = 14;
pub const UNDOCUMENTED_VERBS_ON_DOCUMENTED_PATHS : u16 = 5;

; --- Nothing gates the two together -----------------------------------------------------------
; The wiring gate (src/api/mod.rs:304-494) asks whether every module that declares routes() is
; both declared and merged, and it carries its own anti-vacuity floor at :398 after the needle
; went blind for three months. It is a good gate for its own subject and blind to this one: its
; subject is the module, never the path, and never the document.
pub const WIRING_GATE_EXISTS : bool = true;
pub const WIRING_GATE_SUBJECT_IS_THE_MODULE : bool = true;
pub const WIRING_GATE_SUBJECT_IS_THE_PATH : bool = false;
pub const WIRING_GATE_READS_THE_DOCUMENT : bool = false;
pub const WIRING_GATE_FLOOR : u8 = 10;
pub const WIRING_GATE_SUBJECTS_TODAY : u8 = 18;
; The floor's own comment at src/api/mod.rs:391 calls the real count 19. Replaying the
; recogniser at :369-374 over src/api/*.rs on 2026-09-21 finds 18, all merged. The claim is one
; high, the floor is unaffected, and the allowlist at :313 is empty as its comment says.
pub const WIRING_GATE_COMMENT_CLAIMS_SUBJECTS : u8 = 19;
pub const WIRING_GATE_COMMENT_IS_CORRECT : bool = false;
pub const TEST_FILES_NAMING_THE_DOCUMENT : u8 = 0;
pub const DOCUMENT_IS_GATED_AGAINST_THE_ROUTER : bool = false;
; src/api/openapi.rs:195-239 does gate the document, on vocabulary: it asserts the served text
; carries no retired word and does name the product. That is a rebrand gate, and it would pass
; unchanged on a document describing nine paths that do not exist.
pub const DOCUMENT_HAS_A_VOCABULARY_GATE : bool = true;
pub const VOCABULARY_GATE_READS_THE_ROUTER : bool = false;

; --- Compilation and reach of the document ------------------------------------------------------
; The endpoint that serves the document is merged at the TOP level (src/main.rs:1141, merged at
; :1170), OUTSIDE the nest. Outside is a statement about segments and not about spelling: axum
; matches a nest on a segment boundary, so /api-docs is a different first segment from /api even
; though the two share four characters. The miss law therefore does not cover that path however
; the feature is set, and that is the durable half of this section.
;
; The other half is a correction of the obvious reading. The document is behind a crate feature
; (src/api/mod.rs:21) and Cargo.toml:174 does read default = [], so a first pass concludes that
; the endpoint is usually absent and falls to the SPA at src/main.rs:1199. It cannot. The server
; binary carries required-features for backend at Cargo.toml:65, backend lists utoipa at
; Cargo.toml:183, and Cargo features are additive, so backend cannot be selected without utoipa:
; in every build where src/main.rs compiles the endpoint IS registered, and the empty stand-in at
; src/main.rs:1153-1154 is unreachable in that binary. Turn the feature off and there is no
; server at all -- src/lib.rs:101-102 drops the whole api module and Cargo.toml:65 drops the
; binary -- so there is no outer fallback either, and nothing answers the path with anything.
; The uncovered case is CONDITIONAL and it is still worth a law: remove or rename the endpoint
; while src/main.rs:1199 stands, and /api-docs/openapi.json becomes a registered-nowhere path
; outside the nest, which is the one shape src/api/mod.rs:120 was never able to govern.
pub const DOCUMENT_IS_BEHIND_A_CRATE_FEATURE : bool = true;
pub const DOCUMENT_FEATURE_IS_IN_THE_DEFAULT_FEATURE_SET : bool = false;
pub const SERVER_BINARY_REQUIRES_THE_BACKEND_FEATURE : bool = true;
pub const BACKEND_FEATURE_ENABLES_THE_DOCUMENT_FEATURE : bool = true;
pub const DOCUMENT_ENDPOINT_IS_REGISTERED_IN_EVERY_SERVING_BUILD : bool = true;
pub const DOCUMENT_ENDPOINT_IS_UNDER_THE_NEST : bool = false;
pub const OUTER_FALLBACK_SERVES_SPA : bool = true;
pub const FEATURE_READING_NOTE : str = "A default feature set decides what a default build contains, not what a serving build contains. Reading Cargo.toml:174 alone and stopping there yields the claim that a client fetching /api-docs/openapi.json receives a success page instead of the document, and no build can be in that state: the same switch that removes the document removes the server that would have answered.";

; --- The law: a routed path and a documented path must be the same path -------------------------
; Exemption is an abstract parameter. It excuses a routed path the document omits on purpose --
; a liveness probe, a debug hook -- and it can never excuse a documented path that is not
; routed, because no reason makes a promise about a path that does not exist true.
pub fn path_is_consistent(routed: bool, documented: bool, exempt: bool) bool {
  if (documented and !routed) {
    return false;
  }
  if (routed and !documented and !exempt) {
    return false;
  }
  return true;
}

pub fn documented_path_is_phantom(routed: bool, documented: bool) bool {
  return documented and !routed;
}

pub fn routed_path_is_undisclosed(routed: bool, documented: bool, exempt: bool) bool {
  return routed and !documented and !exempt;
}

; The two directions partition the surface: every routed path is either documented or not, and
; every documented path is either routed or not, so the four census numbers close. Holding this
; identity is how a future measurement catches itself counting one side twice.
pub fn census_closes(api_paths: u16, documented: u16, phantom: u16, undisclosed: u16) bool {
  return documented + undisclosed == api_paths + phantom;
}

; Drift is not the inconsistency. Drift is an inconsistency that no reader is told about, which
; is the state this repository is in today and the reason this contract exists.
pub fn drift_is_silent(consistent: bool, a_gate_reads_both_sides: bool) bool {
  return !consistent and !a_gate_reads_both_sides;
}

pub fn surface_has_a_pairing_gate(module_wiring_gated: bool, path_pairing_gated: bool) bool {
  return module_wiring_gated and path_pairing_gated;
}

; --- The law: a miss under the nest is never a success ------------------------------------------
pub const ANSWER_UNSET : u8 = 0;
pub const ANSWER_JSON_MISS : u8 = 1;
pub const ANSWER_SPA_HTML : u8 = 2;
pub const ANSWER_BARE_MISS : u8 = 3;
pub const ANSWER_KIND_COUNT : u8 = 4;

; Both conditions are load-bearing and the second is the one #48 turned on: a fallback set
; before a merge loses to the merged router's own, which is why src/api/mod.rs:120 is the last
; statement of api_routes and why its comment at :118-119 says so.
pub fn unmatched_api_answer(api_fallback_set: bool, set_after_every_merge: bool, outer_fallback_serves_spa: bool) u8 {
  if (api_fallback_set and set_after_every_merge) {
    return ANSWER_JSON_MISS;
  }
  if (outer_fallback_serves_spa) {
    return ANSWER_SPA_HTML;
  }
  return ANSWER_BARE_MISS;
}

pub fn unmatched_api_answer_is_honest(answer: u8) bool {
  return answer == ANSWER_JSON_MISS or answer == ANSWER_BARE_MISS;
}

pub fn a_miss_can_render_as_success(answer: u8) bool {
  return answer == ANSWER_SPA_HTML;
}

; The bare miss is honest but mute. Naming the path it could not find is what turns a wrong
; guess into a diagnosis, and it is what src/api/mod.rs:133 does.
pub fn answer_names_the_missing_path(answer: u8) bool {
  return answer == ANSWER_JSON_MISS;
}

; How nine endpoints stayed dead: the answer parsed as a page rather than an error, and an
; optimistic-first write had already painted success before anything read the response.
pub fn a_dead_write_shows_a_success_toast(answer: u8, write_is_optimistic_first: bool) bool {
  return a_miss_can_render_as_success(answer) and write_is_optimistic_first;
}

; The law reaches exactly as far as the nest. A path served beside the nest is governed by
; whatever the outer router does, and today that is the SPA.
pub fn miss_law_covers(path_is_under_the_nest: bool) bool {
  return path_is_under_the_nest;
}

pub fn absent_path_answers_html(path_is_registered: bool, path_is_under_the_nest: bool, outer_fallback_serves_spa: bool) bool {
  if (path_is_registered) {
    return false;
  }
  if (path_is_under_the_nest) {
    return false;
  }
  return outer_fallback_serves_spa;
}

; Whether a feature is on in the builds that matter is a question about the binary's required
; features and not about the default set. That is the correction above, as a function.
pub fn document_endpoint_is_registered(default_set_carries_it: bool, server_requires_backend: bool, backend_enables_it: bool) bool {
  if (default_set_carries_it) {
    return true;
  }
  return server_requires_backend and backend_enables_it;
}

; --- A registration is a string, so it can disagree with itself ---------------------------------
; The nest prefix is applied by the parent. A module that spells the prefix again gets it twice,
; and nothing in the compiler can see it: src/api/quest.rs:16 is the one such registration today.
pub const REGISTRATIONS_REPEATING_THE_PREFIX : u8 = 1;
pub const PREFIX_DOUBLING_SITE : str = "src/api/quest.rs:16";

pub fn served_path_doubles_the_prefix(module_path_repeats_the_prefix: bool) bool {
  return module_path_repeats_the_prefix;
}

pub fn path_is_reachable_as_written(module_path_repeats_the_prefix: bool) bool {
  return !module_path_repeats_the_prefix;
}

; --- What the witness proves, and what it does not ----------------------------------------------
pub const WITNESS_EXISTS : bool = true;
pub const WITNESS_BUILDS_THE_SHIPPED_ROUTER : bool = false;
pub const WITNESS_BUILDS_A_REPLICA : bool = true;
pub const WITNESS_HAS_AN_ANTI_VACUITY_CASE : bool = true;
pub const WITNESS_NOTE : str = "tests/api_miss_is_not_html.rs defines its own api_not_found and spa at :36-55 and composes them at :59-72; api::router is named only in the prose at :4 and :14. The anti-vacuity case at :119 proves the outer SPA fallback is present in the fixture, so the miss assertions are not passing over an empty arrangement. What is still unpinned is the shipped wiring: removing src/api/mod.rs:120 leaves every assertion in that file true.";

pub fn witness_would_catch_a_deleted_fallback(witness_builds_the_shipped_router: bool) bool {
  return witness_builds_the_shipped_router;
}

pub fn wiring_gate_is_awake(subjects_found: u8, floor: u8) bool {
  return subjects_found >= floor;
}

; --- Honest refusals ------------------------------------------------------------------------------
pub const THIS_FILE_ENUMERATES_THE_PATHS : bool = false;
pub const NO_ROUTE_TABLE_NOTE : str = "103 path strings would make this file a second router, wrong on the first route anyone adds, and wrong silently. Reading a list here instead of the code is the failure this contract describes, so the counts are dated and the command that produced each is recorded beside it.";
pub const THIS_FILE_CARRIES_A_SCHEMA_FRAGMENT : bool = false;
pub const NO_SCHEMA_NOTE : str = "No body shape, parameter or tag from src/api/openapi.rs is copied here, and there is less to copy than the word OpenAPI suggests: all nine stubs declare their success body as serde_json::Value (:9, :24, :42, :58, :70, :82, :99, :114, :128) and the single request body is the same (:94), so the document fixes no field of any response it names. That is a fact about the document and not a licence to invent one here.";
pub const EXEMPTION_REGISTER_EXISTS : bool = false;
pub const EXEMPTION_NOTE : str = "The exempt argument has no shipped source. Nothing in the repository records that a routed path is deliberately undocumented; the nearest thing is ALLOWED_UNWIRED_ROUTES at src/api/mod.rs:313, which is empty and is about modules, not paths. Until something declares an exemption, every one of the 94 is undisclosed rather than exempt, and inventing a default of exempt would turn the whole gap green.";
pub const DRIFT_RATE_IS_MEASURED : bool = false;
pub const DRIFT_RATE_NOTE : str = "How fast the gap grows is not measured here. It would need the document and the router compared at two dated points, and the repository holds one dated comparison, this one. A rate stated from a single point would be a wish with a decimal in it.";

; --- Tests ----------------------------------------------------------------------------------------

test api_surface_reuse_edges_are_named_by_id {
  assert REUSES_CATALOG_API_ID == "turbobaby/catalog-api";
  assert REUSES_CLIENT_ERRORS_ID == "turbobaby/client-errors";
  assert REUSES_REQUEST_IDENTITY_ID == "turbobaby/request-identity";
  assert REUSES_OBSERVABILITY_ID == "turbobaby/observability";
  assert REUSE_EDGE_COUNT == 4;
  assert SUCCESS_NUMERAL_ALREADY_DECLARED_AT == REUSES_CATALOG_API_ID;
  assert MISS_NUMERAL_ALREADY_DECLARED_AT == REUSES_CATALOG_API_ID;
  assert THIS_FILE_DECLARES_NO_HTTP_NUMERAL == true;
}

test api_surface_identity_is_its_own {
  assert ID == "turbobaby/api-surface";
  assert KIND == "surface-contract";
  assert MEASURED_AT == "2026-09-21";
  assert ID != REUSES_CATALOG_API_ID;
  assert ID != REUSES_CLIENT_ERRORS_ID;
}

test api_surface_router_census_is_internally_consistent {
  assert MERGED_MODULE_COUNT == 18;
  assert MODULES_DECLARING_A_ROUTES_FN == MERGED_MODULE_COUNT;
  assert ROUTE_MODULES_NOT_MERGED == 0;
  assert API_PATH_COUNT + PATHS_OUTSIDE_THE_NEST == DISTINCT_PATH_COUNT;
  assert API_VERB_PATH_PAIR_COUNT + PATHS_OUTSIDE_THE_NEST == VERB_PATH_PAIR_COUNT;
  assert VERB_PATH_PAIR_COUNT >= ROUTE_REGISTRATION_COUNT;
  assert ROUTE_REGISTRATION_COUNT >= DISTINCT_PATH_COUNT;
}

test api_surface_a_single_line_grep_undercounts_the_router {
  assert SINGLE_LINE_GREP_REGISTRATIONS + REGISTRATIONS_A_SINGLE_LINE_GREP_MISSES == ROUTE_REGISTRATION_COUNT;
  assert SINGLE_LINE_GREP_DISTINCT_PATHS < DISTINCT_PATH_COUNT;
  assert REGISTRATIONS_A_SINGLE_LINE_GREP_MISSES > 0;
}

test api_surface_document_census_closes_against_the_router {
  assert DOCUMENT_STUB_COUNT == DOCUMENTED_PATH_COUNT;
  assert DOCUMENT_STUBS_NOT_LISTED == 0;
  assert DOCUMENTED_VERB_PATH_PAIR_COUNT == DOCUMENTED_PATH_COUNT;
  assert DOCUMENTED_PATHS_NOT_ROUTED == 0;
  assert census_closes(API_PATH_COUNT, DOCUMENTED_PATH_COUNT, DOCUMENTED_PATHS_NOT_ROUTED, ROUTED_API_PATHS_NOT_DOCUMENTED) == true;
  assert census_closes(API_VERB_PATH_PAIR_COUNT, DOCUMENTED_VERB_PATH_PAIR_COUNT, DOCUMENTED_PAIRS_NOT_ROUTED, ROUTED_API_PAIRS_NOT_DOCUMENTED) == true;
}

test api_surface_a_documented_path_can_hide_undocumented_verbs {
  assert PAIRS_ON_DOCUMENTED_PATHS > DOCUMENTED_VERB_PATH_PAIR_COUNT;
  assert DOCUMENTED_VERB_PATH_PAIR_COUNT + UNDOCUMENTED_VERBS_ON_DOCUMENTED_PATHS == PAIRS_ON_DOCUMENTED_PATHS;
  assert ROUTED_API_PAIRS_NOT_DOCUMENTED > ROUTED_API_PATHS_NOT_DOCUMENTED;
}

test api_surface_consistency_is_two_directional {
  assert path_is_consistent(true, true, false) == true;
  assert path_is_consistent(true, false, true) == true;
  assert path_is_consistent(true, false, false) == false;
  assert path_is_consistent(false, true, false) == false;
  assert path_is_consistent(false, false, false) == true;
}

test api_surface_an_exemption_cannot_excuse_a_phantom {
  assert path_is_consistent(false, true, true) == false;
  assert documented_path_is_phantom(false, true) == true;
  assert documented_path_is_phantom(true, true) == false;
  assert documented_path_is_phantom(false, false) == false;
}

test api_surface_an_undisclosed_path_is_named_as_such {
  assert routed_path_is_undisclosed(true, false, false) == true;
  assert routed_path_is_undisclosed(true, false, true) == false;
  assert routed_path_is_undisclosed(true, true, false) == false;
  assert routed_path_is_undisclosed(false, false, false) == false;
  assert EXEMPTION_REGISTER_EXISTS == false;
}

test api_surface_drift_is_silent_here_today {
  assert drift_is_silent(false, false) == true;
  assert drift_is_silent(false, true) == false;
  assert drift_is_silent(true, false) == false;
  assert drift_is_silent(true, true) == false;
  assert surface_has_a_pairing_gate(WIRING_GATE_EXISTS, DOCUMENT_IS_GATED_AGAINST_THE_ROUTER) == false;
}

test api_surface_the_wiring_gate_is_awake_but_looking_elsewhere {
  assert wiring_gate_is_awake(WIRING_GATE_SUBJECTS_TODAY, WIRING_GATE_FLOOR) == true;
  assert wiring_gate_is_awake(0, WIRING_GATE_FLOOR) == false;
  assert wiring_gate_is_awake(WIRING_GATE_FLOOR, WIRING_GATE_FLOOR) == true;
  assert WIRING_GATE_SUBJECT_IS_THE_MODULE == true;
  assert WIRING_GATE_SUBJECT_IS_THE_PATH == false;
  assert WIRING_GATE_READS_THE_DOCUMENT == false;
  assert WIRING_GATE_COMMENT_CLAIMS_SUBJECTS != WIRING_GATE_SUBJECTS_TODAY;
  assert WIRING_GATE_COMMENT_IS_CORRECT == false;
}

test api_surface_the_vocabulary_gate_is_not_a_pairing_gate {
  assert DOCUMENT_HAS_A_VOCABULARY_GATE == true;
  assert VOCABULARY_GATE_READS_THE_ROUTER == false;
  assert TEST_FILES_NAMING_THE_DOCUMENT == 0;
  assert surface_has_a_pairing_gate(DOCUMENT_HAS_A_VOCABULARY_GATE, VOCABULARY_GATE_READS_THE_ROUTER) == false;
}

test api_surface_the_miss_answer_depends_on_both_conditions {
  assert unmatched_api_answer(true, true, true) == ANSWER_JSON_MISS;
  assert unmatched_api_answer(true, true, false) == ANSWER_JSON_MISS;
  assert unmatched_api_answer(true, false, true) == ANSWER_SPA_HTML;
  assert unmatched_api_answer(false, false, true) == ANSWER_SPA_HTML;
  assert unmatched_api_answer(false, false, false) == ANSWER_BARE_MISS;
}

test api_surface_only_the_html_answer_is_dishonest {
  assert unmatched_api_answer_is_honest(ANSWER_JSON_MISS) == true;
  assert unmatched_api_answer_is_honest(ANSWER_BARE_MISS) == true;
  assert unmatched_api_answer_is_honest(ANSWER_SPA_HTML) == false;
  assert unmatched_api_answer_is_honest(ANSWER_UNSET) == false;
  assert a_miss_can_render_as_success(ANSWER_SPA_HTML) == true;
  assert a_miss_can_render_as_success(ANSWER_JSON_MISS) == false;
}

test api_surface_an_honest_miss_may_still_be_mute {
  assert answer_names_the_missing_path(ANSWER_JSON_MISS) == true;
  assert answer_names_the_missing_path(ANSWER_BARE_MISS) == false;
  assert answer_names_the_missing_path(ANSWER_SPA_HTML) == false;
  assert unmatched_api_answer_is_honest(ANSWER_BARE_MISS) == true;
}

test api_surface_the_success_toast_needs_both_halves_of_48 {
  assert a_dead_write_shows_a_success_toast(ANSWER_SPA_HTML, true) == true;
  assert a_dead_write_shows_a_success_toast(ANSWER_SPA_HTML, false) == false;
  assert a_dead_write_shows_a_success_toast(ANSWER_JSON_MISS, true) == false;
  assert a_dead_write_shows_a_success_toast(ANSWER_BARE_MISS, true) == false;
}

test api_surface_the_miss_law_stops_at_the_nest {
  assert miss_law_covers(true) == true;
  assert miss_law_covers(false) == false;
  assert absent_path_answers_html(false, false, true) == true;
  assert absent_path_answers_html(true, false, true) == false;
  assert absent_path_answers_html(false, true, true) == false;
  assert absent_path_answers_html(false, false, false) == false;
}

test api_surface_the_document_endpoint_is_the_uncovered_case {
  assert DOCUMENT_IS_BEHIND_A_CRATE_FEATURE == true;
  assert DOCUMENT_FEATURE_IS_IN_THE_DEFAULT_FEATURE_SET == false;
  assert DOCUMENT_ENDPOINT_IS_UNDER_THE_NEST == false;
  assert miss_law_covers(DOCUMENT_ENDPOINT_IS_UNDER_THE_NEST) == false;
  assert absent_path_answers_html(DOCUMENT_ENDPOINT_IS_REGISTERED_IN_EVERY_SERVING_BUILD, DOCUMENT_ENDPOINT_IS_UNDER_THE_NEST, OUTER_FALLBACK_SERVES_SPA) == false;
  assert absent_path_answers_html(false, DOCUMENT_ENDPOINT_IS_UNDER_THE_NEST, OUTER_FALLBACK_SERVES_SPA) == true;
}

test api_surface_the_default_feature_set_does_not_decide_what_is_served {
  assert document_endpoint_is_registered(DOCUMENT_FEATURE_IS_IN_THE_DEFAULT_FEATURE_SET, SERVER_BINARY_REQUIRES_THE_BACKEND_FEATURE, BACKEND_FEATURE_ENABLES_THE_DOCUMENT_FEATURE) == true;
  assert document_endpoint_is_registered(false, true, false) == false;
  assert document_endpoint_is_registered(false, false, true) == false;
  assert document_endpoint_is_registered(true, false, false) == true;
  assert DOCUMENT_ENDPOINT_IS_REGISTERED_IN_EVERY_SERVING_BUILD == true;
}

test api_surface_a_repeated_prefix_is_served_twice {
  assert REGISTRATIONS_REPEATING_THE_PREFIX == 1;
  assert served_path_doubles_the_prefix(true) == true;
  assert served_path_doubles_the_prefix(false) == false;
  assert path_is_reachable_as_written(true) == false;
  assert path_is_reachable_as_written(false) == true;
}

test api_surface_the_witness_pins_the_semantics_not_the_wiring {
  assert WITNESS_EXISTS == true;
  assert WITNESS_HAS_AN_ANTI_VACUITY_CASE == true;
  assert WITNESS_BUILDS_A_REPLICA == true;
  assert WITNESS_BUILDS_THE_SHIPPED_ROUTER == false;
  assert witness_would_catch_a_deleted_fallback(WITNESS_BUILDS_THE_SHIPPED_ROUTER) == false;
  assert witness_would_catch_a_deleted_fallback(true) == true;
}

test api_surface_refuses_to_become_a_second_router {
  assert THIS_FILE_ENUMERATES_THE_PATHS == false;
  assert THIS_FILE_CARRIES_A_SCHEMA_FRAGMENT == false;
  assert ENDPOINT_TO_GATE_MAP_IS_OWNED_HERE == false;
  assert DRIFT_RATE_IS_MEASURED == false;
  assert A_GATE_IS_NOT_DOCUMENTATION == true;
  assert GENERAL_BODY_LIMIT_IS_RESTATED_HERE == false;
}

; --- Invariants -------------------------------------------------------------------------------------

invariant api_surface_a_documented_path_must_be_routed
  assert path_is_consistent(false, true, false) == false and path_is_consistent(false, true, true) == false

invariant api_surface_a_routed_path_must_be_documented_or_exempt
  assert path_is_consistent(true, false, false) == false and path_is_consistent(true, false, true) == true

invariant api_surface_an_exemption_never_creates_a_path
  assert documented_path_is_phantom(false, true) == true and path_is_consistent(false, true, true) == false

invariant api_surface_the_two_directions_never_overlap
  assert routed_path_is_undisclosed(false, true, false) == false and documented_path_is_phantom(true, false) == false

invariant api_surface_today_the_census_closes_on_both_readings
  assert census_closes(API_PATH_COUNT, DOCUMENTED_PATH_COUNT, DOCUMENTED_PATHS_NOT_ROUTED, ROUTED_API_PATHS_NOT_DOCUMENTED) == true and census_closes(API_VERB_PATH_PAIR_COUNT, DOCUMENTED_VERB_PATH_PAIR_COUNT, DOCUMENTED_PAIRS_NOT_ROUTED, ROUTED_API_PAIRS_NOT_DOCUMENTED) == true

invariant api_surface_the_gap_is_real_and_one_directional_today
  assert ROUTED_API_PATHS_NOT_DOCUMENTED > 0 and DOCUMENTED_PATHS_NOT_ROUTED == 0

invariant api_surface_nothing_joins_the_router_to_the_document
  assert surface_has_a_pairing_gate(WIRING_GATE_EXISTS, DOCUMENT_IS_GATED_AGAINST_THE_ROUTER) == false and drift_is_silent(false, DOCUMENT_IS_GATED_AGAINST_THE_ROUTER) == true

invariant api_surface_an_unmatched_path_under_the_nest_is_never_a_success_page
  assert unmatched_api_answer_is_honest(unmatched_api_answer(true, true, true)) == true and a_miss_can_render_as_success(unmatched_api_answer(true, true, true)) == false

invariant api_surface_a_fallback_set_before_a_merge_is_no_fallback
  assert unmatched_api_answer(true, false, true) == ANSWER_SPA_HTML

invariant api_surface_the_html_answer_is_the_one_that_hides_a_dead_endpoint
  assert a_dead_write_shows_a_success_toast(ANSWER_SPA_HTML, true) == true and a_dead_write_shows_a_success_toast(ANSWER_JSON_MISS, true) == false

invariant api_surface_the_law_does_not_reach_the_document_endpoint
  assert miss_law_covers(DOCUMENT_ENDPOINT_IS_UNDER_THE_NEST) == false and absent_path_answers_html(false, DOCUMENT_ENDPOINT_IS_UNDER_THE_NEST, OUTER_FALLBACK_SERVES_SPA) == true

invariant api_surface_the_document_endpoint_is_registered_wherever_a_server_exists
  assert document_endpoint_is_registered(DOCUMENT_FEATURE_IS_IN_THE_DEFAULT_FEATURE_SET, SERVER_BINARY_REQUIRES_THE_BACKEND_FEATURE, BACKEND_FEATURE_ENABLES_THE_DOCUMENT_FEATURE) == true and absent_path_answers_html(DOCUMENT_ENDPOINT_IS_REGISTERED_IN_EVERY_SERVING_BUILD, DOCUMENT_ENDPOINT_IS_UNDER_THE_NEST, OUTER_FALLBACK_SERVES_SPA) == false

invariant api_surface_a_repeated_prefix_is_unreachable_as_written
  assert path_is_reachable_as_written(true) == false

invariant api_surface_the_wiring_gate_cannot_go_blind_unnoticed
  assert wiring_gate_is_awake(0, WIRING_GATE_FLOOR) == false and wiring_gate_is_awake(WIRING_GATE_SUBJECTS_TODAY, WIRING_GATE_FLOOR) == true

invariant api_surface_the_witness_does_not_cover_the_shipped_wiring
  assert witness_would_catch_a_deleted_fallback(WITNESS_BUILDS_THE_SHIPPED_ROUTER) == false

invariant api_surface_declares_no_list_and_no_schema
  assert THIS_FILE_ENUMERATES_THE_PATHS == false and THIS_FILE_CARRIES_A_SCHEMA_FRAGMENT == false and THIS_FILE_DECLARES_NO_HTTP_NUMERAL == true
