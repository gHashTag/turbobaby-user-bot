}

test a_new_welcome_credit_names_no_garden_and_no_welcome_row_is_described {
    assert WELCOME_SENTENCE_NAMES_THE_GARDEN == false;
    assert WELCOME_CREDIT_SENTENCE == "Welcome bonus from a friend's invite";
    assert WELCOME_SENTENCE_NAMED_THE_GARDEN_UNTIL == OWNER_ANSWERS_2026_09_26_AT;
    assert WELCOME_SENTENCE_REUSES_ONE_OF_THE_FOUR == false;
    // Stored, not served: no owner worded it, and no customer copy is invented here.
    assert WELCOME_SENTENCE_IS_SERVED == false;
    assert WELCOME_SENTENCE_WORDED_BY_THE_OWNER == false;
    assert WELCOME_SENTENCE_IS_SERVED == WELCOME_SENTENCE_WORDED_BY_THE_OWNER;
    assert WELCOME_SENTENCE_CHOSEN_BY == "lane";
    assert WELCOME_SENTENCE_AWAITS_THE_OWNER == true;
    assert OWNER_ANSWER_3_DESCRIBED_TX_TYPE_COUNT == 4;
    assert WELCOME_SENTENCE_OLD_ROWS_WITHHELD == true;
    assert WELCOME_SENTENCE_REWRITES_A_ROW == false;
    assert WELCOME_SENTENCE_REWRITES_A_ROW == OWNER_ANSWER_3_WRITES_ROWS;
}

test the_leftovers_of_2026_09_26_are_retired_and_the_ride_is_not_touched {
    assert LEFTOVERS_2026_09_26_AT == "2026-09-26";
    // the four groups make the nineteen, and nothing else went
    assert LEFTOVERS_2026_09_26_GARDEN_KEYS + LEFTOVERS_2026_09_26_PARAPHERNALIA_KEYS + LEFTOVERS_2026_09_26_STRAIN_CARD_KEYS + LEFTOVERS_2026_09_26_FARM_KEYS == LEFTOVERS_2026_09_26_KEYS_DELETED;
    assert LEFTOVERS_2026_09_26_KEYS_DELETED == 19;
    assert LEFTOVERS_2026_09_26_PARITY_LIST_ROWS <= LEFTOVERS_2026_09_26_FARM_KEYS;
    // with ruling #12's fourteen, thirty-three keys of the old shop's copy have left the tables
    assert CANNABIS_RULING_I18N_KEYS_DELETED + LEFTOVERS_2026_09_26_KEYS_DELETED == 33;
    // copy removed, none written, as ruling #12 did it
    assert LEFTOVERS_2026_09_26_SENTENCES_WRITTEN == 0;
    assert LEFTOVERS_2026_09_26_SENTENCES_WRITTEN == CANNABIS_RULING_SENTENCES_INVENTED;
    // answer 2 leaves the ride alone, and answer 7's seven screens stay compiled
    assert LEFTOVERS_2026_09_26_TOUCHES_THE_RIDE_GAME == false;
    assert LEFTOVERS_2026_09_26_UNMOUNTS_OR_DELETES_A_SCREEN == false;
    assert OWNER_ANSWER_REPOINTED_COUNT == 7;
    // nothing stored moves
    assert LEFTOVERS_2026_09_26_WRITES_ROWS == false;
    assert LEFTOVERS_2026_09_26_ADDS_A_MIGRATION == false;
    assert LEFTOVERS_2026_09_26_WRITES_ROWS == OWNER_ANSWER_3_WRITES_ROWS;
    // the word the tea fold spells is not in the bundle, which is why it stays
    assert LEFTOVERS_2026_09_26_FOLD_WORD_IN_BUNDLE == false;
    // the count is another contract's
    assert LEFTOVERS_2026_09_26_KEY_COUNT_OWNER_ID == CANNABIS_RULING_KEY_COUNT_OWNER_ID;
    assert LEFTOVERS_2026_09_26_KEY_COUNT_OWNER_ID != ID;
    assert LEFTOVERS_2026_09_26_WITNESS == "tests/no_cannabis_client_wiring.rs";
}

test the_identity_of_this_contract_is_fixed {
    assert ID == "turbobaby/legacy-retirement";
    assert KIND == "retirement-contract";
    assert ISSUE == "#2";
    assert EPIC == "#26";
    assert DECISIONS == "DECISIONS.md D5, D19";
}

; --- Invariants ---------------------------------------------------------------------------------

invariant a_hidden_row_never_retires_a_reachable_surface
    assert retirement_state(true, false, false, true) == STATE_SURFACE_LIVE and surface_is_retired(true, false, false, true) == false

invariant hiding_data_alone_never_retires_anything
    assert surface_is_retired(false, false, false, true) == false and data_decision_changes_the_surface(true, true) == false

invariant a_reachable_legacy_surface_always_reports_the_same_state
    assert retirement_state(true, true, true, true) == STATE_SURFACE_LIVE and retirement_state(true, false, false, false) == STATE_SURFACE_LIVE

invariant an_allowlisted_reader_is_not_a_retired_surface
    assert retirement_state(false, true, true, false) == STATE_READER_ALLOWLISTED and surface_is_retired(false, true, true, false) == false

invariant the_three_partial_states_stay_three_and_stay_named
    assert PARTIAL_STATE_NAMES.len == PARTIAL_STATE_COUNT and PARTIAL_STATE_COUNT == 3 and STATE_COUNT == 5

invariant a_hiding_migration_that_deletes_a_row_stops_being_one
    assert hiding_migration_is_conformant(1, 0, 6) == false and hiding_migration_is_conformant(0, 1, 6) == false

invariant every_dropped_table_is_accounted_for_on_exactly_one_side
    assert DROPPED_TABLES_WITH_A_SURVIVING_READER + DROPPED_TABLES_WITH_NO_READER == DROPPED_TABLE_COUNT and DROPPED_TABLES.len == DROPPED_TABLE_COUNT

invariant a_kept_reader_without_a_named_reason_is_never_permitted
    assert keeping_is_permitted(true, ALLOWLIST_REASON_MIN_CHARS) == false and keeping_is_permitted(false, 4000) == false

invariant an_allowlist_entry_that_matches_nothing_is_invalid
    assert allowlist_entry_is_valid(true, true, 4000, false) == false and allowlist_is_sound(true, false, true) == false

invariant the_legacy_http_total_cannot_drift_from_its_parts
    assert CATALOG_HTTP_ROUTE_COUNT + QUEST_HTTP_ROUTE_COUNT + TECH_TREE_HTTP_ROUTE_COUNT == LEGACY_HTTP_ROUTE_COUNT

invariant no_surface_is_claimed_gone_while_any_declaration_survives
    assert may_claim_surface_is_gone(1, 0, 0) == false and may_claim_surface_is_gone(0, 1, 0) == false and may_claim_surface_is_gone(0, 0, 1) == false

invariant a_word_count_is_never_absence_evidence
    assert GARDEN_WORD_HITS_IN_CLIENT_ROUTER > 0 and may_claim_surface_is_gone(GARDEN_ROUTE_DECLARATIONS, 0, 0) == true

invariant the_cannabis_ruling_invents_no_sentence_and_drops_no_table
    assert CANNABIS_RULING_SENTENCES_INVENTED == 0 and CANNABIS_RULING_DROPS_A_TABLE == false and CANNABIS_RULING_I18N_KEYS_DELETED_UNRENDERED + CANNABIS_RULING_I18N_KEYS_DELETED_RENDERED == CANNABIS_RULING_I18N_KEYS_DELETED

invariant no_removed_asset_was_one_a_rental_path_loaded
    assert CANNABIS_RULING_REMOVED_FILES_A_RENTAL_PATH_LOADED == 0 and CANNABIS_RULING_SERVED_FILES_REMOVED + CANNABIS_RULING_SERVED_FILES_KEPT == CANNABIS_RULING_SERVED_FILES_BEFORE

invariant an_unreproducible_footprint_figure_is_never_adopted
    assert SURVEY_LOC_CLAIM_REPRODUCED == false and LEGACY_SOURCE_FILE_COUNT < TOTAL_SOURCE_FILE_COUNT

invariant this_file_never_chooses_the_next_surface_or_a_date
    assert next_surface_is_decided_here(true) == false and THIS_FILE_PICKS_THE_NEXT_SURFACE == false and THIS_FILE_CARRIES_A_DELETION_DATE == false and RETIREMENT_ORDER_IS_PUBLISHED == false

invariant the_owners_ruling_never_counts_as_a_completed_retirement
    assert surface_is_retired(false, OWNER_RULING_DROPS_A_TABLE, false, true) == false and OWNER_RULING_COMPLETES_A_RETIREMENT == false and COMPLETED_RETIREMENT_COUNT == 1

invariant a_ruled_surface_a_customer_can_still_reach_is_still_live
    assert ruled_surface_state(true, true) == STATE_SURFACE_LIVE and ruled_surface_state(true, false) == STATE_SURFACE_LIVE and ruled_surface_state(false, OWNER_RULED_EVENTS_ROWS_HIDDEN) == STATE_DATA_HIDDEN

invariant the_repointed_set_is_always_split_by_what_each_path_lost
    assert repointed_set_splits(REPOINTED_WITH_THE_SCREEN_DELETED, REPOINTED_ROUTE_COUNT - REPOINTED_WITH_THE_SCREEN_DELETED) == true and REPOINTED_WITH_THE_SCREEN_DELETED < REPOINTED_ROUTE_COUNT

invariant the_2026_09_25_ruling_never_counts_as_a_completed_retirement
    assert surface_is_retired(false, false, false, TECH_TREE_ROWS_HIDDEN) == false and OWNER_RULING_2026_09_25_DELETES_ROWS == false and OWNER_RULING_2026_09_25_ADDS_A_MIGRATION == false and COMPLETED_RETIREMENT_COUNT == 1

invariant a_kind_no_live_subject_writes_never_has_its_name_printed
    assert report_prints_stored_name(false, true, true, false) == false and report_prints_stored_name(false, false, false, false) == false and report_prints_stored_name(true, false, false, true) == false and PROMO_REPORT_ROWS_HIDDEN == false

invariant a_bike_sale_row_is_never_called_hidden_to_reach_a_state
    assert OWNER_RULED_BIKE_SALE_ROWS_HIDDEN == false and ruled_surface_state(false, OWNER_RULED_BIKE_SALE_ROWS_HIDDEN) == STATE_LIVE and OWNER_RULING_SCOPE_OVER_THE_EIGHT_IS_OPEN_BEFORE_2026_09_25 == true

invariant the_answer_of_2026_09_25_leaves_no_legacy_path_unaccounted_for
    assert owner_answer_covers_the_eight(LEGACY_PATHS_REPOINTED_ON_2026_09_25.len, LEGACY_LIVE_ROUTES.len) == true and LEGACY_PATHS_DECLARED.len == LEGACY_PATH_DECLARED_COUNT and REPOINTED_ROUTE_COUNT == REPOINTED_ROUTE_COUNT_BEFORE_2026_09_25 + REPOINTED_LEGACY_SCREENS_KEPT_UNMOUNTED

invariant the_answer_of_2026_09_25_never_counts_as_a_completed_retirement
    assert surface_is_retired(false, OWNER_ANSWER_DROPS_A_TABLE, false, OWNER_ANSWER_GOODS_ROWS_HIDDEN) == false and surface_is_retired(false, OWNER_ANSWER_DROPS_A_TABLE, false, OWNER_ANSWER_OTHER_ROWS_HIDDEN) == false and OWNER_ANSWER_COMPLETES_A_RETIREMENT == false and COMPLETED_RETIREMENT_COUNT == 1

invariant the_kept_quest_never_states_the_previous_shops_purchase_rule
    assert OWNER_ANSWER_KEEPS_THE_QUEST == true and QUEST_PURCHASE_LINE_RENDERED == false and QUEST_COPY_WRITTEN_NEW == false

invariant the_age_gate_answer_moves_no_stored_data_and_retires_no_surface
    assert AGE_GATE_ANSWER_ADDS_A_MIGRATION == false and AGE_GATE_ANSWER_WRITES_A_ROW == false and AGE_GATE_ANSWER_RENAMES_A_STORAGE_KEY == false and AGE_GATE_ANSWER_IS_A_SURFACE_RETIREMENT == false and COMPLETED_RETIREMENT_COUNT == 1

invariant the_answer_3_hides_what_it_reads_and_writes_nothing
    assert OWNER_ANSWER_3_WRITES_ROWS == false and OWNER_ANSWER_3_ADDS_A_MIGRATION == false and OWNER_ANSWER_3_CHANGES_A_STATE == false and OWNER_ANSWER_3_CHANGES_AN_ADMIN_READ == false

invariant the_answer_3_renames_no_cart_line
    assert OWNER_ANSWER_3_RENAMES_A_CART_LINE == false and OWNER_ANSWER_3_CLIENT_GUARD_COUNT + OWNER_ANSWER_3_CART_GUARDS_REMOVED.len == OWNER_ANSWER_3_CLIENT_GUARD_COUNT_ON_ITS_BRANCH

invariant the_orders_answer_of_2026_09_26_hides_orders_and_writes_nothing
    assert OWNER_ORDERS_ANSWER_HIDES_THE_ORDER == true and OWNER_ORDERS_ANSWER_WRITES_ROWS == false and OWNER_ORDERS_ANSWER_CHANGES_AN_ADMIN_READ == false

; The leftovers of 2026-09-26 went as copy and code, never as data or as a screen.
invariant the_leftovers_of_2026_09_26_remove_copy_and_write_nothing
    assert LEFTOVERS_2026_09_26_WRITES_ROWS == false and LEFTOVERS_2026_09_26_ADDS_A_MIGRATION == false and LEFTOVERS_2026_09_26_SENTENCES_WRITTEN == 0 and LEFTOVERS_2026_09_26_TOUCHES_THE_RIDE_GAME == false

test r1_and_r2_close_the_two_reads_the_critics_pass_left_open {
    assert OWNER_ANSWER_R1_AT == OWNER_ANSWERS_2026_09_26_AT;
    assert OWNER_ANSWER_R2_AT == OWNER_ANSWERS_2026_09_26_AT;
