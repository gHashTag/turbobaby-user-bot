pub fn legacy_source_loc_of_the_list() u16 {
    var total : u16 = 0;
    var i : u8 = 0;
    while (i < LEGACY_SOURCE_FILE_LINES.len) {
        total += LEGACY_SOURCE_FILE_LINES[i];
        i += @as(u8, 1);
    }
    return total;
}

pub fn legacy_source_loc_of_the_list_before_2026_09_25() u16 {
    var total : u16 = 0;
    var i : u8 = 0;
    while (i < LEGACY_SOURCE_FILE_LINES_BEFORE_2026_09_25.len) {
        total += LEGACY_SOURCE_FILE_LINES_BEFORE_2026_09_25[i];
        i += @as(u8, 1);
    }
    return total;
}

pub fn footprint_files_that_moved() u8 {
    var moved : u8 = 0;
    var i : u8 = 0;
    while (i < LEGACY_SOURCE_FILE_LINES.len) {
        if (LEGACY_SOURCE_FILE_LINES[i] != LEGACY_SOURCE_FILE_LINES_BEFORE_2026_09_25[i]) {
            moved += @as(u8, 1);
        }
        i += @as(u8, 1);
    }
    return moved;
}

; --- How each named file is built and reached, in this file's own states ----------------------------
; BUILD (at 55a6664). Fifteen of the 21 are UI files, and every UI file is compiled for the browser
; only: the ui half sits behind turbobaby/webapp-bridge's WASM_GATE_SITE, and the host build that
; `cargo test` runs compiles none of it (that owner's HOST_SUITE_COMPILES_THIS_HALF), so it compiles
; none of the fifteen, and what guards them is the tests that read them as text (tests/rental_only_wiring.rs, tests/no_cannabis_client_wiring.rs). The five
; entities compile with the server (src/lib.rs:107-108, src/main.rs:12-13) and src/trios/packs.rs
; with both halves (src/lib.rs:13, src/main.rs:40); those six are the only ones a Rust test compiles.
; CORRECTED 2026-09-30 (review of round 7): the first sentence cited the wasm32 gate itself, by its
; lines in src/lib.rs, and did not name its owner. NAMED_UI_FILES_COMPILE_ON_THE_HOST below is this
; file's reading of the owner's premise for its fifteen files, not a second copy of the gate.
; --
; REACH. A component is not a surface: it is reached exactly when a screen that mounts it is, and
; that is the whole of the reach input the machine is given for one (component_is_reachable). Each
; group below then runs through retirement_state on its OWN inputs, as the answers of 2026-09-24 and
; 2026-09-25 were, and the precedence decides as it always does. None of the 21 is a completed
; retirement, and none of the states below is new: each is one this file already declared.
; Every src/ and tests/ line cited from here to the tests was opened on 2026-09-29 at 55a6664.
pub const NAMED_UI_FILES : u8 = 15;
pub const NAMED_SERVER_OR_SHARED_FILES : u8 = 6;
pub const NAMED_UI_FILES_COMPILE_ON_THE_HOST : bool = false;
pub const NAMED_UI_FILES_BUILD_PREMISE_OWNER_DECLS : [2]str = ["WASM_GATE_SITE", "HOST_SUITE_COMPILES_THIS_HALF"];

pub fn component_is_reachable(reachable_mounters: u8) bool {
    return reachable_mounters > 0;
}

