pub fn set_card_price_shown(total_thb: i32, total_is_finite: bool) i32 {
    if (!total_is_finite) {
        return 0;
    }
    if (total_thb < 0) {
        return 0;
    }
    return total_thb;
}

; THE PREVIOUS SHOP'S GAME, ITS HUNTS AND BOTH TECH TREES, six files, STATE_LIVE -- which here says
; only that no data moved (OWNER_ANSWER_OTHER_STATE, and TECH_TREE_STATE for the tech tree's rows,
; masked on read). No customer reaches any of them: /game, /treasure-hunt, /ar-hunt,
; /location-quest and /tech-tree render the catalog (LEGACY_PATHS_REPOINTED_ON_2026_09_25),
; src/ui/screens/game_screen.rs mounts only WoodyShop (:15) and BottomNav (:16), and
; src/ui/game/tech_tree.rs has no caller at all.
