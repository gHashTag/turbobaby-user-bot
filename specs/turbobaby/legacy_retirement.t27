; The tech trees, two different things under one word. src/ui/screens/tech_tree_screen.rs reads
; GET /api/tech-tree/nodes (:64), which answers an empty roadmap since ruling #12's server half
; (src/api/tech_tree.rs:30-31), and posts a node completion with the admin token (:224-225).
; src/ui/game/tech_tree.rs is a static TECH_TREE of five growing-themed nodes (:12-48) and a TechTree
; component (:85), neither with a caller; the router's fn TechTree is a separate handler of the same
; name. None of its words is in the shipped bundle: 'Master Grower', 'Basic Growing' and
; 'basic_grow' each give 0 in dist/turbobaby-bot-c57e443e55dc3495_bg.wasm (grep -c -a -F,
; 2026-09-29). It outlived the leftovers review of 2026-09-26 because that guard's FARM_WORDS_EN
; (tests/no_cannabis_client_wiring.rs:969) holds four farm words and none of these. Whether a
; growing-themed tech tree is copy ruling #12 reaches is NOT decided here, as the tea fold's word
; was not (LEFTOVERS_2026_09_26_FOLD_WORD_IN_BUNDLE): recorded, out of the bundle, left.
pub const TECH_TREE_SCREEN_READ : str = "GET /api/tech-tree/nodes";
pub const GROW_TECH_TREE_NODE_IDS : [5]str = ["basic_grow", "soil_boost", "led_lights", "auto_water", "master_grower"];
pub const GROW_TECH_TREE_NODE_COSTS : [5]u16 = [10, 25, 75, 50, 200];
pub const GROW_TECH_TREE_TOTAL_COST : u16 = 360;
pub const GROW_TECH_TREE_CALLERS : u8 = 0;
pub const GROW_TECH_TREE_IN_BUNDLE : bool = false;
pub const FARM_GUARD_WORD_COUNT : u8 = 4;
pub const GROW_TECH_TREE_WORDS_THE_FARM_GUARD_MATCHES : u8 = 0;
pub const GROW_TECH_TREE_RULING_12_REACH_IS_DECIDED_HERE : bool = false;

pub fn read_is_closed_by_r2(route: str) bool {
    var i : u8 = 0;
    while (i < OWNER_R2_CLOSED_READS.len) {
        if (OWNER_R2_CLOSED_READS[i] == route) {
            return true;
        }
        i += @as(u8, 1);
    }
    return false;
}

pub fn hunt_reads_closed_by_r2() u8 {
    var closed : u8 = 0;
    var i : u8 = 0;
    while (i < HUNT_SCREEN_READS.len) {
        if (read_is_closed_by_r2(HUNT_SCREEN_READS[i])) {
            closed += @as(u8, 1);
        }
        i += @as(u8, 1);
    }
    return closed;
}

pub fn grow_tech_tree_total_cost() u16 {
    var total : u16 = 0;
    var i : u8 = 0;
    while (i < GROW_TECH_TREE_NODE_COSTS.len) {
        total += GROW_TECH_TREE_NODE_COSTS[i];
        i += @as(u8, 1);
    }
    return total;
}

; THE KEPT QUEST, two files, STATE_SURFACE_LIVE (OWNER_ANSWER_KEPT_QUEST_STATE). /quest/:id mounts
; src/ui/screens/quest_screen.rs through LazyScreen (src/ui/routes.rs:62, fn Quest at :257-263), and
; the profile links to it (src/ui/screens/profile_screen.rs:956, the id "daily") -- the one
; navigation to it a customer can press, of the four in src/ui. QuestScreen takes the id (:6) and
; never reads it: it renders Quest {} (:9) with no prop, so every id opens the same screen.
; src/ui/game/quest.rs is that screen. What it holds, at 55a6664:
;   * the scan: POST /api/quest/scan (:105) with the Telegram init data (post_json_authed, :107),
;     after polling for the scanned text 120 times at 500 ms (:79-80), a sixty-second window;
;   * a cap on the scanned text (:100-104) that DECIDES on token.len(), which is bytes, and
;     TRUNCATES with chars().take(200), which is characters. The server's bound is
;     turbobaby/validation-bounds' LIVE_TOKEN_MAX_CHARS, measured in bytes there
;     (LIVE_TOKEN_LENGTH_IS_MEASURED_IN_BYTES), and is not restated here. So the cap its comment
;     says mirrors the backend does not: a text of multibyte characters over the cap in bytes but
;     not in characters keeps every character, stays over the bound, and is refused
;     (quest_token_bytes_after_client_cap). DEFECT, measured 2026-09-29, not fixed;
;   * five checkpoints from src/trios/quest.rs (get_checkpoints, :368-376), each shown with a reward
;     of id times 10 (the multiplier at src/trios/quest.rs:345) in a unit spelled BAT in a literal at
;     :258 -- 10 to 50, 150 over the quest -- and on completion the keys T_REWARD_CLAIM and T_REWARD
;     (:179, :182). The reward line is a literal in code; T_QUEST_REWARD_BAT, the key that
;     translates the same text (src/trios/i18n.rs:430, :1094, :1694), is rendered by no screen;
;   * progress is a client signal (:30), advanced by one on ANY successful scan (:116) and stored
;     nowhere. The server's scan (src/api/quest.rs:628-690) runs one SELECT that matches any active
;     location's token (:646), notifies the admins (:670) and answers success with the location; it
;     writes no row and credits nothing. MEASURED 2026-09-29: the reward the screen promises is
;     backed by nothing in this repository -- no BAT balance, table or credit exists under src/ or
;     migrations/ -- and one QR code scanned five times completes the quest. DEFECT, recorded, not
;     fixed: whether the quest should credit anything is the owner's, and the owner kept the screen
;     as it is (OWNER_ANSWER_KEEPS_THE_QUEST);
;   * its loading branch (:218-222) is dead: the signal it reads (:33) is never set.
pub const KEPT_QUEST_FILES : [2]str = ["src/ui/screens/quest_screen.rs", "src/ui/game/quest.rs"];
pub const KEPT_QUEST_FILES_STATE : u8 = 2;
pub const QUEST_SCREEN_READS_ITS_ID : bool = false;
pub const QUEST_ROUTE_NAVIGATIONS : u8 = 4;
pub const QUEST_ROUTE_NAVIGATIONS_A_CUSTOMER_CAN_PRESS : u8 = 1;
pub const QUEST_SCAN_ROUTE : str = "POST /api/quest/scan";
pub const QUEST_SCAN_SENDS_INIT_DATA : bool = true;
pub const QUEST_SCAN_POLL_TRIES : u16 = 120;
pub const QUEST_SCAN_POLL_MS : u16 = 500;
pub const QUEST_SCAN_WINDOW_MS : u16 = 60000;
pub const QUEST_CLIENT_TOKEN_CAP : u16 = 200;
pub const QUEST_CLIENT_CAP_DECIDES_IN_BYTES : bool = true;
pub const QUEST_CLIENT_CAP_TRUNCATES_IN_CHARS : bool = true;
pub const QUEST_CLIENT_CAP_GUARANTEES_THE_SERVER_BOUND : bool = false;
pub const QUEST_SERVER_TOKEN_BOUND_OWNER_DECL : str = "LIVE_TOKEN_MAX_CHARS";
pub const QUEST_SERVER_TOKEN_UNIT_OWNER_DECL : str = "LIVE_TOKEN_LENGTH_IS_MEASURED_IN_BYTES";
pub const QUEST_CHECKPOINT_COUNT : u8 = 5;
pub const QUEST_REWARD_PER_CHECKPOINT_ID : u16 = 10;
pub const QUEST_REWARD_UNIT : str = "BAT";
pub const QUEST_DISPLAYED_REWARD_TOTAL : u16 = 150;
pub const QUEST_COMPLETION_KEYS : [2]str = ["T_REWARD_CLAIM", "T_REWARD"];
pub const QUEST_REWARD_LINE_KEY : str = "T_QUEST_REWARD_BAT";
pub const QUEST_REWARD_LINE_USES_ITS_KEY : bool = false;
pub const QUEST_SCAN_HANDLER_WRITES : u8 = 0;
pub const QUEST_REWARD_IS_CREDITED : bool = false;
pub const QUEST_REWARD_LEDGER_IS_PUBLISHED : bool = false;
pub const QUEST_REWARD_LEDGER_NOTE : str = "No ledger backs the quest's reward. The screen shows id times 10 BAT per checkpoint and a claim line on completion; the scan handler writes no row; the unit BAT is spelled under src/ only in that screen's literal and in the two translations of one key no screen renders (the checkpoint model's field is reward_bat), and under migrations/ not at all. What is missing is the owner's answer to whether a kept quest credits anything, and in what; no amount, unit or ledger is invented here.";
pub const QUEST_PROGRESS_IS_PERSISTED : bool = false;
pub const QUEST_SCAN_IS_TIED_TO_A_CHECKPOINT : bool = false;
pub const QUEST_LOADING_BRANCH_IS_REACHABLE : bool = false;
pub const QUEST_DEFECTS_RECORDED_2026_09_29 : u8 = 3;

pub fn quest_token_bytes_after_client_cap(token_bytes: u16, bytes_per_char: u16) u16 {
    if (token_bytes <= QUEST_CLIENT_TOKEN_CAP) {
        return token_bytes;
    }
    if (bytes_per_char == 0) {
        return token_bytes;
    }
    const chars = token_bytes / bytes_per_char;
    if (chars <= QUEST_CLIENT_TOKEN_CAP) {
        return token_bytes;
    }
    return QUEST_CLIENT_TOKEN_CAP * bytes_per_char;
}

pub fn quest_reward_for_checkpoint(id: u8) u16 {
    return @as(u16, id) * QUEST_REWARD_PER_CHECKPOINT_ID;
}

pub fn quest_displayed_reward_total() u16 {
    var total : u16 = 0;
    var id : u8 = 1;
    while (id <= QUEST_CHECKPOINT_COUNT) {
        total += quest_reward_for_checkpoint(id);
        id += @as(u8, 1);
    }
    return total;
}

pub fn quest_completes(successful_scans: u8, distinct_locations: u8) bool {
    return successful_scans >= QUEST_CHECKPOINT_COUNT;
}

