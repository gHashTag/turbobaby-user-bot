test the_entities_are_readers_and_the_strain_mirror_is_the_allowlisted_case {
    assert LEGACY_ENTITY_FILES.len == FOOTPRINT_ENTITY_FILES;
    assert LEGACY_ENTITY_TABLES.len == FOOTPRINT_ENTITY_FILES;
    assert LEGACY_ENTITY_FIELD_COUNTS.len == FOOTPRINT_ENTITY_FILES;
    assert LEGACY_ENTITY_READER_FILES.len == FOOTPRINT_ENTITY_FILES;
    assert LEGACY_ENTITY_STATES.len == FOOTPRINT_ENTITY_FILES;
    assert LEGACY_ENTITY_TABLES[0] == DROPPED_TABLES[2];
    assert LEGACY_ENTITY_TABLES[1] == HIDDEN_TABLES[1];
    assert LEGACY_ENTITY_TABLES[2] == HIDDEN_TABLES[3];
    assert LEGACY_ENTITY_FIELD_COUNTS[0] == STRAIN_ENTITY_FIELD_COUNT;
    assert STRAIN_ENTITY_FIELD_COUNT == 30;
    assert LEGACY_ENTITY_FIELD_COUNTS[4] == 14;
    // Each on its own inputs.
    assert entity_state(true, LEGACY_ENTITY_READER_FILES[0], false) == LEGACY_ENTITY_STATES[0];
    assert entity_state(false, LEGACY_ENTITY_READER_FILES[1], true) == LEGACY_ENTITY_STATES[1];
    assert entity_state(false, LEGACY_ENTITY_READER_FILES[2], true) == LEGACY_ENTITY_STATES[2];
    assert entity_state(false, LEGACY_ENTITY_READER_FILES[3], false) == LEGACY_ENTITY_STATES[3];
    assert entity_state(false, LEGACY_ENTITY_READER_FILES[4], false) == LEGACY_ENTITY_STATES[4];
    assert LEGACY_ENTITY_STATES[0] == RETIRED_READER_STATE_AFTER_THE_2026_09_25_RULING;
    assert LEGACY_ENTITY_STATES[1] == STATE_DATA_HIDDEN;
    assert LEGACY_ENTITY_STATES[4] == STATE_LIVE;
    // The strain mirror and its three readers are the four allowlist entries.
    assert STRAIN_ENTITY_IS_AN_ALLOWLIST_PATH == true;
    assert LEGACY_ENTITY_READER_FILES[0] + 1 == ALLOWLIST_SIZE;
    // The day its three readers go, the mirror of a dropped table is the completed state.
    assert entity_state(true, 0, false) == STATE_FULLY_RETIRED;
    // Two mirrors with no reader: one allowlisted, one passing the wiring test on a key string.
    assert QUEST_PLACE_ENTITY_IS_ALLOWLISTED_UNWIRED == true;
    assert TREASURE_HUNT_ENTITY_PASSES_THE_WIRING_TEST_BY_A_KEY_STRING == true;
    // The guard is schema-provenance's: its owner is the reuse edge, read by five names since
    // 2026-09-30 (two at the integration), the allowlist the quest mirror's flag reads among them.
    assert ENTITY_GUARD_OWNER_ID == REUSES_SCHEMA_PROVENANCE_ID;
    assert ENTITY_GUARD_DECLARATIONS_READ.len == 5;
    assert ENTITY_GUARD_DECLARATIONS_READ_BEFORE_2026_09_30.len == 2;
    assert ENTITY_GUARD_DECLARATIONS_READ[0] == ENTITY_GUARD_DECLARATIONS_READ_BEFORE_2026_09_30[0];
    assert ENTITY_GUARD_DECLARATIONS_READ[1] == ENTITY_GUARD_DECLARATIONS_READ_BEFORE_2026_09_30[1];
    assert ENTITY_GUARD_DECLARATIONS_READ[2] == QUEST_PLACE_ALLOWLIST_OWNER_DECL;
    assert QUEST_PLACE_ALLOWLIST_OWNER_DECL == "ENTITY_GUARD_ALLOWLIST";
    assert LEGACY_ENTITY_READER_FILES[3] == 0;
    assert LEGACY_ENTITY_READER_FILES[4] == 0;
}

