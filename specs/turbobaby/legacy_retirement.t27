pub const LEGACY_ENTITY_FIELD_COUNTS : [5]u8 = [30, 10, 10, 9, 14];
pub const STRAIN_ENTITY_FIELD_COUNT : u8 = 30;
pub const LEGACY_ENTITY_READER_FILES : [5]u8 = [3, 1, 1, 0, 0];
pub const LEGACY_ENTITY_STATES : [5]u8 = [3, 1, 1, 0, 0];
pub const STRAIN_ENTITY_IS_AN_ALLOWLIST_PATH : bool = true;
pub const QUEST_PLACE_ENTITY_IS_ALLOWLISTED_UNWIRED : bool = true;
pub const TREASURE_HUNT_ENTITY_PASSES_THE_WIRING_TEST_BY_A_KEY_STRING : bool = true;
; RECONCILED 2026-09-29 at the integration of round 7: the flag above is this file's reason for
; resting the mirror's state on LEGACY_ENTITY_READER_FILES[4] == 0 rather than on the guard's
; green. The guard and its defect are turbobaby/schema-provenance's, read by these two names.
; RECONCILED AGAIN 2026-09-30 at the review of round 7: the integration read only half of the guard.
; QUEST_PLACE_ENTITY_IS_ALLOWLISTED_UNWIRED is not a second allowlist; it is this file's reading, on
