    assert OWNER_RULING_2026_09_25_SERVER_SURFACES[0] == "retired_carousel_buttons";
    assert OWNER_RULING_2026_09_25_SERVER_SURFACES[2] == "tech_tree_reads";
    assert OWNER_RULING_2026_09_25_SERVER_SURFACES[6] == "promo_report_names";
    // The tech tree: rows kept, none hidden, masked on read -- the bike-sale shape.
    assert TECH_TREE_ROWS_HIDDEN == OWNER_RULED_BIKE_SALE_ROWS_HIDDEN;
    assert TECH_TREE_MASKED_ON_READ == OWNER_RULED_BIKE_SALE_MASKED_ON_READ;
    assert TECH_TREE_STATE == STATE_LIVE;
    assert ruled_surface_state(false, TECH_TREE_ROWS_HIDDEN) == TECH_TREE_STATE;
    assert A_MASK_ON_READ_HAS_A_STATE_HERE == false;
    // The dropped table's reader stays, allowlisted, so the allowlist does not move.
    assert RETIRED_READER_STATE_AFTER_THE_2026_09_25_RULING == STATE_READER_ALLOWLISTED;
    assert retirement_state(false, true, true, false) == RETIRED_READER_STATE_AFTER_THE_2026_09_25_RULING;
    assert ALLOWLIST_SIZE_MOVED_BY_THE_2026_09_25_RULING == false;
    assert ALLOWLIST_SIZE == 4;
    assert TECH_TREE_HTTP_ROUTE_COUNT == 4;
    assert LEGACY_HTTP_ROUTE_COUNT == 43;
    assert COMPLETED_RETIREMENT_COUNT == 1;
    assert REUSES_BOT_SURFACE_ID == "turbobaby/bot-surface";
}

test the_promo_report_withholds_the_dropped_tables_names_and_keeps_every_row {
    assert PROMO_REPORT_NAME_DECIDED_AT == OWNER_RULING_2026_09_25_AT;
    assert PROMO_REPORT_NAME_DECIDED_BY == "operator, applying the owner's ruling of 2026-09-25 (answer 12)";
    assert PROMO_REPORT_NAME_SITE == "src/promo.rs report";
    assert PROMO_REPORT_NAME_DECISION == "src/trios/promo.rs report_kind_and_name";
    assert PROMO_REPORT_NAME_LABEL == "src/trios/promo.rs REPORT_WITHHELD_NAME";
    assert PROMO_REPORT_NAME_WIRING_TEST == "tests/promo_report_names_wiring.rs";
    assert PROMO_REPORT_READER_COUNT == 2;
    // A live kind with its own link, or with no link and one table behind it: printed.
    assert report_prints_stored_name(true, true, true, false) == true;
    assert report_prints_stored_name(true, true, true, true) == true;
    assert report_prints_stored_name(true, false, false, false) == true;
    // A bestseller whose link opens the dropped table, or with no link to tell: withheld.
    assert report_prints_stored_name(true, true, false, true) == false;
    assert report_prints_stored_name(true, false, false, true) == false;
    // A kind no live subject writes, whatever its link says: withheld.
    assert report_prints_stored_name(false, true, true, false) == false;
    assert report_prints_stored_name(false, false, false, false) == false;
    assert PROMO_REPORT_UNCLASSIFIED_KIND_IS_WITHHELD == true;
    // Rows and totals stay; nothing is written; the send question is another file's.
    assert PROMO_REPORT_ROWS_HIDDEN == false;
    assert PROMO_REPORT_WRITES_THE_TABLE == false;
    assert PROMO_REPORT_ROWS_HIDDEN == OWNER_RULING_2026_09_25_DELETES_ROWS;
    assert PROMO_REPORT_OTHER_TABLES_NAMES_PRINTED == true;
    assert PROMO_PUBLISH_REFUSAL_OWNER_ID != ID;
}

test the_answer_3_masks_reads_and_writes_no_row {
    assert OWNER_ANSWER_3_AT == OWNER_RULING_2026_09_25_AT;
    assert OWNER_ANSWER_3_READ_BY == "operator";
    assert OWNER_ANSWER_3_RULES == "src/trios/legacy_view.rs";
    assert OWNER_ANSWER_3_WITNESS == "tests/legacy_view_wiring.rs";
    assert OWNER_ANSWER_3_LINE_RULE_OWNER_ID != ID;
    assert OWNER_ANSWER_3_SERVER_READS.len == OWNER_ANSWER_3_SERVER_READ_COUNT;
    assert OWNER_ANSWER_3_CLIENT_GUARDS.len == OWNER_ANSWER_3_CLIENT_GUARD_COUNT;
    assert OWNER_ANSWER_3_LEFT_READS.len == OWNER_ANSWER_3_LEFT_READ_COUNT;
    assert OWNER_ANSWER_3_SERVER_READS[0] == "order_lines";
    assert OWNER_ANSWER_3_SERVER_READS[3] == "bonus_descriptions";
    // A garden row reaches an old cached bundle as a generic bonus too: its type is withheld.
    assert OWNER_ANSWER_3_SERVER_READS[4] == "bonus_garden_types";
    assert OWNER_ANSWER_3_SERVER_READ_COUNT == 5;
    assert OWNER_ANSWER_3_WITHHELD_TX_TYPE_COUNT == 2;
    assert OWNER_ANSWER_3_WITHHELD_TX_TYPE_IS_EMPTY == true;
    assert OWNER_ANSWER_3_LEFT_READS[3] == "referral_quest_game_reads";
    assert OWNER_ANSWER_3_LEFT_READ_COUNT == 4;
    assert OWNER_ANSWER_3_CLIENT_GUARDS[1] == "garden_bonus_label";
    assert OWNER_ANSWER_3_CLIENT_GUARD_COUNT == 2;
    // still four: the welcome credit's stored sentence of 2026-09-26 is not served
    assert OWNER_ANSWER_3_DESCRIBED_TX_TYPE_COUNT == 4;
    // Nothing stored moves, and the archive reads it whole.
    assert OWNER_ANSWER_3_WRITES_ROWS == false;
    assert OWNER_ANSWER_3_WRITES_ROWS == OWNER_RULING_2026_09_25_DELETES_ROWS;
    assert OWNER_ANSWER_3_ADDS_A_MIGRATION == false;
    assert OWNER_ANSWER_3_CHANGES_AN_ADMIN_READ == false;
    // A masked read is not a retirement: no state moves.
    assert OWNER_ANSWER_3_CHANGES_A_STATE == false;
    assert COMPLETED_RETIREMENT_COUNT == 1;
    // One key declared for the neutral name; the garden label's key stays.
    assert OWNER_ANSWER_3_KEYS_ADDED == 1;
    assert OWNER_ANSWER_3_KEYS_DELETED == 0;
}

test the_answer_3_cart_path_gave_way_to_the_kept_cart_rule {
    // Reconciled 2026-09-26: a cart line of a retired kind is not served at all, under the
    // neighbour's rule, so this answer renames no cart line and guards no device cart.
    assert OWNER_ANSWER_3_RECONCILED_AT == "2026-09-26";
    assert OWNER_ANSWER_3_CART_RULE_OWNER_ID == "turbobaby/cart-persistence";
    assert OWNER_ANSWER_3_CART_RULE_OWNER_ID != ID;
    assert OWNER_ANSWER_3_RENAMES_A_CART_LINE == false;
    assert OWNER_ANSWER_3_SERVER_READS[2] == "server_cart_lines";
    assert OWNER_ANSWER_3_CART_GUARDS_REMOVED[0] == "device_cart_line_names";
    assert OWNER_ANSWER_3_CART_GUARDS_REMOVED[1] == "device_cart_line_pictures";
    assert OWNER_ANSWER_3_CLIENT_GUARD_COUNT + OWNER_ANSWER_3_CART_GUARDS_REMOVED.len == OWNER_ANSWER_3_CLIENT_GUARD_COUNT_ON_ITS_BRANCH;
    // The two reads left on the branch that the neighbours closed, each with its closer.
    assert OWNER_ANSWER_3_LEFT_READS_CLOSED[0] == "abandoned_cart_reminder";
    assert OWNER_ANSWER_3_LEFT_READS_CLOSED_BY_IDS[0] == "turbobaby/cart-persistence";
    assert OWNER_ANSWER_3_LEFT_READS_CLOSED[1] == "garden_notification_arm";
    assert OWNER_ANSWER_3_LEFT_READS_CLOSED_BY_IDS[1] == "turbobaby/notification-queue";
    assert OWNER_ANSWER_3_LEFT_READS_CLOSED.len == OWNER_ANSWER_3_LEFT_READS_CLOSED_BY_IDS.len;
    assert OWNER_ANSWER_3_LEFT_READ_COUNT + OWNER_ANSWER_3_LEFT_READS_CLOSED.len == OWNER_ANSWER_3_LEFT_READ_COUNT_ON_ITS_BRANCH;
    // Hiding is still not deleting.
    assert OWNER_ANSWER_3_WRITES_ROWS == false;
}

test the_orders_answer_of_2026_09_26_hides_the_previous_shops_orders_and_writes_nothing {
    assert OWNER_ANSWERS_2026_09_26_AT == "2026-09-26";
    assert OWNER_ANSWERS_2026_09_26_AT != OWNER_ANSWER_3_AT;
    assert OWNER_ORDERS_ANSWER_READ_BY == OWNER_ANSWER_3_READ_BY;
    assert OWNER_ORDERS_ANSWER_RULE_OWNER_ID == OWNER_ANSWER_3_LINE_RULE_OWNER_ID;
