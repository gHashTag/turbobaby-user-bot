}

test the_footprint_is_a_list_that_can_be_re_added {
    // 182 until 2026-09-26 and 9193 until 2026-09-25; both re-measured at 55a6664 on 2026-09-29.
    assert TOTAL_SOURCE_FILE_COUNT == 187;
    assert TOTAL_SOURCE_FILE_COUNT_BEFORE_2026_09_26 == 182;
    assert TOTAL_SOURCE_FILE_COUNT > TOTAL_SOURCE_FILE_COUNT_BEFORE_2026_09_26;
    assert LEGACY_SOURCE_FILE_COUNT == 25;
    assert LEGACY_SOURCE_LOC == 8840;
    assert LEGACY_SOURCE_LOC_BEFORE_2026_09_25 == 9193;
    assert legacy_source_loc_of_the_list() == LEGACY_SOURCE_LOC;
    assert legacy_source_loc_of_the_list_before_2026_09_25() == LEGACY_SOURCE_LOC_BEFORE_2026_09_25;
    assert legacy_footprint_is_measured(LEGACY_SOURCE_FILE_COUNT, TOTAL_SOURCE_FILE_COUNT_BEFORE_2026_09_26, LEGACY_SOURCE_LOC_BEFORE_2026_09_25) == true;
    assert legacy_footprint_is_measured(LEGACY_SOURCE_FILE_COUNT, TOTAL_SOURCE_FILE_COUNT, LEGACY_SOURCE_LOC) == true;
    assert legacy_footprint_is_measured(0, TOTAL_SOURCE_FILE_COUNT, LEGACY_SOURCE_LOC) == false;
    assert legacy_footprint_is_measured(LEGACY_SOURCE_FILE_COUNT, TOTAL_SOURCE_FILE_COUNT, 0) == false;
    assert SURVEY_LOC_CLAIM_REPRODUCED == false;
}

