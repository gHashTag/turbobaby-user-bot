invariant the_printed_footprint_always_re_adds_to_its_figure
    assert legacy_source_loc_of_the_list() == LEGACY_SOURCE_LOC and legacy_source_loc_of_the_list_before_2026_09_25() == LEGACY_SOURCE_LOC_BEFORE_2026_09_25 and LEGACY_SOURCE_FILES.len == LEGACY_SOURCE_FILE_COUNT

invariant no_file_named_on_2026_09_29_is_a_completed_retirement
    assert surface_is_retired(false, false, false, GOODS_FILES_ROWS_HIDDEN) == false and surface_is_retired(PACK_MODULE_ROUTE_REACHABLE, false, false, PACK_MODULE_ROWS_HIDDEN) == false and FOOTPRINT_FILES_DELETED == 0 and COMPLETED_RETIREMENT_COUNT == 1

invariant a_component_is_reached_only_through_a_reached_mounter
    assert component_is_reachable(0) == false and component_is_reachable(PRODUCT_DETAIL_MODAL_REACHABLE_MOUNTERS) == false and component_is_reachable(ID_PICKER_MOUNTS) == false

invariant the_kept_quests_reward_stays_recorded_as_unbacked_while_its_scan_writes_nothing
    assert QUEST_SCAN_HANDLER_WRITES == 0 and QUEST_REWARD_IS_CREDITED == false and quest_displayed_reward_total() > 0 and QUEST_REWARD_LEDGER_IS_PUBLISHED == false

invariant a_cap_decided_in_bytes_and_cut_in_characters_never_claims_the_byte_bound
    assert quest_token_bytes_after_client_cap(250, 2) > QUEST_CLIENT_TOKEN_CAP and QUEST_CLIENT_CAP_GUARANTEES_THE_SERVER_BOUND == false

invariant every_hunt_read_is_one_r2_closed
    assert hunt_reads_closed_by_r2() == HUNT_SCREEN_READS.len and HUNT_SCREEN_READS_SENDING_ADMIN_PROOF == 0

invariant the_strain_mirror_and_its_readers_are_the_whole_allowlist
    assert LEGACY_ENTITY_READER_FILES[0] + 1 == ALLOWLIST_SIZE and entity_state(true, LEGACY_ENTITY_READER_FILES[0], false) == STATE_READER_ALLOWLISTED
