test the_repointed_set_is_split_by_what_each_path_lost {
    assert REPOINTED_WITH_THE_SCREEN_DELETED == REPOINTED_ROUTE_COUNT_BEFORE_2026_09_24;
    assert REPOINTED_KEPT_SCREEN_COUNT_OWNER_ID == REUSES_EVENTS_BOOKING_ID;
    assert REPOINTED_KEPT_SCREEN_COUNT_OWNER_DECL == "EVENT_SCREENS_UNROUTED_BY_THE_RULING";
    // Only the whole of the set splits: the deleted half alone is not it, and neither is a kept
    // half that would put the total past REPOINTED_ROUTE_COUNT.
    assert repointed_set_splits(REPOINTED_WITH_THE_SCREEN_DELETED, REPOINTED_ROUTE_COUNT - REPOINTED_WITH_THE_SCREEN_DELETED) == true;
    assert repointed_set_splits(REPOINTED_WITH_THE_SCREEN_DELETED, 0) == false;
    assert repointed_set_splits(REPOINTED_WITH_THE_SCREEN_DELETED, REPOINTED_ROUTE_COUNT) == false;
    // Since 2026-09-25 the kept half is the events screens (their owner's count, passed in) and
    // the seven legacy screens (this file's).
    assert REPOINTED_LEGACY_SCREENS_KEPT_UNMOUNTED == LEGACY_PATHS_REPOINTED_ON_2026_09_25.len;
    assert repointed_kept_half_splits(REPOINTED_ROUTE_COUNT_BEFORE_2026_09_25 - REPOINTED_WITH_THE_SCREEN_DELETED, REPOINTED_LEGACY_SCREENS_KEPT_UNMOUNTED) == true;
    assert repointed_kept_half_splits(REPOINTED_ROUTE_COUNT_BEFORE_2026_09_25 - REPOINTED_WITH_THE_SCREEN_DELETED, 0) == false;
    assert repointed_kept_half_splits(0, REPOINTED_LEGACY_SCREENS_KEPT_UNMOUNTED) == false;
    // A kept path over a kept screen file is never a gone surface, however dark it is.
    assert may_claim_surface_is_gone(1, 1, 1) == false;
}

test the_2026_09_25_ruling_changes_surfaces_and_no_data {
    assert OWNER_RULING_2026_09_25_AT == "2026-09-25";
    assert OWNER_RULING_2026_09_25_ADDS_A_MIGRATION == false;
    assert OWNER_RULING_2026_09_25_DELETES_ROWS == false;
