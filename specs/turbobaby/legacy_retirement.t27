pub fn legacy_footprint_is_measured(files_named: u16, total_files: u16, loc: u16) bool {
    if (files_named == 0 or loc == 0) {
        return false;
    }
    return files_named < total_files;
}

; --- Claiming a surface is gone ------------------------------------------------------------------
; turbobaby/publication's principle, applied to retirement: nothing here claims a surface is gone
; without evidence. The garden route is the one surface that passes -- a search for a garden route
; declaration over src/ returns zero. The trap is the same search run on the bare WORD: the client
; router still carries the word on four LINES (src/ui/routes.rs:57, :58, :61 and :97 -- five
; occurrences, four lines, and the constant below counts lines) because the record of
; the removal lives in comments, exactly as the allowlist witness explains at :177-183 (:176-182
; until 2026-09-26, re-read 2026-09-29). A word
; count is not absence evidence; a declaration count is.
pub const GARDEN_ROUTE_DECLARATIONS : u16 = 0;
pub const GARDEN_WORD_HITS_IN_CLIENT_ROUTER : u16 = 4;
pub const COMPLETED_RETIREMENT_COUNT : u8 = 1;

pub fn may_claim_surface_is_gone(route_declarations: u16, handler_definitions: u16, screen_definitions: u16) bool {
    return route_declarations == 0 and handler_definitions == 0 and screen_definitions == 0;
}

; An orphaned asset is none of the three states: no data was hidden, no table was dropped and no
; route reaches it. It is shipped bytes with one textual reference, and that reference is a
; comment. The asset is assets/game/catch.js, 13270 bytes, and the one textual reference to it
; in shipped source is the comment at assets/game/ride.js:1066 -- a search for the filename over
; the working tree, excluding .git and target/, returns that line and the sibling contract named
; below and nothing else. The count is this file's; whether any code mounts the asset is
; turbobaby/game-score's measurement, consumed here as a boolean rather than re-measured.
pub const ORPHAN_ASSET_TEXT_REFERENCES : u16 = 1;
; REMOVED 2026-09-25, on the owner's ruling recorded below (#12): the orphan was the old shop's catch
; game -- two of its four falling pieces are a leaf and a bud, and its opening comment names the old
; shop's mascot -- so it left assets/ with the rest of the old shop's served media, and git history
; keeps it. The 1 above is the 2026-09-21 reading of a file that no longer exists; the one comment it
; counted, at assets/game/ride.js:1066, still names the file and now names history. asset_is_orphaned
; keeps its meaning for the next orphan; this one is gone rather than orphaned, and whether any code
; mounts a catch-era asset stays turbobaby/game-score's measurement.
pub const ORPHANED_ASSET_REMOVED : bool = true;
pub const ORPHANED_ASSET_REMOVED_AT : str = "2026-09-25";

pub fn asset_is_orphaned(mounted_by_code: bool, code_references: u16, comment_references: u16) bool {
    if (mounted_by_code) {
        return false;
    }
    return code_references == 0 and comment_references > 0;
}

; --- The owner's ruling of 2026-09-25 (#12): nothing cannabis-related anywhere, client half ------
; The owner answered a numbered list on 2026-09-25, and item 12 reads, in translation: everything
; that concerns cannabis must be nowhere. Cannabis heritage is this file's subject (D19, issue #2),
; so the half of the ruling the Mini App carries is recorded here; the server, bot and document
; halves are recorded by the change that makes them. It is a COPY ruling and not a surface ruling:
; it moves no route -- which legacy paths open the catalog instead is item 7 of the same list and is
; not restated here -- and it drops no table and deletes no row. What it changed, measured on the
; tree it was applied to (0526429):
;   * src/trios/i18n.rs lost fourteen keys, deleted outright as the 46 of #2 were. Nine belonged to
;     the retired strain menu and no screen rendered them; five were rendered by the accessories
;     screen -- its smoking-gear subtitle and four paraphernalia filter chips. No replacement
;     sentence was written for any of them. Each deleted line became a comment line, so no line of
;     that file that a contract cites has moved. The declared-key count is owned by
;     turbobaby/locale-policy (TRANSLATION_KEY_COUNT) and moved there, not here.
;   * five rendered arms lost their cannabis half and gained nothing: the checkout age notice in both
;     languages lost its medical-use clause, the success screen's back-to-menu button lost its herb
;     emoji in Russian, and the shop game's herb-delivery event lost its first half in both.
;   * two arms were brought into line with the other language's arm of the same key: the shop game's
;     move log named the old shop's mascot in Russian where the English already named TurboBaby, and
;     the checkout trust heading promised discretion in English where the Russian already asked why
;     people trust the shop. Both now say what their twin says.
;   * nothing that is only an identifier moved. The checkout's saved-draft storage keys keep their
;     old prefix, because renaming a storage key silently discards every customer's saved draft,
;     which D19 already records; key names such as the trust block's are not copy, as
;     turbobaby/customer-surface already says of them.
;   * assets/, which is served at /assets and at /images, lost 128 files of the old shop's media: its
;     strain photographs and videos, its pack and member-card art, the product photographs of its
;     catalogue (the paraphernalia and the goods sold beside it), the garden's fourteen growth
;     sprites, its mascot portrait, and the orphaned catch game above. No rental code path loaded
;     any of them; old migrations still name some of the paths in rows that 083 dropped or 085 hid,
;     and those migrations are not edited (D2). Thirteen files stay: the logo, the brand files, the
;     icons, the two placeholders, the ride game's two scripts and the vendored three.js.
; The 20+ age gate itself is untouched. The server enforces it, turbobaby/checkout-contact records it
; as inherited heritage whose retirement is this file's question, and item 12 did not answer that
; question: it removed the cannabis claim printed beside the gate, not the gate.
; ANSWERED LATER THE SAME DAY, and not by item 12: the owner removed the gate for now in answer 1 of
; a second numbered list (AGE_GATE_ANSWER_* below). The sentence above is kept as the reading of
; ruling #12, which is why CANNABIS_RULING_RETIRES_THE_AGE_GATE stays false; the notice whose
; clause #12 cut went with the rest of the box under the later answer, key and all.
pub const CANNABIS_RULING_AT : str = "2026-09-25";
pub const CANNABIS_RULING_ITEM : str = "#12";
pub const CANNABIS_RULING_NOTE : str = "Nothing cannabis-related anywhere. Client copy: fourteen i18n keys deleted (nine never rendered, five rendered by the accessories screen), five rendered arms cut to their non-cannabis half, two arms aligned with their other-language twin, no sentence invented, no identifier renamed, no route moved, no table dropped. Client media: 128 files of the old shop removed from assets/, none of them loaded by a rental code path.";
