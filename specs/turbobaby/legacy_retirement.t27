test the_kept_quest_is_reached_and_its_cap_measures_in_the_wrong_unit {
    assert QUEST_SCAN_ROUTE == "POST /api/quest/scan";
    assert QUEST_SCAN_SENDS_INIT_DATA == true;
    assert QUEST_SCAN_POLL_TRIES * QUEST_SCAN_POLL_MS == QUEST_SCAN_WINDOW_MS;
    assert QUEST_SCREEN_READS_ITS_ID == false;
    assert QUEST_ROUTE_NAVIGATIONS_A_CUSTOMER_CAN_PRESS == 1;
    assert LEGACY_LIVE_ROUTES[0] == "/quest/:id";
    // One byte a character: the cap holds the text to the cap.
    assert quest_token_bytes_after_client_cap(250, 1) == QUEST_CLIENT_TOKEN_CAP;
    assert quest_token_bytes_after_client_cap(QUEST_CLIENT_TOKEN_CAP, 1) == QUEST_CLIENT_TOKEN_CAP;
    // Two bytes a character: 125 characters are kept whole, 250 bytes stay over the cap.
    assert quest_token_bytes_after_client_cap(250, 2) == 250;
    assert quest_token_bytes_after_client_cap(250, 2) > QUEST_CLIENT_TOKEN_CAP;
    // Three bytes a character: 300 characters are cut to 200, still 600 bytes.
    assert quest_token_bytes_after_client_cap(900, 3) == 600;
    assert QUEST_CLIENT_CAP_DECIDES_IN_BYTES == true;
    assert QUEST_CLIENT_CAP_TRUNCATES_IN_CHARS == true;
    assert QUEST_CLIENT_CAP_GUARANTEES_THE_SERVER_BOUND == false;
    // The server's bound and its unit are the owner's, named by declaration.
    assert QUEST_SERVER_TOKEN_BOUND_OWNER_DECL == "LIVE_TOKEN_MAX_CHARS";
    assert QUEST_SERVER_TOKEN_UNIT_OWNER_DECL == "LIVE_TOKEN_LENGTH_IS_MEASURED_IN_BYTES";
    assert REUSES_VALIDATION_BOUNDS_ID == "turbobaby/validation-bounds";
}

test the_kept_quest_promises_a_reward_nothing_credits {
    assert QUEST_CHECKPOINT_COUNT == 5;
    assert quest_reward_for_checkpoint(1) == QUEST_REWARD_PER_CHECKPOINT_ID;
    assert quest_reward_for_checkpoint(QUEST_CHECKPOINT_COUNT) == 50;
    assert quest_displayed_reward_total() == QUEST_DISPLAYED_REWARD_TOTAL;
    assert QUEST_DISPLAYED_REWARD_TOTAL == 150;
    assert QUEST_REWARD_UNIT == "BAT";
    assert QUEST_COMPLETION_KEYS[0] == "T_REWARD_CLAIM";
    assert QUEST_COMPLETION_KEYS[1] == "T_REWARD";
    assert QUEST_REWARD_LINE_KEY == "T_QUEST_REWARD_BAT";
    assert QUEST_REWARD_LINE_USES_ITS_KEY == false;
    // Shown, and credited by nothing: the scan writes no row, and no ledger is published.
    assert QUEST_SCAN_HANDLER_WRITES == 0;
    assert QUEST_REWARD_IS_CREDITED == false;
    assert QUEST_REWARD_LEDGER_IS_PUBLISHED == false;
    // One location scanned five times completes it; four scans of five places do not.
    assert quest_completes(QUEST_CHECKPOINT_COUNT, 1) == true;
    assert quest_completes(QUEST_CHECKPOINT_COUNT - 1, QUEST_CHECKPOINT_COUNT) == false;
    assert QUEST_SCAN_IS_TIED_TO_A_CHECKPOINT == false;
    assert QUEST_PROGRESS_IS_PERSISTED == false;
    assert QUEST_LOADING_BRANCH_IS_REACHABLE == false;
    // Kept as the owner asked, and nothing written new for it here.
    assert OWNER_ANSWER_KEEPS_THE_QUEST == true;
    assert QUEST_COPY_WRITTEN_NEW == false;
    assert QUEST_DEFECTS_RECORDED_2026_09_29 == 3;
}

