invariant no_welcome_credit_is_written_since_r3
    assert WELCOME_CREDIT_WRITERS == 0 and WELCOME_SENTENCE_IS_SERVED == false

; --- Tests and invariants of the footprint printed on 2026-09-29 ----------------------------------

test the_footprint_is_printed_in_the_headers_order_and_re_adds_to_its_figure {
    assert LEGACY_SOURCE_FILES.len == LEGACY_SOURCE_FILE_COUNT;
    assert LEGACY_SOURCE_FILE_LINES.len == LEGACY_SOURCE_FILE_COUNT;
    assert LEGACY_SOURCE_FILE_LINES_BEFORE_2026_09_25.len == LEGACY_SOURCE_FILE_COUNT;
    // The header's five groups, and the screens are the eight declared paths.
    assert FOOTPRINT_SCREEN_FILES + FOOTPRINT_GAME_MODULE_AND_SET_CARD_FILES + FOOTPRINT_API_MODULE_FILES + FOOTPRINT_ENTITY_FILES + FOOTPRINT_DOMAIN_MODULE_FILES == LEGACY_SOURCE_FILE_COUNT;
    assert FOOTPRINT_SCREEN_FILES == LEGACY_PATH_DECLARED_COUNT;
    assert LEGACY_SOURCE_FILES[0] == "src/ui/screens/accessories_screen.rs";
    assert LEGACY_SOURCE_FILES[2] == "src/ui/screens/quest_screen.rs";
    assert LEGACY_SOURCE_FILES[7] == "src/ui/screens/tech_tree_screen.rs";
    assert LEGACY_SOURCE_FILES[12] == "src/ui/components/set_card.rs";
    assert LEGACY_SOURCE_FILES[13] == "src/api/catalog.rs";
    assert LEGACY_SOURCE_FILES[24] == "src/trios/packs.rs";
    // It reproduces the header's 9193 at the commit that wrote it, and reads 8840 now.
    assert legacy_source_loc_of_the_list_before_2026_09_25() == 9193;
    assert legacy_source_loc_of_the_list() == 8840;
    assert legacy_source_loc_of_the_list() < legacy_source_loc_of_the_list_before_2026_09_25();
    assert FOOTPRINT_FIRST_READ_AT_COMMIT != FOOTPRINT_PRINTED_AT_COMMIT;
    // Five files moved and none left: the drop is edits, not a retirement.
    assert footprint_files_that_moved() == FOOTPRINT_FILES_THAT_MOVED;
    assert FOOTPRINT_FILES_THAT_MOVED == 5;
    assert LEGACY_SOURCE_FILE_LINES[10] == 1662;
    assert LEGACY_SOURCE_FILE_LINES_BEFORE_2026_09_25[10] == 1957;
    assert FOOTPRINT_FILES_DELETED == 0;
    assert COMPLETED_RETIREMENT_COUNT == 1;
}

test twenty_one_files_are_named_here_and_each_falls_in_exactly_one_group {
    assert FOOTPRINT_FILES_NAMED_BY_NO_CONTRACT_AT_55A6664 + FOOTPRINT_FILES_ALREADY_NAMED_AT_55A6664 == LEGACY_SOURCE_FILE_COUNT;
    assert FOOTPRINT_FILES_NAMED_BY_NO_CONTRACT_AT_55A6664 + LEGACY_FILES_OUTSIDE_THE_FOOTPRINT.len == FILES_NAMED_HERE_ON_2026_09_29;
    assert LEGACY_FILES_OUTSIDE_THE_FOOTPRINT_LINES.len == LEGACY_FILES_OUTSIDE_THE_FOOTPRINT.len;
    assert FILES_NAMED_HERE_ON_2026_09_29 < SRC_FILES_NAMED_BY_NO_CONTRACT_AT_55A6664;
    assert SRC_FILES_NAMED_BY_NO_CONTRACT_AT_55A6664 < TOTAL_SOURCE_FILE_COUNT;
    // Goods, the unrouted rest, the kept quest, the entities, the glue, and the one pack module.
    assert GOODS_FILES.len + UNROUTED_NON_GOODS_FILES.len + KEPT_QUEST_FILES.len + LEGACY_ENTITY_FILES.len + GLUE_FILES.len + 1 == FILES_NAMED_HERE_ON_2026_09_29;
    assert GOODS_FILES.len + UNROUTED_NON_GOODS_FILES.len + KEPT_QUEST_FILES.len + GLUE_FILES.len == NAMED_UI_FILES;
    assert LEGACY_ENTITY_FILES.len + 1 == NAMED_SERVER_OR_SHARED_FILES;
    assert NAMED_UI_FILES + NAMED_SERVER_OR_SHARED_FILES == FILES_NAMED_HERE_ON_2026_09_29;
    assert NAMED_UI_FILES_COMPILE_ON_THE_HOST == false;
    // The premise is webapp-bridge's, read by its two declarations (2026-09-30).
    assert NAMED_UI_FILES_BUILD_PREMISE_OWNER_DECLS.len == 2;
    assert NAMED_UI_FILES_BUILD_PREMISE_OWNER_DECLS[0] == "WASM_GATE_SITE";
    assert NAMED_UI_FILES_BUILD_PREMISE_OWNER_DECLS[1] == "HOST_SUITE_COMPILES_THIS_HALF";
    // The groups point into the printed list, not beside it.
    assert GOODS_FILES[0] == LEGACY_SOURCE_FILES[0];
    assert GOODS_FILES[1] == LEGACY_SOURCE_FILES[1];
    assert GOODS_FILES[2] == LEGACY_SOURCE_FILES[12];
    assert GOODS_FILES[3] == LEGACY_FILES_OUTSIDE_THE_FOOTPRINT[0];
    assert GOODS_FILES[4] == LEGACY_FILES_OUTSIDE_THE_FOOTPRINT[1];
    assert UNROUTED_NON_GOODS_FILES[0] == LEGACY_SOURCE_FILES[3];
    assert UNROUTED_NON_GOODS_FILES[4] == LEGACY_SOURCE_FILES[7];
    assert UNROUTED_NON_GOODS_FILES[5] == LEGACY_SOURCE_FILES[11];
    assert KEPT_QUEST_FILES[0] == LEGACY_SOURCE_FILES[2];
    assert KEPT_QUEST_FILES[1] == LEGACY_SOURCE_FILES[9];
    assert LEGACY_ENTITY_FILES[0] == LEGACY_SOURCE_FILES[16];
    assert LEGACY_ENTITY_FILES[4] == LEGACY_SOURCE_FILES[20];
    assert GLUE_FILES[0] == LEGACY_FILES_OUTSIDE_THE_FOOTPRINT[2];
    assert GLUE_FILES[1] == LEGACY_SOURCE_FILES[8];
    assert PACK_MODULE_FILE == LEGACY_SOURCE_FILES[24];
}

test each_named_group_runs_through_the_machine_on_its_own_inputs {
    assert component_is_reachable(0) == false;
    assert component_is_reachable(1) == true;
    // The goods: unreached, over rows 085 hid.
    assert retirement_state(component_is_reachable(GOODS_FILES_REACHABLE_MOUNTERS), false, false, GOODS_FILES_ROWS_HIDDEN) == GOODS_FILES_STATE;
    assert GOODS_FILES_STATE == STATE_DATA_HIDDEN;
    assert GOODS_FILES_STATE == OWNER_ANSWER_GOODS_STATE;
    // The unrouted rest: unreached, and no row moved.
    assert ruled_surface_state(component_is_reachable(UNROUTED_NON_GOODS_REACHABLE_MOUNTERS), UNROUTED_NON_GOODS_ROWS_HIDDEN) == UNROUTED_NON_GOODS_STATE;
    assert UNROUTED_NON_GOODS_STATE == OWNER_ANSWER_OTHER_STATE;
    assert UNROUTED_NON_GOODS_STATE == TECH_TREE_STATE;
    // The kept quest: reached, kept on purpose.
    assert ruled_surface_state(OWNER_ANSWER_KEEPS_THE_QUEST, false) == KEPT_QUEST_FILES_STATE;
    assert KEPT_QUEST_FILES_STATE == OWNER_ANSWER_KEPT_QUEST_STATE;
    // The pack module: a reachable route over hidden rows is a live surface, the header's rule.
    assert retirement_state(PACK_MODULE_ROUTE_REACHABLE, false, false, PACK_MODULE_ROWS_HIDDEN) == PACK_MODULE_STATE;
    assert PACK_MODULE_STATE == STATE_SURFACE_LIVE;
    assert retirement_state(PACK_MODULE_ROUTE_REACHABLE, false, false, PACK_MODULE_ROWS_HIDDEN) == retirement_state(true, false, false, true);
    // None of them is a completed retirement.
    assert surface_is_retired(false, false, false, GOODS_FILES_ROWS_HIDDEN) == false;
    assert surface_is_retired(false, false, false, UNROUTED_NON_GOODS_ROWS_HIDDEN) == false;
    assert surface_is_retired(OWNER_ANSWER_KEEPS_THE_QUEST, false, false, false) == false;
    assert surface_is_retired(PACK_MODULE_ROUTE_REACHABLE, false, false, PACK_MODULE_ROWS_HIDDEN) == false;
    assert COMPLETED_RETIREMENT_COUNT == 1;
}

