; src/ui/components/image_lightbox.rs: MIN_ZOOM 1.0 (:12), MAX_ZOOM 3.0 (:13), ZOOM_STEP 0.5 (:14),
; double-tap toggles to 2.0 from the minimum and back to it from anything above (:41); z-index 1100
; (:47); four hard-coded Russian aria-labels (:51, :79, :89, :95). The corpus has no float, so zoom
; is carried in tenths; the whole-number bounds are what the drift gate reads.
pub const LIGHTBOX_MIN_ZOOM_WHOLE : u8 = 1;
pub const LIGHTBOX_MAX_ZOOM_WHOLE : u8 = 3;
pub const LIGHTBOX_MIN_ZOOM_TENTHS : u8 = 10;
pub const LIGHTBOX_MAX_ZOOM_TENTHS : u8 = 30;
pub const LIGHTBOX_ZOOM_STEP_TENTHS : u8 = 5;
pub const LIGHTBOX_TOGGLE_ZOOM_TENTHS : u8 = 20;
pub const LIGHTBOX_Z_INDEX : u16 = 1100;

pub fn lightbox_zoom_in(zoom_tenths: u8) u8 {
    if (zoom_tenths + LIGHTBOX_ZOOM_STEP_TENTHS > LIGHTBOX_MAX_ZOOM_TENTHS) {
        return LIGHTBOX_MAX_ZOOM_TENTHS;
    }
    return zoom_tenths + LIGHTBOX_ZOOM_STEP_TENTHS;
}

pub fn lightbox_zoom_out(zoom_tenths: u8) u8 {
    if (zoom_tenths < LIGHTBOX_MIN_ZOOM_TENTHS + LIGHTBOX_ZOOM_STEP_TENTHS) {
        return LIGHTBOX_MIN_ZOOM_TENTHS;
    }
    return zoom_tenths - LIGHTBOX_ZOOM_STEP_TENTHS;
}

pub fn lightbox_toggle(zoom_tenths: u8) u8 {
    if (zoom_tenths > LIGHTBOX_MIN_ZOOM_TENTHS) {
        return LIGHTBOX_MIN_ZOOM_TENTHS;
    }
    return LIGHTBOX_TOGGLE_ZOOM_TENTHS;
}

; --- The media URL predicate and its copies -------------------------------------------------------
; Three clauses: http://, https://, or '/' but not '//'. The same clauses are hand-written at 15
; sites in 9 files under src/ui (the grep for starts_with("//") on 2026-09-29; the tree_regex count
; in the drift gate is the instrument). Two of the 15 are in the kit. What is this file's is the
; predicate itself (media_url_is_shown, the canonical is_media_url) and the census of its copies.
; No copy carries a data: clause (MEDIA_PREDICATE_DATA_SCHEME_CLAUSES, bound), so a data: address
; is refused everywhere the predicate is written: it starts with none of the three admitted prefixes.
; What the server's write gate admits into a stored address is turbobaby/catalog-write's
; (WRITE_IMAGE_URL_ADMITTED_PREFIXES, WRITE_IMAGE_URL_ADMITS_A_DATA_URL): it admits data:image/ and
; data:video/, which no copy of this predicate admits, so a stored data: URL the server accepted
; renders the emoji fallback on every card. The rewrite on the admin screen is a third function,
; turbobaby/validation-bounds' (REWRITER_HAS_A_REFUSING_BRANCH), and is neither of the other two.
; CORRECTED 2026-09-30 (review of round 7). Until then this paragraph said two owners "model their
; own copy": turbobaby/legacy-retirement the detail modal's and turbobaby/cart-persistence the cart
; line's, and neither of them named this file. Since that date both read this predicate by name
; (media_url_is_shown, MEDIA_PREDICATE_SITES) and keep only what their site adds -- an emptiness test
; that changes no answer -- and their copies of the clauses are dropped in their own files. And it
; declared the server gate's site and the two data: prefixes itself, a write-side fact with its owner
; named wrongly; both declarations are dropped here (RESTATEMENT_DROPPED_ON_2026_09_30) and read from
; turbobaby/catalog-write.
pub const MEDIA_PREDICATE_CLAUSES : u8 = 3;
pub const MEDIA_PREDICATE_SITE_COUNT : u8 = 15;
pub const MEDIA_PREDICATE_FILE_COUNT : u8 = 9;
pub const MEDIA_PREDICATE_SITES_IN_THE_KIT : u8 = 2;
pub const MEDIA_PREDICATE_SITES : [15]str = [
  "src/ui/components/bike_card.rs:238",
  "src/ui/components/card.rs:86",
  "src/ui/components/card_media.rs:23",
  "src/ui/components/cart_item.rs:20",
  "src/ui/components/product_detail_modal.rs:100",
  "src/ui/components/set_card.rs:273",
  "src/ui/screens/admin_screen.rs:2171",
  "src/ui/screens/admin_screen.rs:2174",
  "src/ui/screens/admin_screen.rs:2338",
  "src/ui/screens/admin_screen.rs:5355",
  "src/ui/screens/catalog_screen.rs:455",
  "src/ui/screens/events_screen.rs:283",
  "src/ui/screens/events_screen.rs:362",
  "src/ui/screens/events_screen.rs:370",
  "src/ui/screens/events_screen.rs:381"
];
pub const MEDIA_PREDICATE_ADMITS_A_DATA_URL : bool = false;
; Bound by gate 3 since 2026-09-30, with a witness on the '//' clause: data: clauses in any copy.
pub const MEDIA_PREDICATE_DATA_SCHEME_CLAUSES : u8 = 0;
; The two copies whose owners read this predicate by name since 2026-09-30, as MEDIA_PREDICATE_SITES
; lists them (indices 3 and 4).
pub const MEDIA_PREDICATE_SITES_READ_BY_THEIR_OWNERS : [2]str = ["src/ui/components/cart_item.rs:20", "src/ui/components/product_detail_modal.rs:100"];
pub const SERVER_URL_GATE_OWNER_DECL : str = "WRITE_IMAGE_URL_ADMITTED_PREFIXES";
pub const SERVER_URL_GATE_DATA_OWNER_DECL : str = "WRITE_IMAGE_URL_ADMITS_A_DATA_URL";
pub const RESTATEMENT_DROPPED_ON_2026_09_30 : [4]str = ["SERVER_URL_GATE_SITE", "SERVER_GATE_PREFIXES_THE_PREDICATE_REFUSES", "LAZY_UNWRAPPED_HANDLERS", "LAZY_UNWRAPPED_CATALOG_ALIASES"];
pub const WRITE_SIDE_REWRITE_OWNER_ID : str = "turbobaby/validation-bounds";
pub const WRITE_SIDE_REWRITE_OWNER_DECL : str = "REWRITER_HAS_A_REFUSING_BRANCH";

pub fn media_url_is_shown(starts_http: bool, starts_https: bool, starts_slash: bool, starts_double_slash: bool) bool {
    return starts_http or starts_https or (starts_slash and !starts_double_slash);
}

