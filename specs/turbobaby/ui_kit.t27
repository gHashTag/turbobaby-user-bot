pub fn lazy_total_delay_ms(heavy: bool, delay_ms: u32) u32 {
    if (heavy) {
        return LAZY_HEAVY_DELAY_MS + LAZY_HEAVY_EXTRA_TICK_MS;
    }
    return delay_ms;
}

