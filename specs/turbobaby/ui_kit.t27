; Tests
; ============================================================================================

test the_reuse_edges_name_owners_and_not_this_file {
  assert REUSES_CUSTOMER_SURFACE_ID == "turbobaby/customer-surface";
  assert REUSES_CLIENT_ERRORS_ID == "turbobaby/client-errors";
  assert REUSES_WEBAPP_BRIDGE_ID == "turbobaby/webapp-bridge";
  assert REUSES_LEGACY_RETIREMENT_ID == "turbobaby/legacy-retirement";
  assert REUSES_AVAILABILITY_ID == "turbobaby/availability";
  assert REUSES_PRICING_HONESTY_ID == "turbobaby/pricing-honesty";
  assert REUSES_LOCALE_POLICY_ID == "turbobaby/locale-policy";
  assert REUSES_VALIDATION_BOUNDS_ID == "turbobaby/validation-bounds";
  assert REUSES_EVENTS_BOOKING_ID == "turbobaby/events-booking";
  assert REUSES_ORDER_PRESENTATION_ID == "turbobaby/order-presentation";
  assert REUSES_CART_PERSISTENCE_ID == "turbobaby/cart-persistence";
  assert REUSES_CUSTOMER_SURFACE_ID != ID;
  assert REUSES_LEGACY_RETIREMENT_ID != ID;
  assert MONEY_HELPER_RULE_OWNER_ID == REUSES_PRICING_HONESTY_ID;
  assert WRITE_SIDE_REWRITE_OWNER_ID == REUSES_VALIDATION_BOUNDS_ID;
  assert REUSE_EDGE_COUNT_BEFORE_2026_09_30 == 11;
  assert REUSE_EDGE_COUNT == REUSE_EDGE_COUNT_BEFORE_2026_09_30 + 1;
  assert REUSES_CATALOG_WRITE_ID == "turbobaby/catalog-write";
  assert CART_PERSISTENCE_OWNS != CART_PERSISTENCE_OWNS_BEFORE_2026_09_30;
}

test the_nineteen_files_add_up_to_the_measured_lines {
  assert KIT_FILES.len == KIT_FILE_COUNT;
  assert KIT_FILE_LINES.len == KIT_FILE_COUNT;
  assert sum19(KIT_FILE_LINES) == KIT_SOURCE_LINES;
  assert KIT_PRIMITIVE_COUNT + KIT_GLUE_FILE_COUNT + KIT_THEME_FILE_COUNT == KIT_FILE_COUNT;
  assert KIT_FILES[17] == MODULE_LIST;
  assert KIT_FILES[18] == THEME_MODULE;
  assert KIT_FILES[12] == "src/ui/components/lazy_screen.rs";
}

test nothing_in_the_kit_is_compiled_by_the_host_suite {
  assert KIT_CFG_TEST_MODULES == 0;
  assert KIT_IS_COMPILED_BY_THE_HOST_SUITE == false;
  assert VIDEO_MUTE_HOST_BRANCH_IS_EVER_COMPILED == false;
  assert METHOD_TOKENS_VISIBLE_TO_THE_HOST_TEST == 0;
}

test the_module_file_splits_into_kit_and_domain_entries {
  assert GLUE_KIT_MODULE_COUNT + GLUE_DOMAIN_MODULE_COUNT == GLUE_PUB_MOD_COUNT;
  assert GLUE_KIT_MODULE_COUNT == KIT_PRIMITIVE_COUNT;
  assert GLUE_DOMAIN_MODULE_NAMES.len == GLUE_DOMAIN_MODULE_COUNT;
  assert GLUE_PUB_MOD_COUNT - GLUE_MODULES_WITHOUT_A_REEXPORT + GLUE_TYPE_ALIASES == GLUE_PUB_USE_COUNT;
  assert GLUE_DOMAIN_MODULE_NAMES[2] == "bottom_nav";
  assert GLUE_HEADER_CLAIMS_AUTO_GENERATION == true and GLUE_GENERATOR_IS_IN_THE_TREE == false;
}

test the_money_reexport_is_published_and_reached_by_no_one {
  assert MONEY_HELPER_REEXPORTS.len == 3;
  assert MONEY_HELPER_REEXPORT_PATH_USES == 0;
  assert BRIEF_SAID_THE_MONEY_REEXPORT_IS_USED == true;
  assert MONEY_HELPER_RULE_OWNER_DECL == "SHAPE_DASH";
}

test the_reach_rule_puts_each_input_combination_in_one_class {
  assert reach_class(false, false, true) == REACH_NO_LIVE_SITE;
  assert reach_class(false, false, false) == REACH_NO_LIVE_SITE;
  assert reach_class(true, false, false) == REACH_SITE_NEVER_RENDERS;
  assert reach_class(false, true, false) == REACH_SITE_NEVER_RENDERS;
  assert reach_class(true, true, true) == REACH_CUSTOMER_ROUTE;
  assert reach_class(true, false, true) == REACH_CUSTOMER_ROUTE;
  assert reach_class(false, true, true) == REACH_ADMIN_ROUTE_ONLY;
  assert reach_class_is_known(REACH_NO_LIVE_SITE) == true;
  assert reach_class_is_known(0) == false;
  assert reach_class_is_known(REACH_CLASS_COUNT + 1) == false;
}

test a_legacy_mounter_is_no_live_site_by_legacy_retirements_own_input {
  assert LEGACY_MOUNTER_IS_REACHED == false;
  assert reach_class(LEGACY_MOUNTER_IS_REACHED, false, true) == REACH_NO_LIVE_SITE;
  assert reach_class(BUTTON_RENDERER_IS_REACHED, false, true) == REACH_NO_LIVE_SITE;
  assert LEGACY_MOUNTER_REACH_OWNER_ID == REUSES_LEGACY_RETIREMENT_ID;
  assert LEGACY_MOUNTER_REACH_OWNER_DECLS.len == 4;
  assert LEGACY_MOUNTER_REACH_RULE_DECL == "component_is_reachable";
  assert BUTTON_RENDERER_REACH_OWNER_DECLS.len == 2;
  assert KIT_PRIMITIVE_NAMES[4] == "ImageLightbox";
  assert KIT_PRIMITIVE_REACH[4] == REACH_NO_LIVE_SITE;
}

test the_census_rows_are_derived_from_their_measured_inputs {
  assert KIT_PRIMITIVE_NAMES.len == KIT_PRIMITIVE_COUNT;
  assert KIT_PRIMITIVE_REACH.len == KIT_PRIMITIVE_COUNT;
  assert KIT_REACH_EVIDENCE.len == KIT_PRIMITIVE_COUNT;
  assert reach_rows_follow_from_their_inputs() == true;
}

test the_census_counts_renders_and_the_brief_counted_sites {
  assert count_reach(KIT_PRIMITIVE_REACH, REACH_CUSTOMER_ROUTE) == PRIMITIVES_RENDERING_ON_A_CUSTOMER_ROUTE;
  assert count_reach(KIT_PRIMITIVE_REACH, REACH_ADMIN_ROUTE_ONLY) == PRIMITIVES_RENDERING_ON_ADMIN_ONLY;
  assert count_reach(KIT_PRIMITIVE_REACH, REACH_SITE_NEVER_RENDERS) == PRIMITIVES_WITH_A_SITE_THAT_NEVER_RENDERS;
  assert count_reach(KIT_PRIMITIVE_REACH, REACH_NO_LIVE_SITE) == PRIMITIVES_WITH_NO_LIVE_SITE;
  assert PRIMITIVES_RENDERING_ON_A_CUSTOMER_ROUTE + PRIMITIVES_RENDERING_ON_ADMIN_ONLY == PRIMITIVES_THAT_CAN_RENDER;
  assert PRIMITIVES_THAT_CAN_RENDER + PRIMITIVES_WITH_A_SITE_THAT_NEVER_RENDERS == PRIMITIVES_WITH_A_LIVE_MOUNT_SITE;
  assert PRIMITIVES_WITH_A_LIVE_MOUNT_SITE + PRIMITIVES_WITH_NO_LIVE_SITE == KIT_PRIMITIVE_COUNT;
  assert BRIEF_MOUNTED_PRIMITIVE_COUNT == PRIMITIVES_WITH_A_LIVE_MOUNT_SITE;
  assert BRIEF_UNMOUNTED_PRIMITIVE_COUNT == PRIMITIVES_WITH_NO_LIVE_SITE;
  assert BRIEF_MOUNTED_PRIMITIVE_COUNT != PRIMITIVES_THAT_CAN_RENDER;
}

test the_theme_has_no_caller {
  assert THEME_EXPORT_FILES == 1;
  assert THEME_EXPORT_CALLERS == 0;
}

test heavy_replaces_the_callers_delay_and_adds_one_tick {
  assert lazy_total_delay_ms(false, LAZY_DEFAULT_DELAY_MS) == 16;
  assert lazy_total_delay_ms(true, LAZY_DEFAULT_DELAY_MS) == 96;
  assert lazy_total_delay_ms(true, 500) == lazy_total_delay_ms(true, 0);
  assert lazy_total_delay_ms(false, 500) == 500;
  assert LAZY_HEAVY_EXTRA_TICK_MS == LAZY_DEFAULT_DELAY_MS;
}

test the_router_wraps_eleven_handlers_and_one_of_them_heavy {
  assert LAZY_WRAPPED_HANDLER_NAMES.len == LAZY_WRAPPED_HANDLERS;
  assert LAZY_HEAVY_HANDLER_NAMES.len == LAZY_HEAVY_HANDLERS;
  assert LAZY_WRAPPED_HANDLER_NAMES[10] == LAZY_HEAVY_HANDLER_NAMES[0];
  assert LAZY_CALLERS_PASSING_DELAY_MS == 0;
  // The header's "all screens" is refuted by this file's own three names, without the owners' counts.
  assert ROUTES_HEADER_SAYS_ALL_SCREENS_ARE_WRAPPED == true and LAZY_UNWRAPPED_NON_CATALOG_HANDLER_NAMES.len > 0;
  assert LAZY_UNWRAPPED_NON_CATALOG_HANDLER_NAMES[0] == "Ride";
  assert LAZY_UNWRAPPED_NON_CATALOG_HANDLER_NAMES[2] == "NotFound";
  assert ROUTER_SIZE_OWNER_DECL == "ROUTER_DECLARED_ROUTES";
  assert CATALOG_ONLY_HANDLERS_OWNER_DECL == "REPOINTED_ROUTE_COUNT";
  assert LAZY_DOC_NAMES_HEAVY_SCREENS > LAZY_HEAVY_HANDLERS;
  assert LAZY_SCREEN_MOUNTS_THE_SKELETON_COMPONENT == false;
  assert BRIEF_SAID_LAZY_SCREEN_USES_SKELETON != LAZY_SCREEN_MOUNTS_THE_SKELETON_COMPONENT;
}

test skeleton_callers_split_into_live_legacy_and_events {
  assert SKELETON_CALLER_FILES_LIVE + SKELETON_CALLER_FILES_KEPT_UNMOUNTED_LEGACY + SKELETON_CALLER_FILES_UNROUTED_EVENTS == SKELETON_CALLER_FILES;
  assert SKELETON_SHAPES_NAMED_AT_A_CALL_SITE + SKELETON_SHAPES_NEVER_REQUESTED.len == SKELETON_SHAPE_COUNT;
  assert SKELETON_ROW_CALLERS == 0;
  assert METHOD_TOKEN_COUNTS[6] == SKELETON_SHAPE_COUNT;
  assert METHOD_TOKENS_WITHOUT_A_RULE[6] == 0;
}

test card_medias_video_branch_is_not_live {
  assert video_branch_is_live(CARD_MEDIA_LIVE_MOUNTS, CARD_MEDIA_LIVE_MOUNTS_PASSING_NO_VIDEO) == false;
  assert video_branch_is_live(CARD_MEDIA_LIVE_MOUNTS, CARD_MEDIA_LIVE_MOUNTS_PASSING_NO_VIDEO - 1) == true;
  assert BIKE_DTO_VIDEO_FIELDS == 0;
  assert CARD_MEDIA_LIVE_MOUNTS_WITH_A_FIXED_RATIO == CARD_MEDIA_LIVE_MOUNTS;
  assert CARD_MEDIA_AUTOPLAY_ATTRIBUTES.len == 4;
  assert KIT_PRIMITIVE_REACH[8] == REACH_SITE_NEVER_RENDERS;
  assert VIDEO_MUTE_CALL_SITES == 2 and VIDEO_MUTE_PROPERTIES_SET == 3 and VIDEO_MUTE_REISSUES_PLAY == true;
}

test the_admin_video_player_needs_a_video_and_an_open_modal {
  assert video_modal_can_render(ITEM_ROW_MOUNTS_PASSING_A_VIDEO > 0, VIDEO_MODAL_OPENERS_THAT_CLOSE_ITS_MODAL == 0, MODAL_RENDERS_WHEN_CLOSED) == false;
  assert video_modal_can_render(true, false, false) == false;
  assert video_modal_can_render(false, true, true) == false;
  assert video_modal_can_render(true, true, false) == true;
  assert video_modal_can_render(true, false, true) == true;
  assert ITEM_ROW_MOUNTS == 1 and ITEM_ROW_MOUNTS_PASSING_A_VIDEO == 0;
  assert VIDEO_MODAL_LIVE_MOUNT_SITES == 1 and VIDEO_MODAL_MOUNT_SITES == 4;
  assert KIT_PRIMITIVE_REACH[7] == REACH_SITE_NEVER_RENDERS;
}

test the_smaller_counts_close_against_their_neighbours {
  assert LOADING_CLASS_NAMES_WITHOUT_A_RULE == LOADING_SIZE_COUNT + 3;
  assert CARD_MEDIA_LIVE_MOUNTS + CARD_MEDIA_LEGACY_MOUNTS == 4;
  assert CARD_MEDIA_FREE_HEIGHT_MIN_PX == 180;
  assert UNCALLED_PRIMITIVE_COMPONENTS.len == PRIMITIVES_WITH_NO_LIVE_SITE - 3 + 2;
  assert MOUNT_SITES_OF_THE_UNCALLED_PRIMITIVES == 0;
  assert STYLE_SHEETS_LINKED_BY_INDEX_HTML == STYLE_SHEETS_READ.len - 1;
  assert STYLE_SHEETS_READ[2] == "styles/simple.css";
}

test the_video_modal_doc_names_sites_that_no_longer_mount_it {
  assert VIDEO_MODAL_DOC_NAMED_COPY_SITES == 4;
  assert VIDEO_MODAL_DOC_NAMED_SITES_STILL_MOUNTING == 2;
  assert VIDEO_MODAL_MOUNT_SITES - VIDEO_MODAL_DOC_NAMED_SITES_STILL_MOUNTING == 2;
}

test the_lightbox_zoom_is_bounded_and_toggles_between_fit_and_double {
  assert LIGHTBOX_MIN_ZOOM_TENTHS == LIGHTBOX_MIN_ZOOM_WHOLE * 10;
  assert LIGHTBOX_MAX_ZOOM_TENTHS == LIGHTBOX_MAX_ZOOM_WHOLE * 10;
  assert lightbox_zoom_in(LIGHTBOX_MAX_ZOOM_TENTHS) == LIGHTBOX_MAX_ZOOM_TENTHS;
  assert lightbox_zoom_in(LIGHTBOX_MIN_ZOOM_TENTHS) == 15;
  assert lightbox_zoom_out(LIGHTBOX_MIN_ZOOM_TENTHS) == LIGHTBOX_MIN_ZOOM_TENTHS;
  assert lightbox_zoom_out(25) == 20;
  assert lightbox_toggle(LIGHTBOX_MIN_ZOOM_TENTHS) == LIGHTBOX_TOGGLE_ZOOM_TENTHS;
  assert lightbox_toggle(15) == LIGHTBOX_MIN_ZOOM_TENTHS;
  assert (LIGHTBOX_MAX_ZOOM_TENTHS - LIGHTBOX_MIN_ZOOM_TENTHS) / LIGHTBOX_ZOOM_STEP_TENTHS == 4;
  assert LIGHTBOX_Z_INDEX > VIDEO_MODAL_Z_INDEX;
}

; Renamed 2026-09-30 (was the_media_predicate_refuses_protocol_relative_and_data_urls, whose data half
; was a flag compared with its own literal). The data half now goes through the function: a data:
; address starts with none of http://, https:// and '/', so it reaches the predicate as four false
; answers, and the gate-bound count of data: clauses in the copies is zero.
test the_media_predicate_refuses_protocol_relative_urls_and_has_no_data_clause {
  assert media_url_is_shown(false, false, true, false) == true;
  assert media_url_is_shown(false, false, true, true) == false;
  assert media_url_is_shown(true, false, false, false) == true;
  assert media_url_is_shown(false, true, false, false) == true;
  assert media_url_is_shown(false, false, false, false) == false;
  assert MEDIA_PREDICATE_DATA_SCHEME_CLAUSES == 0;
  assert MEDIA_PREDICATE_ADMITS_A_DATA_URL == false and MEDIA_PREDICATE_DATA_SCHEME_CLAUSES == 0;
  assert MEDIA_PREDICATE_CLAUSES == 3;
}

test the_predicate_copies_are_listed_one_per_site {
  assert MEDIA_PREDICATE_SITES.len == MEDIA_PREDICATE_SITE_COUNT;
  assert MEDIA_PREDICATE_SITES[1] == "src/ui/components/card.rs:86";
  assert MEDIA_PREDICATE_SITES[2] == "src/ui/components/card_media.rs:23";
  assert MEDIA_PREDICATE_SITES_IN_THE_KIT == 2;
  assert MEDIA_PREDICATE_FILE_COUNT < MEDIA_PREDICATE_SITE_COUNT;
}

; Two copies are read back by their owners (2026-09-30): each is an element of the census, and the
; write side of a stored address is read from catalog-write, not declared here.
test two_owners_read_the_predicate_by_name_and_the_write_side_is_catalog_writes {
  assert MEDIA_PREDICATE_SITES_READ_BY_THEIR_OWNERS[0] == MEDIA_PREDICATE_SITES[3];
  assert MEDIA_PREDICATE_SITES_READ_BY_THEIR_OWNERS[1] == MEDIA_PREDICATE_SITES[4];
  assert MEDIA_PREDICATE_SITES_READ_BY_THEIR_OWNERS.len < MEDIA_PREDICATE_SITE_COUNT;
  assert REUSES_CATALOG_WRITE_ID == "turbobaby/catalog-write";
  assert REUSES_CATALOG_WRITE_ID != ID;
  assert SERVER_URL_GATE_OWNER_DECL == "WRITE_IMAGE_URL_ADMITTED_PREFIXES";
  assert SERVER_URL_GATE_DATA_OWNER_DECL == "WRITE_IMAGE_URL_ADMITS_A_DATA_URL";
  assert RESTATEMENT_DROPPED_ON_2026_09_30.len == 4;
  assert RESTATEMENT_DROPPED_ON_2026_09_30[0] == "SERVER_URL_GATE_SITE";
  assert RESTATEMENT_DROPPED_ON_2026_09_30[1] == "SERVER_GATE_PREFIXES_THE_PREDICATE_REFUSES";
  assert RESTATEMENT_DROPPED_ON_2026_09_30[2] == "LAZY_UNWRAPPED_HANDLERS";
  assert RESTATEMENT_DROPPED_ON_2026_09_30[3] == "LAZY_UNWRAPPED_CATALOG_ALIASES";
  assert WRITE_SIDE_REWRITE_OWNER_ID != REUSES_CATALOG_WRITE_ID;
}

test every_modal_mount_names_its_dialog {
  assert MODAL_SIZE_CLASSES.len == MODAL_SIZE_COUNT;
  assert MODAL_SIZE_CLASSES_WITH_A_RULE == MODAL_SIZE_COUNT;
  assert MODAL_MOUNTS_PASSING_A_TITLE == MODAL_MOUNT_SITES;
  assert MODAL_RENDERS_WHEN_CLOSED == false;
}

test the_admin_toast_shows_the_hardcoded_title {
  assert TOAST_KIND_COUNT == 4;
  assert TOAST_CLASS_TOKENS == METHOD_TOKEN_COUNTS[7];
  assert METHOD_TOKENS_WITHOUT_A_RULE[7] == 0;
  assert TOAST_MOUNT_PASSES_A_TITLE == false;
  assert TOAST_HARDCODED_CYRILLIC_LITERALS == TOAST_KIND_COUNT + 1;
  assert TOAST_CONTAINER_Z_INDEX > LIGHTBOX_Z_INDEX;
}

test the_cart_asks_for_a_glass_class_nothing_styles {
  assert EMPTY_STATE_MOUNT_SITES == EMPTY_STATE_ADMIN_MOUNT_SITES + 1;
  assert EMPTY_STATE_ADMIN_OCCURRENCES_WITH_THE_IMPORT == EMPTY_STATE_ADMIN_MOUNT_SITES + 1;
  assert BRIEF_EMPTY_STATE_ADMIN_USES == EMPTY_STATE_ADMIN_OCCURRENCES_WITH_THE_IMPORT;
  assert EMPTY_STATE_MOUNTS_ASKING_FOR_GLASS == 1;
  assert CARD_GLASS_RULES_IN_STYLES == 0;
  assert CARD_GLASS_RULED_AT_THE_PARENT_OF_158500B == true;
  assert RULELESS_KIT_CLASSES_RENDERED_ON_A_LIVE_ROUTE[0] == EMPTY_STATE_GLASS_CLASS;
  assert UNSTYLED_METHOD_TOKENS[14] == EMPTY_STATE_GLASS_CLASS;
}

test the_unmounted_primitives_render_through_no_live_file {
  assert BUTTON_RENDER_FILES_WITH_A_LIVE_SITE == 0;
  assert BUTTON_RENDER_SITES == 4 and BUTTON_RENDER_FILES == 2;
  assert BUTTON_ONCLICK_DEFAULT_DOES_NOTHING == true;
  assert BUTTON_ONCLICK_DEFAULT_SITE == "src/ui/components/button.rs:84-85 (at 55a6664)";
  assert KIT_PRIMITIVE_REACH[0] == REACH_NO_LIVE_SITE;
  assert CHIP_CLASS_NAMES_WITH_A_RULE == 0 and CHIP_CLASS_NAMES == 8;
  assert RARITY_TAG_PROP_IS_READ == false;
  assert progress_max(0) == PROGRESS_DEFAULT_MAX;
  assert progress_max(40) == 40;
}

test the_variant_counts_match_the_token_counts {
  assert METHOD_TOKEN_COUNTS[0] == BUTTON_VARIANT_COUNT + 2;
  assert METHOD_TOKEN_COUNTS[1] == CARD_VARIANT_COUNT + 1;
  assert METHOD_TOKEN_COUNTS[2] == BADGE_VARIANT_COUNT + 1 + (BADGE_SIZE_COUNT - 1);
  assert METHOD_TOKEN_COUNTS[3] == CHIP_COLOR_COUNT;
  assert METHOD_TOKEN_COUNTS[4] == PROGRESS_COLOR_COUNT + (PROGRESS_SIZE_COUNT - 1);
  assert METHOD_TOKEN_COUNTS[5] == RARITY_TIER_COUNT + 1;
  assert BADGE_VARIANTS_WITH_A_DEFAULT_ICON == BADGE_VARIANT_COUNT - 1;
  assert INPUT_TYPE_COUNT == 4 and LOADING_SIZE_COUNT == 3 and BUTTON_SIZE_COUNT == 4;
}

test the_class_vocabulary_totals_close {
  assert METHOD_TOKEN_FILES.len == METHOD_TOKEN_FILE_COUNT;
  assert sum8(METHOD_TOKEN_COUNTS) == METHOD_TOKEN_TOTAL;
  assert sum8(METHOD_TOKENS_WITHOUT_A_RULE) == METHOD_TOKENS_WITHOUT_A_RULE_TOTAL;
  assert METHOD_TOKENS_WITHOUT_A_RULE_TOTAL + METHOD_TOKENS_WITH_A_RULE_TOTAL == METHOD_TOKEN_TOTAL;
  assert UNSTYLED_METHOD_TOKENS.len == METHOD_TOKENS_WITHOUT_A_RULE_TOTAL;
  assert UNSTYLED_METHOD_TOKEN_RULES_IN_STYLES == 0;
}

test every_unstyled_method_token_sits_where_nothing_renders_it {
  assert unstyled_tokens_on_a_live_site(METHOD_TOKENS_WITHOUT_A_RULE, METHOD_TOKEN_FILE_REACH) == 0;
  assert unstyled_tokens_on_a_live_site(METHOD_TOKENS_WITH_A_RULE, METHOD_TOKEN_FILE_REACH) == METHOD_TOKEN_COUNTS[6] + METHOD_TOKEN_COUNTS[7];
  assert sum8(METHOD_TOKENS_WITH_A_RULE) == METHOD_TOKENS_WITH_A_RULE_TOTAL;
  assert METHOD_TOKEN_FILE_REACH[0] == KIT_PRIMITIVE_REACH[0];
  assert METHOD_TOKEN_FILE_REACH[6] == KIT_PRIMITIVE_REACH[15];
  assert METHOD_TOKEN_FILE_REACH[7] == KIT_PRIMITIVE_REACH[16];
}

test the_brief_left_skeleton_out_of_its_token_count {
  assert BRIEF_METHOD_TOKEN_TOTAL == METHOD_TOKEN_TOTAL - METHOD_TOKEN_COUNTS[6];
  assert BRIEF_METHOD_TOKEN_FILE_COUNT == METHOD_TOKEN_FILE_COUNT - 1;
}

; The brief is not a source: it is unpublished, and each of its figures that this file keeps
; disagrees with, or is a different count from, the measured declaration beside it.
test the_brief_is_unpublished_and_every_figure_kept_from_it_is_answered_by_a_measurement {
  assert BRIEF_IS_PUBLISHED == false;
  assert BRIEF_FIGURES_ARE_MEASUREMENTS == false;
  assert BRIEF_SOURCE == "the task brief handed to the round-7 ui-kit lane on 2026-09-29; not in the repository";
  assert BRIEF_METHOD_TOKEN_TOTAL != METHOD_TOKEN_TOTAL;
  assert BRIEF_METHOD_TOKEN_FILE_COUNT != METHOD_TOKEN_FILE_COUNT;
  assert BRIEF_EMPTY_STATE_ADMIN_USES != EMPTY_STATE_ADMIN_MOUNT_SITES;
  assert BRIEF_MOUNTED_PRIMITIVE_COUNT != PRIMITIVES_THAT_CAN_RENDER;
  assert BRIEF_THEME_TOKENS_DIFFERING != THEME_TOKENS_COLOUR_DIFFERS;
  assert BRIEF_SAID_LAZY_SCREEN_USES_SKELETON != LAZY_SCREEN_MOUNTS_THE_SKELETON_COMPONENT;
  assert BRIEF_SAID_THE_MONEY_REEXPORT_IS_USED == true and MONEY_HELPER_REEXPORT_PATH_USES == 0;
}

test the_unstyled_tokens_were_styled_before_one_commit {
  assert UNSTYLED_TOKENS_RULED_AT_THE_PARENT_OF_158500B <= METHOD_TOKENS_WITHOUT_A_RULE_TOTAL;
  assert UNSTYLED_TOKENS_RULED_IN_THE_DELETED_SHEET < UNSTYLED_TOKENS_RULED_AT_THE_PARENT_OF_158500B;
  assert METHOD_TOKENS_WITHOUT_A_RULE_TOTAL - UNSTYLED_TOKENS_RULED_AT_THE_PARENT_OF_158500B == 2;
  assert DELETED_SHEET_LINES == 852;
  assert DESIGN_DOC_NAMES_THE_DELETED_SHEET == true;
}

test the_host_test_reads_only_bare_class_lines {
  assert host_test_reads(true, false) == true;
  assert host_test_reads(true, true) == false;
  assert host_test_reads(false, false) == false;
  assert KIT_CLASS_ATTRIBUTES_THE_HOST_TEST_READS + KIT_CLASS_ATTRIBUTES_THE_HOST_TEST_SKIPS == KIT_CLASS_ATTRIBUTES;
  assert KIT_RULELESS_CLASSES_THE_HOST_TEST_READS == KIT_RULELESS_CLASSES_ON_THE_ALLOWLIST;
  assert KIT_RULELESS_CLASSES_ON_THE_ALLOWLIST < HOST_TEST_ALLOWLIST_SIZE;
  assert UNSEEN_RULELESS_LITERAL_CLASSES.len == 12;
  assert UNSEEN_RULELESS_COMPUTED_CLASSES.len == 11;
  assert UNSEEN_RULELESS_COMPUTED_CLASSES[10] == EMPTY_STATE_GLASS_CLASS;
}

test the_theme_drift_splits_seven_two_four {
  assert THEME_TOKEN_NAMES.len == THEME_TOKEN_COUNT;
  assert THEME_TOKEN_STATE.len == THEME_TOKEN_COUNT;
  assert count_theme_state(THEME_TOKEN_STATE, THEME_TOKEN_EQUAL) == THEME_TOKENS_EQUAL;
  assert count_theme_state(THEME_TOKEN_STATE, THEME_TOKEN_TEXT_DIFFERS) == THEME_TOKENS_TEXT_DIFFERS;
  assert count_theme_state(THEME_TOKEN_STATE, THEME_TOKEN_ABSENT_FROM_STYLES) == THEME_TOKENS_ABSENT_FROM_STYLES;
  assert THEME_TOKENS_EQUAL + THEME_TOKENS_TEXT_DIFFERS + THEME_TOKENS_ABSENT_FROM_STYLES == THEME_TOKEN_COUNT;
  assert THEME_TOKENS_COLOUR_DIFFERS < THEME_TOKENS_TEXT_DIFFERS;
  assert BRIEF_THEME_TOKENS_DIFFERING == THEME_TOKENS_TEXT_DIFFERS;
  assert STYLES_DEFINITIONS_OF_THE_ABSENT_THEME_TOKENS == 0;
}

test the_theme_font_face_names_one_font_and_loads_another_from_nowhere {
  assert THEME_FONT_FAMILY == "Inter";
  assert THEME_FONT_FILE == "/assets/fonts/PressStart2P.woff2";
  assert THEME_FONT_FAMILY_MATCHES_THE_FILE == false;
  assert THEME_FONT_DIRECTORY_IN_THE_TREE == false;
}

test the_hardcoded_copy_is_counted_per_file {
  assert sum4(KIT_HARDCODED_CYRILLIC_BY_FILE) == KIT_HARDCODED_CYRILLIC_LITERALS;
  assert KIT_HARDCODED_CYRILLIC_BY_FILE.len == KIT_HARDCODED_CYRILLIC_FILES;
  assert KIT_HARDCODED_CYRILLIC_BY_FILE[0] == TOAST_HARDCODED_CYRILLIC_LITERALS;
  assert KIT_HARDCODED_CYRILLIC_RENDERED_LIVE == TOAST_HARDCODED_CYRILLIC_LITERALS;
  assert KIT_FILES_CALLING_T == 2;
}

test nothing_here_picks_a_fate_or_changes_behaviour {
  assert RETIREMENT_OF_UNMOUNTED_PRIMITIVES_IS_PUBLISHED == false;
  assert THIS_FILE_PICKS_A_FATE == false;
  assert THIS_FILE_CHANGES_BEHAVIOUR == false;
  assert SIBLING_LINE_CITATIONS_IN_THIS_FILE == 0;
}

; ============================================================================================
; Invariants
; ============================================================================================

invariant no_unstyled_method_token_is_rendered_on_a_live_route
  assert unstyled_tokens_on_a_live_site(METHOD_TOKENS_WITHOUT_A_RULE, METHOD_TOKEN_FILE_REACH) == 0 and METHOD_TOKENS_WITHOUT_A_RULE_TOTAL == 45

invariant the_census_is_a_partition_of_the_seventeen
  assert count_reach(KIT_PRIMITIVE_REACH, REACH_CUSTOMER_ROUTE) + count_reach(KIT_PRIMITIVE_REACH, REACH_ADMIN_ROUTE_ONLY) + count_reach(KIT_PRIMITIVE_REACH, REACH_SITE_NEVER_RENDERS) + count_reach(KIT_PRIMITIVE_REACH, REACH_NO_LIVE_SITE) == KIT_PRIMITIVE_COUNT

invariant a_mount_site_is_never_counted_as_a_render
  assert PRIMITIVES_WITH_A_LIVE_MOUNT_SITE - PRIMITIVES_THAT_CAN_RENDER == PRIMITIVES_WITH_A_SITE_THAT_NEVER_RENDERS and reach_class(true, false, false) != REACH_CUSTOMER_ROUTE

invariant the_host_test_never_reads_a_method_token
  assert host_test_reads(false, false) == false and METHOD_TOKENS_VISIBLE_TO_THE_HOST_TEST == 0

invariant a_protocol_relative_url_is_never_shown
  assert media_url_is_shown(false, false, true, true) == false

invariant the_one_live_ruleless_class_is_the_carts_glass
  assert RULELESS_KIT_CLASSES_RENDERED_ON_A_LIVE_ROUTE.len == 1 and CARD_GLASS_RULES_IN_STYLES == 0 and EMPTY_STATE_MOUNTS_ASKING_FOR_GLASS == 1

invariant heavy_ignores_the_callers_delay
  assert lazy_total_delay_ms(true, 1) == lazy_total_delay_ms(true, 1000)

invariant this_file_picks_no_fate
  assert RETIREMENT_OF_UNMOUNTED_PRIMITIVES_IS_PUBLISHED == false and THIS_FILE_PICKS_A_FATE == false
