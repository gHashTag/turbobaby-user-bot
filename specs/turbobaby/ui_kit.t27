; --- The mount census ---------------------------------------------------------------------------
; Four classes, and a primitive is in exactly one. A LIVE site is a mount inside a route handler
; of src/ui/routes.rs or inside a screen such a handler mounts. A mount inside a legacy file is a
; live site exactly when turbobaby/legacy-retirement's component_is_reachable says that file is
; reached, and for every legacy file that mounts a kit primitive it says no (the four
; *_REACHABLE_MOUNTERS / *_CALLERS declarations LEGACY_MOUNTER_REACH_OWNER_DECLS names, all zero on
; 2026-09-29). The events screen's reach is turbobaby/events-booking's
; EVENT_SCREENS_MOUNTED_BY_THE_CLIENT_ROUTER; Button's two renderers' are
; turbobaby/availability's card_reaches_a_screen and turbobaby/cart-persistence's
; CART_LINE_COMPONENT_MOUNT_SITES. This file takes each as a boolean input and declares no
; retirement state of its own.
pub const REACH_CUSTOMER_ROUTE : u8 = 1;
pub const REACH_ADMIN_ROUTE_ONLY : u8 = 2;
pub const REACH_SITE_NEVER_RENDERS : u8 = 3;
pub const REACH_NO_LIVE_SITE : u8 = 4;
pub const REACH_CLASS_COUNT : u8 = 4;
pub const LEGACY_MOUNTER_IS_REACHED : bool = false;
pub const LEGACY_MOUNTER_REACH_OWNER_ID : str = "turbobaby/legacy-retirement";
pub const LEGACY_MOUNTER_REACH_OWNER_DECLS : [4]str = ["GOODS_FILES_REACHABLE_MOUNTERS", "UNROUTED_NON_GOODS_REACHABLE_MOUNTERS", "PRODUCT_DETAIL_MODAL_REACHABLE_MOUNTERS", "SET_CARD_CALLERS"];
pub const LEGACY_MOUNTER_REACH_RULE_DECL : str = "component_is_reachable";
pub const BUTTON_RENDERER_REACH_OWNER_DECLS : [2]str = ["card_reaches_a_screen", "CART_LINE_COMPONENT_MOUNT_SITES"];
pub const BUTTON_RENDERER_IS_REACHED : bool = false;

pub fn reach_class(site_on_a_customer_route: bool, site_on_the_admin_route: bool, branch_is_taken: bool) u8 {
    if (!site_on_a_customer_route and !site_on_the_admin_route) {
        return REACH_NO_LIVE_SITE;
    }
    if (!branch_is_taken) {
        return REACH_SITE_NEVER_RENDERS;
    }
    if (site_on_a_customer_route) {
        return REACH_CUSTOMER_ROUTE;
    }
    return REACH_ADMIN_ROUTE_ONLY;
}

pub fn reach_class_is_known(class: u8) bool {
    return class >= REACH_CUSTOMER_ROUTE and class <= REACH_CLASS_COUNT;
}

