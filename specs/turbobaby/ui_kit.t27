pub const UNSTYLED_METHOD_TOKEN_RULES_IN_STYLES : u8 = 0;
; Provenance, by `git show` of the two sheets at the parent of 158500b (2026-05-15) and the same
; `.name` scan: 37 of the 45 had a rule in styles/components.css and 6 more in styles/main.css;
; card-default and card-bike had none. 158500b deleted styles/components.css (852 lines) and the
; index.html line that linked it.
pub const RULES_REMOVED_BY_COMMIT : str = "158500b (2026-05-15), which deleted styles/components.css";
pub const UNSTYLED_TOKENS_RULED_AT_THE_PARENT_OF_158500B : u8 = 43;
pub const UNSTYLED_TOKENS_RULED_IN_THE_DELETED_SHEET : u8 = 37;
pub const DELETED_SHEET_LINES : u16 = 852;
pub const DESIGN_DOC_NAMES_THE_DELETED_SHEET : bool = true;
pub const DESIGN_DOC_SITES : str = "docs/DESIGN_SYSTEM.md:421 and :458 (at 55a6664)";

pub fn sum8(v: [8]u8) u8 {
    var total : u8 = 0;
    var i : u8 = 0;
    while (i < METHOD_TOKEN_FILE_COUNT) {
        total = total + v[i];
        i += @as(u8, 1);
    }
    return total;
}

pub fn unstyled_tokens_on_a_live_site(without: [8]u8, reach: [8]u8) u8 {
    var total : u8 = 0;
    var i : u8 = 0;
    while (i < METHOD_TOKEN_FILE_COUNT) {
        if (reach[i] != REACH_NO_LIVE_SITE) {
            total = total + without[i];
        }
        i += @as(u8, 1);
    }
    return total;
}

pub fn sum19(v: [19]u16) u16 {
    var total : u16 = 0;
    var i : u8 = 0;
    while (i < KIT_FILE_COUNT) {
        total = total + v[i];
        i += @as(u8, 1);
    }
    return total;
}

; --- The host test and what it cannot see ----------------------------------------------------------
; css_class_consistency_tests (src/main.rs:1609) takes a line only when its trimmed text starts with
; `class: "` (:1659) and the quoted value holds no `{` (:1669). Of the kit's 43 class attributes it
; therefore reads 7 (src/ui/components/modal.rs:58, :84, :90; src/ui/components/input.rs:74;
; src/ui/components/chip.rs:68; src/ui/components/toast.rs:82, :101). Two of the seven name a class
; with no rule, and both sit on its ALLOWLIST (src/main.rs:1621-1622). The other
; 36 are an element and its class on one line, an interpolated value, or a format! call, and the
; test reads none of them: twelve literal class names with no rule hide that way (listed below), and
; so do eleven computed ones, card-glass among them.
pub const HOST_TEST_SITE : str = "src/main.rs:1609 css_class_consistency_tests (at 55a6664)";
pub const HOST_TEST_LINE_RULE_SITES : str = "src/main.rs:1659 (line must start with class: and a quote) and :1669 (value must hold no brace) (at 55a6664)";
pub const KIT_CLASS_ATTRIBUTES : u8 = 43;
pub const KIT_CLASS_ATTRIBUTES_THE_HOST_TEST_READS : u8 = 7;
pub const KIT_CLASS_ATTRIBUTES_THE_HOST_TEST_SKIPS : u8 = 36;
pub const KIT_RULELESS_CLASSES_THE_HOST_TEST_READS : u8 = 2;
pub const KIT_RULELESS_CLASSES_ON_THE_ALLOWLIST : u8 = 2;
pub const HOST_TEST_ALLOWLIST_SIZE : u8 = 3;
pub const UNSEEN_RULELESS_LITERAL_CLASSES : [12]str = ["btn-spinner", "btn-icon", "btn-label", "card-image", "badge-icon", "badge-label", "chip", "chip-icon", "chip-label", "filter-tag-group", "progress-bar-wrapper", "progress-bar-label-row"];
pub const UNSEEN_RULELESS_COMPUTED_CLASSES : [11]str = ["btn-md", "btn-full", "btn-disabled", "glow", "loading-overlay", "visible", "loading-spinner", "loading-small", "loading-medium", "loading-large", "card-glass"];
pub const RULELESS_KIT_CLASSES_RENDERED_ON_A_LIVE_ROUTE : [1]str = ["card-glass"];

pub fn host_test_reads(line_starts_with_a_class_literal: bool, value_holds_a_brace: bool) bool {
    return line_starts_with_a_class_literal and !value_holds_a_brace;
}

; --- The theme module, src/ui/theme/mod.rs ----------------------------------------------------------
; CSS_VARS (:6-93) declares 13 custom properties (:8-20); inject_theme (:95-97) wraps them in a
; style tag. Nothing calls either. Against styles/*.css: 7 are declared with the same value; 2 with
; different text -- --bg-secondary is var(--bg2) (styles/variables.css:33), which resolves to the
; theme's #1a1a2e (:18), and --bg-tertiary is #20203a (:34) against the theme's #1a1a2e -- and 4 are
; declared by no sheet at all. The @font-face (:24-28) names family Inter and loads
; /assets/fonts/PressStart2P.woff2; there is no assets/fonts directory in the tree, and the Inter the
; page uses comes from Google Fonts (index.html:51).
pub const THEME_TOKEN_EQUAL : u8 = 1;
pub const THEME_TOKEN_TEXT_DIFFERS : u8 = 2;
pub const THEME_TOKEN_ABSENT_FROM_STYLES : u8 = 3;
pub const THEME_TOKEN_COUNT : u8 = 13;
pub const THEME_TOKEN_NAMES : [13]str = ["--bg-primary", "--bg-secondary", "--bg-tertiary", "--border", "--text-primary", "--text-secondary", "--green", "--cyan", "--yellow", "--purple", "--red", "--pixel-shadow", "--pixel-border"];
pub const THEME_TOKEN_STATE : [13]u8 = [3, 2, 2, 1, 3, 3, 1, 1, 1, 1, 1, 1, 3];
pub const THEME_TOKENS_EQUAL : u8 = 7;
pub const THEME_TOKENS_TEXT_DIFFERS : u8 = 2;
pub const THEME_TOKENS_ABSENT_FROM_STYLES : u8 = 4;
pub const THEME_TOKENS_COLOUR_DIFFERS : u8 = 1;
pub const STYLES_DEFINITIONS_OF_THE_ABSENT_THEME_TOKENS : u8 = 0;
pub const THEME_FONT_FAMILY : str = "Inter";
pub const THEME_FONT_FILE : str = "/assets/fonts/PressStart2P.woff2";
pub const THEME_FONT_DIRECTORY_IN_THE_TREE : bool = false;
pub const THEME_FONT_FAMILY_MATCHES_THE_FILE : bool = false;
pub const BRIEF_THEME_TOKENS_DIFFERING : u8 = 2;

pub fn count_theme_state(state: [13]u8, wanted: u8) u8 {
    var found : u8 = 0;
    var i : u8 = 0;
    while (i < THEME_TOKEN_COUNT) {
        if (state[i] == wanted) {
            found += @as(u8, 1);
        }
        i += @as(u8, 1);
    }
    return found;
}

; --- Copy that bypasses t() --------------------------------------------------------------------------
; Eleven string literals in the kit carry Cyrillic outside a comment: toast.rs 5 (:35-38, :83),
; image_lightbox.rs 4 (:51, :79, :89, :95), video_modal.rs 1 (:41), chip.rs 1 (:69). Two kit files
; route text through t(): modal.rs (:53-54) and video_modal.rs (:66), both with T_MODAL_CLOSE. Of
; the eleven, the five in toast.rs render on a live route (/admin); the other six do not.
pub const KIT_HARDCODED_CYRILLIC_LITERALS : u8 = 11;
pub const KIT_HARDCODED_CYRILLIC_FILES : u8 = 4;
pub const KIT_HARDCODED_CYRILLIC_BY_FILE : [4]u8 = [5, 4, 1, 1];
pub const KIT_HARDCODED_CYRILLIC_RENDERED_LIVE : u8 = 5;
pub const KIT_FILES_CALLING_T : u8 = 2;

pub fn sum4(v: [4]u8) u8 {
    return v[0] + v[1] + v[2] + v[3];
}

; --- What the repository does not publish -----------------------------------------------------------
; Whether the nine primitives with no live site, the two that never render and the dead theme should
; be restyled, wired or removed: no source in the tree decides it. docs/DESIGN_SYSTEM.md describes
; the kit as it was designed and still names the deleted sheet; for legacy SURFACES the same refusal
; is turbobaby/legacy-retirement's RETIREMENT_ORDER_IS_PUBLISHED, and nothing extends it to
; primitives. What is missing is the owner's choice, and a contract that picked one would be
; followed as if it had been made.
pub const RETIREMENT_OF_UNMOUNTED_PRIMITIVES_IS_PUBLISHED : bool = false;
pub const THIS_FILE_PICKS_A_FATE : bool = false;
pub const THIS_FILE_CHANGES_BEHAVIOUR : bool = false;
; Bound by gate 3 since 2026-09-30 over this file's own text (a `name.t27:N` citation anywhere in it),
; with a witness on its REUSES_ edges; until then it was a claim no gate or script read.
pub const SIBLING_LINE_CITATIONS_IN_THIS_FILE : u8 = 0;

; --- Brief readings kept beside the measurement -------------------------------------------------------
; Every BRIEF_ constant in this file is a claim of the round-7 lane brief, which the repository does
; not publish (see WHERE THE BRIEF IS REFUTED in the header). None is a measurement and none is used
; as a value: each is asserted only against the measured declaration that refutes or confirms it.
pub const BRIEF_SOURCE : str = "the task brief handed to the round-7 ui-kit lane on 2026-09-29; not in the repository";
pub const BRIEF_IS_PUBLISHED : bool = false;
pub const BRIEF_FIGURES_ARE_MEASUREMENTS : bool = false;
pub const BRIEF_METHOD_TOKEN_TOTAL : u8 = 54;
pub const BRIEF_METHOD_TOKEN_FILE_COUNT : u8 = 7;
pub const BRIEF_SAID_LAZY_SCREEN_USES_SKELETON : bool = true;
pub const BRIEF_EMPTY_STATE_ADMIN_USES : u8 = 10;
pub const BRIEF_SAID_THE_MONEY_REEXPORT_IS_USED : bool = true;

