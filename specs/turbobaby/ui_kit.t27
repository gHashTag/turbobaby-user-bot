pub fn count_reach(reach: [17]u8, class: u8) u8 {
    var found : u8 = 0;
    var i : u8 = 0;
    while (i < KIT_PRIMITIVE_COUNT) {
        if (reach[i] == class) {
            found += @as(u8, 1);
        }
        i += @as(u8, 1);
    }
    return found;
}

pub fn reach_rows_follow_from_their_inputs() bool {
    var i : u8 = 0;
    while (i < KIT_PRIMITIVE_COUNT) {
        if (reach_class(KIT_SITE_ON_A_CUSTOMER_ROUTE[i] == 1, KIT_SITE_ON_THE_ADMIN_ROUTE[i] == 1, KIT_BRANCH_IS_TAKEN[i] == 1) != KIT_PRIMITIVE_REACH[i]) {
            return false;
        }
        i += @as(u8, 1);
    }
    return true;
}

