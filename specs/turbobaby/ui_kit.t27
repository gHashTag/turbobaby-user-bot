pub const LAZY_CALLERS_PASSING_DELAY_MS : u8 = 0;
; Every other handler of the same router mounts no LazyScreen: the handlers that render only the
; catalog, which turbobaby/legacy-retirement counts (REPOINTED_ROUTE_COUNT), and three more that are
; this file's to name -- Ride (deliberately, src/ui/routes.rs:267-269), Skate (:276) and NotFound
; (:348). How many handlers the router has is turbobaby/customer-surface's (ROUTER_DECLARED_ROUTES).
; The same CatalogScreen therefore paints a 16 ms placeholder at / (:109) and none at /sets (:136-140).
; CORRECTED 2026-09-30 (review of round 7): the unwrapped handlers and the catalog-only ones among
; them were declared here as two literals, the router's size less the wraps and a copy of the
; repointed count, with no tie to either owner. The copies go and the owners stay: both names are
; listed in RESTATEMENT_DROPPED_ON_2026_09_30, and this file keeps what it measured itself -- the
; wraps (LAZY_WRAPPED_HANDLERS, bound) and the three unwrapped handlers that are not catalog aliases.
pub const LAZY_UNWRAPPED_NON_CATALOG_HANDLER_NAMES : [3]str = ["Ride", "Skate", "NotFound"];
