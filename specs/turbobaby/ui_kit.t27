pub const CUSTOMER_SURFACE_OWNS : str = "turbobaby/customer-surface owns the tab bar (TAB_SOURCE, the bottom_nav module listed in this kit's module file) and the size of the client router (ROUTER_DECLARED_ROUTES). This file counts which route handlers wrap their screen in LazyScreen; it never counts the routes themselves.";
pub const CLIENT_ERRORS_OWNS : str = "turbobaby/client-errors owns what a customer is told when something fails and the overlay that tells him (OVERLAY_SOURCE). The error_overlay and error_banner modules sit in this kit's module file and are counted here as module entries only.";
pub const WEBAPP_BRIDGE_OWNS : str = "turbobaby/webapp-bridge owns the wasm32 gate (WASM_GATE_SITE) and the fact that the host suite compiles none of this half (HOST_SUITE_COMPILES_THIS_HALF). Every file of this kit sits behind that gate; that is the premise of every count below, not a finding of this file.";
pub const LEGACY_RETIREMENT_OWNS : str = "turbobaby/legacy-retirement owns what state a legacy surface is in (retirement_state and its first argument legacy_surface_reachable), the seven legacy screens that stay compiled with no handler (REPOINTED_LEGACY_SCREENS_KEPT_UNMOUNTED), and -- since 2026-09-29 -- the reach of each legacy file that mounts a kit primitive: component_is_reachable, read on GOODS_FILES_REACHABLE_MOUNTERS (the accessories and tea screens, the set card, the detail modal), UNROUTED_NON_GOODS_REACHABLE_MOUNTERS (the hunt and tech-tree screens), PRODUCT_DETAIL_MODAL_REACHABLE_MOUNTERS with PRODUCT_DETAIL_MODAL_IS_THE_ONLY_LIGHTBOX_MOUNTER, and SET_CARD_CALLERS. Every one of those is zero, so a primitive mounted only there has no live site here; no second retirement state is declared.";
pub const AVAILABILITY_OWNS : str = "turbobaby/availability owns what a bike card may say about booking and whether the card reaches a screen at all (card_reaches_a_screen, false on CARD_GRID_MOUNT_SITES and CARD_RENDER_SITES_OUTSIDE_THE_GRID). This file uses that card only as one of the two renderers of Button; it restates nothing the card shows.";
pub const CART_PERSISTENCE_OWNS : str = "turbobaby/cart-persistence owns the cart line renderer CartItemComponent and records that nothing mounts it (CART_LINE_COMPONENT_MOUNT_SITES). It is the other renderer of Button. Since 2026-09-30 it reads the line's picture rule from this file by name (media_url_is_shown, MEDIA_PREDICATE_SITES) and Button's default handler too (BUTTON_ONCLICK_DEFAULT_DOES_NOTHING); this file counts the line's copy of the predicate and decides nothing about the line.";
pub const CART_PERSISTENCE_OWNS_BEFORE_2026_09_30 : str = "turbobaby/cart-persistence owns the cart line renderer CartItemComponent and records that nothing mounts it (CART_LINE_COMPONENT_MOUNT_SITES). It is the other renderer of Button, and its own copy of the media predicate is modelled there (cart_line_image_is_drawn); this file counts that copy and decides nothing about the line.";
pub const CATALOG_WRITE_OWNS : str = "turbobaby/catalog-write owns what an admin write may produce, and since 2026-09-30 that includes the prefixes the server's URL gate admits into a stored image address (WRITE_IMAGE_URL_ADMITTED_PREFIXES, with WRITE_IMAGE_URL_ADMITS_A_DATA_URL). This file owns only the read side: which stored address a primitive shows.";
pub const PRICING_HONESTY_OWNS : str = "turbobaby/pricing-honesty owns how an absent rate renders (SHAPE_DASH, DASH). The kit's module file re-exports the three bike-card helpers that implement it; this file counts who reaches them through that re-export and decides nothing about the dash.";
pub const LOCALE_POLICY_OWNS : str = "turbobaby/locale-policy owns the published locale set (PUBLISHED_LOCALES) and the fallthrough of a bare key. The kit's hard-coded strings never pass through t(), so they render the same text under every published locale; this file counts them and quotes none.";
pub const VALIDATION_BOUNDS_OWNS : str = "turbobaby/validation-bounds owns the shared write-side URL rewrite, whose lack of any refusing branch it records as REWRITER_HAS_A_REFUSING_BRANCH. The kit's media predicate is the READ side and is this file's; the two are not the same function and neither restates the other.";
pub const EVENTS_BOOKING_OWNS : str = "turbobaby/events-booking owns the mount state of the events screens (EVENT_SCREENS_MOUNTED_BY_THE_CLIENT_ROUTER). One Skeleton caller is an events screen; its liveness is read from there.";
pub const ORDER_PRESENTATION_OWNS : str = "turbobaby/order-presentation owns the status stepper (SHARED_COMPONENT), a module listed in this kit's module file and not a kit primitive.";

