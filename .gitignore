target/
# A second build directory appears whenever someone runs clippy with
# CARGO_TARGET_DIR set to keep it from invalidating the main cache.
# `target/` above does not match it, so 587M of artifacts showed up in
# `git status` as an untracked path.
target-*/
*.bak
.env
.DS_Store
.cargo/
# …but track the cargo-audit RustSec triage config (version-controlled
# security decisions, auto-read by `cargo audit`).
!.cargo/
.cargo/*
!.cargo/audit.toml
# Keep local Claude state ignored, but version repository agent definitions.
.claude/*
!.claude/agents/
.claude/agents/*
!.claude/agents/*.md

# Trunk build output (built locally for Railway static serving; Docker path keeps
dist/ but we commit it so Railway serves the pre-built WASM without a Docker stage)
# NOTE: if you switch back to Dockerfile-only builds, re-ignore dist/
# dist/
# Trunk also mirrors root assets into dist/assets/; we serve /assets from the
# root assets/ directory, so keeping the duplicate in dist/ bloats deploys.
dist/assets/
logs/
*.log
# E2E test artifacts
e2e/uploads/
e2e/test-results/
e2e/playwright-report/
e2e/node_modules/

# Runtime user uploads — handled by S3 or local dev, not production deploys
assets/uploads/

# Asset export bundles / docs screenshots (scripts/export-assets.sh) — kept local, not in git
exports/
docs/screenshots/
.claude-flow/
.ruflo/
.ruvector/
.swarm/

# Python scratch from local spec-verify runs; never shipped
__pycache__/
